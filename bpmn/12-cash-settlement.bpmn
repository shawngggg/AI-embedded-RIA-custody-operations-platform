<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="cs_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="cs_collab">
<bpmn:participant id="cs_main" name="Custody operations platform (synthetic reference implementation)" processRef="cs_process" />
<bpmn:participant id="cs_bank" name="Settlement bank and payment networks (Fedwire, ACH, DTC money settlement)" />
<bpmn:messageFlow id="cs_msg0" name="Settlement activity" sourceRef="cs_bank" targetRef="cs_t1" />
<bpmn:messageFlow id="cs_msg1" name="Funding instructions" sourceRef="cs_t12" targetRef="cs_bank" />
<bpmn:textAnnotation id="cs_ann0"><bpmn:text>Every posting is double-entry; a posting that would break the three-layer rollup is rejected. Large carrying firms also compute the customer reserve daily (since June 30, 2026), and this cycle feeds it.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="cs_ann0_assoc" sourceRef="cs_t3" targetRef="cs_ann0" />
</bpmn:collaboration>
<bpmn:process id="cs_process" name="Cash settlement across three layers" isExecutable="false">
<bpmn:laneSet id="cs_laneset">
<bpmn:lane id="cs_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>cs_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cs_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>cs_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cs_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>cs_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cs_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>cs_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cs_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="cs_s" name="Each business day: settlement cycle">
<bpmn:outgoing>cs_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="cs_s_def" />
</bpmn:startEvent>
<bpmn:receiveTask id="cs_t1" name="Receive settlement activity: trades, transfers, income, fees">
<bpmn:incoming>cs_flow0</bpmn:incoming>
<bpmn:outgoing>cs_flow1</bpmn:outgoing>
</bpmn:receiveTask>
<bpmn:serviceTask id="cs_t2" name="Post client-level cash entries">
<bpmn:incoming>cs_flow1</bpmn:incoming>
<bpmn:outgoing>cs_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="cs_t3" name="Roll client entries up to RIA master accounts">
<bpmn:incoming>cs_flow2</bpmn:incoming>
<bpmn:outgoing>cs_flow3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="cs_t4" name="Post custodian GL entries: omnibus, house, suspense">
<bpmn:incoming>cs_flow3</bpmn:incoming>
<bpmn:outgoing>cs_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="cs_t5" name="Check invariant: sum of clients = RIA master; sum of RIA masters = GL">
<bpmn:incoming>cs_flow4</bpmn:incoming>
<bpmn:incoming>cs_flow8</bpmn:incoming>
<bpmn:outgoing>cs_flow5</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="cs_g1" name="Layers balanced?">
<bpmn:incoming>cs_flow5</bpmn:incoming>
<bpmn:outgoing>cs_flow6</bpmn:outgoing>
<bpmn:outgoing>cs_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cs_t6" name="Locate imbalance and source entries (AI)">
<bpmn:incoming>cs_flow6</bpmn:incoming>
<bpmn:outgoing>cs_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="cs_t7" name="Correct posting (maker-checker)">
<bpmn:incoming>cs_flow7</bpmn:incoming>
<bpmn:outgoing>cs_flow8</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="cs_g2" name="Unapplied incoming cash?">
<bpmn:incoming>cs_flow9</bpmn:incoming>
<bpmn:outgoing>cs_flow10</bpmn:outgoing>
<bpmn:outgoing>cs_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cs_t8" name="Match wire memos and ACH addenda to client accounts (AI)">
<bpmn:incoming>cs_flow10</bpmn:incoming>
<bpmn:outgoing>cs_flow11</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cs_g3" name="Match confidence above threshold?">
<bpmn:incoming>cs_flow11</bpmn:incoming>
<bpmn:outgoing>cs_flow12</bpmn:outgoing>
<bpmn:outgoing>cs_flow13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="cs_t9" name="Hold unmatched money in suspense; research; apply it or return it after set days">
<bpmn:incoming>cs_flow12</bpmn:incoming>
<bpmn:outgoing>cs_flow14</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="cs_t10" name="Apply cash to client account (three layers)">
<bpmn:incoming>cs_flow13</bpmn:incoming>
<bpmn:incoming>cs_flow14</bpmn:incoming>
<bpmn:outgoing>cs_flow15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cs_g4" name="">
<bpmn:incoming>cs_flow15</bpmn:incoming>
<bpmn:incoming>cs_flow16</bpmn:incoming>
<bpmn:outgoing>cs_flow17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cs_t11" name="Release settled cash; hold returnable ACH funds as restricted">
<bpmn:incoming>cs_flow17</bpmn:incoming>
<bpmn:outgoing>cs_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="cs_t12" name="Send net funding and settlement instructions">
<bpmn:incoming>cs_flow18</bpmn:incoming>
<bpmn:outgoing>cs_flow19</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="cs_e" name="Cash settled across three layers">
<bpmn:incoming>cs_flow19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="cs_flow0" name="" sourceRef="cs_s" targetRef="cs_t1" />
<bpmn:sequenceFlow id="cs_flow1" name="" sourceRef="cs_t1" targetRef="cs_t2" />
<bpmn:sequenceFlow id="cs_flow2" name="" sourceRef="cs_t2" targetRef="cs_t3" />
<bpmn:sequenceFlow id="cs_flow3" name="" sourceRef="cs_t3" targetRef="cs_t4" />
<bpmn:sequenceFlow id="cs_flow4" name="" sourceRef="cs_t4" targetRef="cs_t5" />
<bpmn:sequenceFlow id="cs_flow5" name="" sourceRef="cs_t5" targetRef="cs_g1" />
<bpmn:sequenceFlow id="cs_flow6" name="No" sourceRef="cs_g1" targetRef="cs_t6" />
<bpmn:sequenceFlow id="cs_flow7" name="" sourceRef="cs_t6" targetRef="cs_t7" />
<bpmn:sequenceFlow id="cs_flow8" name="Re-check" sourceRef="cs_t7" targetRef="cs_t5" />
<bpmn:sequenceFlow id="cs_flow9" name="Yes" sourceRef="cs_g1" targetRef="cs_g2" />
<bpmn:sequenceFlow id="cs_flow10" name="Yes" sourceRef="cs_g2" targetRef="cs_t8" />
<bpmn:sequenceFlow id="cs_flow11" name="" sourceRef="cs_t8" targetRef="cs_g3" />
<bpmn:sequenceFlow id="cs_flow12" name="Low" sourceRef="cs_g3" targetRef="cs_t9" />
<bpmn:sequenceFlow id="cs_flow13" name="High" sourceRef="cs_g3" targetRef="cs_t10" />
<bpmn:sequenceFlow id="cs_flow14" name="" sourceRef="cs_t9" targetRef="cs_t10" />
<bpmn:sequenceFlow id="cs_flow15" name="" sourceRef="cs_t10" targetRef="cs_g4" />
<bpmn:sequenceFlow id="cs_flow16" name="No" sourceRef="cs_g2" targetRef="cs_g4" />
<bpmn:sequenceFlow id="cs_flow17" name="" sourceRef="cs_g4" targetRef="cs_t11" />
<bpmn:sequenceFlow id="cs_flow18" name="" sourceRef="cs_t11" targetRef="cs_t12" />
<bpmn:sequenceFlow id="cs_flow19" name="" sourceRef="cs_t12" targetRef="cs_e" />
</bpmn:process>
<bpmndi:BPMNDiagram id="cs_diagram" name="Cash settlement across three layers">
<bpmndi:BPMNPlane id="cs_plane" bpmnElement="cs_collab">
<bpmndi:BPMNShape id="cs_main_di" bpmnElement="cs_main" isHorizontal="true"><dc:Bounds x="0" y="0" width="3500" height="700" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="cs_lane_ops_di" bpmnElement="cs_lane_ops" isHorizontal="true"><dc:Bounds x="30" y="0" width="3470" height="170" /></bpmndi:BPMNShape>
