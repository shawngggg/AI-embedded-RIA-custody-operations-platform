<bpmndi:BPMNEdge id="cs_msg1_di" bpmnElement="cs_msg1" bioc:stroke="#5B6578" color:border-color="#5B6578"><di:waypoint x="3180" y="650" /><di:waypoint x="3180" y="764" /><bpmndi:BPMNLabel><dc:Bounds x="3187" y="728" width="128" height="16" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>