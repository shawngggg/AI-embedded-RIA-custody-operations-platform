<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ce_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ce_collab">
<bpmn:participant id="ce_main" name="Custody operations platform (synthetic reference implementation)" processRef="ce_process" />
<bpmn:participant id="ce_ria" name="RIA advisor (authorized users)" />
<bpmn:participant id="ce_cli" name="Client" />
<bpmn:participant id="ce_svc" name="Bank account verification and OTP services" />
<bpmn:messageFlow id="ce_msg0" name="Grant or revoke request" sourceRef="ce_ria" targetRef="ce_s" />
<bpmn:messageFlow id="ce_msg1" name="Decline with reason" sourceRef="ce_ed" targetRef="ce_ria" />
<bpmn:messageFlow id="ce_msg2" name="Verification request" sourceRef="ce_t5" targetRef="ce_svc" />
<bpmn:messageFlow id="ce_msg3" name="Verification result" sourceRef="ce_svc" targetRef="ce_ie" />
<bpmn:messageFlow id="ce_msg4" name="Activation notice" sourceRef="ce_t6" targetRef="ce_cli" />
<bpmn:textAnnotation id="ce_ann0"><bpmn:text>Defaults: discretionary accounts, no client capabilities; self-directed and dual, trading only.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ce_ann1"><bpmn:text>AI flags client activity that drifts from the account's pattern and recommends revocation; the RIA decides.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ce_process" name="Client entitlement management (platform enhancement)" isExecutable="false">
<bpmn:laneSet id="ce_laneset">
<bpmn:lane id="ce_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>ce_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_ed</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ce_lane_ai" name="AI assist services">
</bpmn:lane>
<bpmn:lane id="ce_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ce_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_gm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ce_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>ce_tr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_er</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ce_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ce_s" name="Grant or revoke request from the RIA">
<bpmn:outgoing>ce_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ce_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ce_t1" name="Check the RIA user's entitlement to manage client permissions">
<bpmn:incoming>ce_flow0</bpmn:incoming>
<bpmn:outgoing>ce_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ce_g1" name="Grant or revoke?">
<bpmn:incoming>ce_flow1</bpmn:incoming>
<bpmn:outgoing>ce_flow2</bpmn:outgoing>
<bpmn:outgoing>ce_flow4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ce_tr" name="Revoke capability immediately; log who, when, why">
<bpmn:incoming>ce_flow2</bpmn:incoming>
<bpmn:outgoing>ce_flow3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ce_er" name="Capability revoked">
<bpmn:incoming>ce_flow3</bpmn:incoming>
</bpmn:endEvent>
<bpmn:businessRuleTask id="ce_t2" name="Policy ceilings: grantable for this management type and risk rating; no blocking restriction codes">
<bpmn:incoming>ce_flow4</bpmn:incoming>
<bpmn:outgoing>ce_flow5</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ce_g2" name="Within policy?">
<bpmn:incoming>ce_flow5</bpmn:incoming>
<bpmn:outgoing>ce_flow6</bpmn:outgoing>
<bpmn:outgoing>ce_flow7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ce_ed" name="Grant declined">
<bpmn:incoming>ce_flow6</bpmn:incoming>
<bpmn:messageEventDefinition id="ce_ed_def" />
</bpmn:endEvent>
<bpmn:serviceTask id="ce_t3" name="Record grant: capability, limits, approved destinations, expiry; audit log">
<bpmn:incoming>ce_flow7</bpmn:incoming>
<bpmn:outgoing>ce_flow8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ce_t4" name="Enroll account in monitoring of client-initiated activity">
<bpmn:incoming>ce_flow8</bpmn:incoming>
<bpmn:outgoing>ce_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ce_g3" name="Includes money movement?">
<bpmn:incoming>ce_flow9</bpmn:incoming>
<bpmn:outgoing>ce_flow10</bpmn:outgoing>
<bpmn:outgoing>ce_flow11</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="ce_t5" name="Verify the client's bank link: deposit or instant verification">
<bpmn:incoming>ce_flow10</bpmn:incoming>
<bpmn:outgoing>ce_flow12</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="ce_ie" name="Bank link verified">
<bpmn:incoming>ce_flow12</bpmn:incoming>
<bpmn:outgoing>ce_flow13</bpmn:outgoing>
<bpmn:messageEventDefinition id="ce_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="ce_gm" name="">
<bpmn:incoming>ce_flow11</bpmn:incoming>
<bpmn:incoming>ce_flow13</bpmn:incoming>
<bpmn:outgoing>ce_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="ce_t6" name="Notify the client: capability active; OTP required on each request">
<bpmn:incoming>ce_flow14</bpmn:incoming>
<bpmn:outgoing>ce_flow15</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="ce_e" name="Capability active">
<bpmn:incoming>ce_flow15</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="ce_flow0" name="" sourceRef="ce_s" targetRef="ce_t1" />
<bpmn:sequenceFlow id="ce_flow1" name="" sourceRef="ce_t1" targetRef="ce_g1" />
<bpmn:sequenceFlow id="ce_flow2" name="Revoke" sourceRef="ce_g1" targetRef="ce_tr" />
<bpmn:sequenceFlow id="ce_flow3" name="" sourceRef="ce_tr" targetRef="ce_er" />
<bpmn:sequenceFlow id="ce_flow4" name="Grant" sourceRef="ce_g1" targetRef="ce_t2" />
<bpmn:sequenceFlow id="ce_flow5" name="" sourceRef="ce_t2" targetRef="ce_g2" />
<bpmn:sequenceFlow id="ce_flow6" name="No" sourceRef="ce_g2" targetRef="ce_ed" />
<bpmn:sequenceFlow id="ce_flow7" name="Yes" sourceRef="ce_g2" targetRef="ce_t3" />
<bpmn:sequenceFlow id="ce_flow8" name="" sourceRef="ce_t3" targetRef="ce_t4" />
<bpmn:sequenceFlow id="ce_flow9" name="" sourceRef="ce_t4" targetRef="ce_g3" />
<bpmn:sequenceFlow id="ce_flow10" name="Yes" sourceRef="ce_g3" targetRef="ce_t5" />
<bpmn:sequenceFlow id="ce_flow11" name="No" sourceRef="ce_g3" targetRef="ce_gm" />
<bpmn:sequenceFlow id="ce_flow12" name="" sourceRef="ce_t5" targetRef="ce_ie" />
<bpmn:sequenceFlow id="ce_flow13" name="" sourceRef="ce_ie" targetRef="ce_gm" />
<bpmn:sequenceFlow id="ce_flow14" name="" sourceRef="ce_gm" targetRef="ce_t6" />
<bpmn:sequenceFlow id="ce_flow15" name="" sourceRef="ce_t6" targetRef="ce_e" />
</bpmn:process>
