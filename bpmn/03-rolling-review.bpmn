<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="rr_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="rr_collab">
<bpmn:participant id="rr_main" name="Custody operations platform (synthetic reference implementation)" processRef="rr_process" />
<bpmn:participant id="rr_req" name="RIA advisor (sole channel for requests and documents)" />
<bpmn:messageFlow id="rr_msg0" name="Refresh request" sourceRef="rr_t2" targetRef="rr_req" />
<bpmn:messageFlow id="rr_msg1" name="Updated information" sourceRef="rr_req" targetRef="rr_ie" />
<bpmn:textAnnotation id="rr_ann0"><bpmn:text>Runs for RIA firms too: KYB, registration and licensing, ADV changes, annual reliance certification.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="rr_ann1"><bpmn:text>Flagged-list hits call the sanctions escalation subprocess.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="rr_ann2"><bpmn:text>Review cadence is a policy setting. Demo assumption: high risk semi-annual, all others annual.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="rr_process" name="Rolling review (annual or semi-annual)" isExecutable="false">
<bpmn:laneSet id="rr_laneset">
<bpmn:lane id="rr_lane_ops" name="Periodic review team">
<bpmn:flowNodeRef>rr_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_tm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_er</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rr_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>rr_t1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rr_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>rr_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_g1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rr_lane_comp" name="AML compliance (second line)">
<bpmn:flowNodeRef>rr_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_ca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_ex</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rr_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>rr_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rr_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="rr_s1" name="Annual or semi-annual review date">
<bpmn:outgoing>rr_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="rr_s1_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="rr_t1" name="Pre-populate review: KYC, KYB, CIP, CDD, EDD, PEP data; changes and screening hits since last review (AI)">
<bpmn:incoming>rr_flow0</bpmn:incoming>
<bpmn:outgoing>rr_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="rr_t2" name="Request updated information from the RIA">
<bpmn:incoming>rr_flow1</bpmn:incoming>
<bpmn:outgoing>rr_flow2</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="rr_eg" name="">
<bpmn:incoming>rr_flow2</bpmn:incoming>
<bpmn:outgoing>rr_flow3</bpmn:outgoing>
<bpmn:outgoing>rr_flow4</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="rr_ie" name="Information received">
<bpmn:incoming>rr_flow3</bpmn:incoming>
<bpmn:outgoing>rr_flow7</bpmn:outgoing>
<bpmn:messageEventDefinition id="rr_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="rr_tm" name="Response deadline passed">
<bpmn:incoming>rr_flow4</bpmn:incoming>
<bpmn:outgoing>rr_flow5</bpmn:outgoing>
<bpmn:timerEventDefinition id="rr_tm_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="rr_t3" name="Apply restriction code: no new activity until refreshed">
<bpmn:incoming>rr_flow5</bpmn:incoming>
<bpmn:outgoing>rr_flow6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="rr_er" name="Restricted pending refresh">
<bpmn:incoming>rr_flow6</bpmn:incoming>
</bpmn:endEvent>
<bpmn:businessRuleTask id="rr_t4" name="Sanity-check KYC, KYB, CIP, CDD, EDD, PEP; re-run flagged-list check and risk rating">
<bpmn:incoming>rr_flow7</bpmn:incoming>
<bpmn:outgoing>rr_flow8</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="rr_g1" name="Outcome?">
<bpmn:incoming>rr_flow8</bpmn:incoming>
<bpmn:outgoing>rr_flow9</bpmn:outgoing>
<bpmn:outgoing>rr_flow10</bpmn:outgoing>
<bpmn:outgoing>rr_flow11</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="rr_t8" name="Update profile; re-run path A or B if management type changed">
<bpmn:incoming>rr_flow10</bpmn:incoming>
<bpmn:outgoing>rr_flow12</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="rr_t6" name="EDD: refresh source of funds and source of wealth">
<bpmn:incoming>rr_flow11</bpmn:incoming>
<bpmn:outgoing>rr_flow13</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="rr_g2" name="Continue relationship?">
<bpmn:incoming>rr_flow13</bpmn:incoming>
<bpmn:outgoing>rr_flow14</bpmn:outgoing>
<bpmn:outgoing>rr_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="rr_ca" name="Exit through client offboarding" calledElement="co_process">
<bpmn:incoming>rr_flow15</bpmn:incoming>
<bpmn:outgoing>rr_flow16</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="rr_ex" name="Exit started">
<bpmn:incoming>rr_flow16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="rr_gm" name="">
<bpmn:incoming>rr_flow9</bpmn:incoming>
<bpmn:incoming>rr_flow12</bpmn:incoming>
<bpmn:incoming>rr_flow14</bpmn:incoming>
<bpmn:outgoing>rr_flow17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="rr_t9" name="Record review; set next annual or semi-annual date">
<bpmn:incoming>rr_flow17</bpmn:incoming>
<bpmn:outgoing>rr_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="rr_e" name="Review complete">
<bpmn:incoming>rr_flow18</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="rr_flow0" name="" sourceRef="rr_s1" targetRef="rr_t1" />
<bpmn:sequenceFlow id="rr_flow1" name="" sourceRef="rr_t1" targetRef="rr_t2" />
<bpmn:sequenceFlow id="rr_flow2" name="" sourceRef="rr_t2" targetRef="rr_eg" />
<bpmn:sequenceFlow id="rr_flow3" name="" sourceRef="rr_eg" targetRef="rr_ie" />
<bpmn:sequenceFlow id="rr_flow4" name="" sourceRef="rr_eg" targetRef="rr_tm" />
<bpmn:sequenceFlow id="rr_flow5" name="" sourceRef="rr_tm" targetRef="rr_t3" />
<bpmn:sequenceFlow id="rr_flow6" name="" sourceRef="rr_t3" targetRef="rr_er" />
<bpmn:sequenceFlow id="rr_flow7" name="" sourceRef="rr_ie" targetRef="rr_t4" />
<bpmn:sequenceFlow id="rr_flow8" name="" sourceRef="rr_t4" targetRef="rr_g1" />
<bpmn:sequenceFlow id="rr_flow9" name="No change" sourceRef="rr_g1" targetRef="rr_gm" />
<bpmn:sequenceFlow id="rr_flow10" name="Profile changed" sourceRef="rr_g1" targetRef="rr_t8" />
<bpmn:sequenceFlow id="rr_flow11" name="Risk increased" sourceRef="rr_g1" targetRef="rr_t6" />
<bpmn:sequenceFlow id="rr_flow12" name="" sourceRef="rr_t8" targetRef="rr_gm" />
<bpmn:sequenceFlow id="rr_flow13" name="" sourceRef="rr_t6" targetRef="rr_g2" />
<bpmn:sequenceFlow id="rr_flow14" name="Yes" sourceRef="rr_g2" targetRef="rr_gm" />
<bpmn:sequenceFlow id="rr_flow15" name="No" sourceRef="rr_g2" targetRef="rr_ca" />
<bpmn:sequenceFlow id="rr_flow16" name="" sourceRef="rr_ca" targetRef="rr_ex" />
<bpmn:sequenceFlow id="rr_flow17" name="" sourceRef="rr_gm" targetRef="rr_t9" />
<bpmn:sequenceFlow id="rr_flow18" name="" sourceRef="rr_t9" targetRef="rr_e" />
</bpmn:process>
