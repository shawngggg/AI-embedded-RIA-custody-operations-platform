<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ov_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ov_collab">
<bpmn:participant id="ov_main" name="Custody operations platform (synthetic reference implementation)" processRef="ov_process" />
<bpmn:participant id="ov_infra" name="Market infrastructure: NSCC (CNS, ACATS, Fund/SERV), DTC, OCC, Fedwire, ACH, transfer agents, fund administrators" />
<bpmn:participant id="ov_adv" name="RIA advisor" />
<bpmn:participant id="ov_cli" name="End client" />
<bpmn:participant id="ov_state" name="State unclaimed property administrators" />
<bpmn:participant id="ov_reg" name="Regulators and tax authority: FinCEN, CAT, FINRA, MSRB, IRS" />
<bpmn:messageFlow id="ov_msg0" name="Opening package" sourceRef="ov_adv" targetRef="ov_s1" />
<bpmn:messageFlow id="ov_msg1" name="Transfer request" sourceRef="ov_adv" targetRef="ov_s2" />
<bpmn:messageFlow id="ov_msg2" name="Closure request" sourceRef="ov_adv" targetRef="ov_s5" />
<bpmn:messageFlow id="ov_msg3" name="Orders" sourceRef="ov_adv" targetRef="ov_s7" />
<bpmn:messageFlow id="ov_msg4" name="Instructions" sourceRef="ov_sp2" targetRef="ov_infra" />
<bpmn:messageFlow id="ov_msg5" name="Confirmations, rejects" sourceRef="ov_infra" targetRef="ov_sp2" />
<bpmn:messageFlow id="ov_msg6" name="Trade settlement" sourceRef="ov_sp10" targetRef="ov_infra" />
<bpmn:messageFlow id="ov_msg7" name="Event announcement" sourceRef="ov_infra" targetRef="ov_s8" />
<bpmn:messageFlow id="ov_msg8" name="Fund notices" sourceRef="ov_infra" targetRef="ov_s9" />
<bpmn:messageFlow id="ov_msg9" name="Settlement activity" sourceRef="ov_infra" targetRef="ov_sp3" />
<bpmn:messageFlow id="ov_msg10" name="Position files" sourceRef="ov_infra" targetRef="ov_sp4" />
<bpmn:messageFlow id="ov_msg11" name="Outgoing ACATS (TIF)" sourceRef="ov_infra" targetRef="ov_sp9" />
<bpmn:messageFlow id="ov_msg12" name="Fee report" sourceRef="ov_sp6" targetRef="ov_adv" />
<bpmn:messageFlow id="ov_msg13" name="Account statements" sourceRef="ov_sp7" targetRef="ov_cli" />
<bpmn:messageFlow id="ov_msg14" name="Outreach request" sourceRef="ov_sp8" targetRef="ov_adv" />
<bpmn:messageFlow id="ov_msg15" name="Due-diligence letter" sourceRef="ov_sp8" targetRef="ov_cli" />
<bpmn:messageFlow id="ov_msg16" name="Holder report and remittance" sourceRef="ov_sp8" targetRef="ov_state" />
<bpmn:messageFlow id="ov_msg17" name="SAR filings" sourceRef="ov_sp13" targetRef="ov_reg" />
<bpmn:messageFlow id="ov_msg18" name="Reports and tax filings" sourceRef="ov_sp14" targetRef="ov_reg" />
<bpmn:textAnnotation id="ov_ann0"><bpmn:text>Every subprocess reads from and posts to one double-entry ledger: client accounts roll up to the RIA master, RIA masters roll up to the custodian GL.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ov_ann1"><bpmn:text>Also event-driven: account maintenance, client entitlements, and the deceased client account (see their detail views).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ov_ann2"><bpmn:text>Billing and reporting wait until reconciliation has certified the period.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="ov_ann2_assoc" sourceRef="ov_ie" targetRef="ov_ann2" />
<bpmn:textAnnotation id="ov_ann3"><bpmn:text>Undeliverable residuals from offboarding and uncashed checks feed the escheatment cycle.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ov_process" name="Platform overview (level 1)" isExecutable="false">
<bpmn:laneSet id="ov_laneset">
<bpmn:lane id="ov_lane_acct" name="Account lifecycle (event-driven)">
<bpmn:flowNodeRef>ov_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ov_lane_trade" name="Trading and asset servicing">
<bpmn:flowNodeRef>ov_s7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ov_lane_daily" name="Daily cycle">
<bpmn:flowNodeRef>ov_s3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ov_lane_period" name="Periodic cycle">
<bpmn:flowNodeRef>ov_s4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_pg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_pj</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ov_lane_reg" name="Regulatory cycle">
<bpmn:flowNodeRef>ov_s6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_s11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_sp14</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ov_e11</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ov_s1" name="Onboarding package received">
<bpmn:outgoing>ov_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s1_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp1" name="RIA and client onboarding">
<bpmn:incoming>ov_flow0</bpmn:incoming>
<bpmn:outgoing>ov_flow1</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:exclusiveGateway id="ov_gm" name="">
<bpmn:incoming>ov_flow1</bpmn:incoming>
<bpmn:incoming>ov_flow2</bpmn:incoming>
<bpmn:outgoing>ov_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:startEvent id="ov_s2" name="Transfer or cash request received">
<bpmn:outgoing>ov_flow2</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s2_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp2" name="Asset and money transfers">
<bpmn:incoming>ov_flow3</bpmn:incoming>
<bpmn:outgoing>ov_flow4</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e1" name="Account active and funded">
<bpmn:incoming>ov_flow4</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s5" name="Closure request or outgoing ACATS received">
<bpmn:outgoing>ov_flow5</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s5_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp9" name="Client offboarding">
<bpmn:incoming>ov_flow5</bpmn:incoming>
<bpmn:outgoing>ov_flow6</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e5" name="Account closed">
<bpmn:incoming>ov_flow6</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s7" name="Order received">
<bpmn:outgoing>ov_flow7</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s7_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp10" name="Trade processing (all asset classes)">
<bpmn:incoming>ov_flow7</bpmn:incoming>
<bpmn:outgoing>ov_flow8</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e7" name="Trade settled">
<bpmn:incoming>ov_flow8</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s8" name="Corporate action announced">
<bpmn:outgoing>ov_flow9</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s8_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp11" name="Corporate actions">
<bpmn:incoming>ov_flow9</bpmn:incoming>
<bpmn:outgoing>ov_flow10</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e8" name="Event closed">
<bpmn:incoming>ov_flow10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s9" name="Capital call or distribution notice">
<bpmn:outgoing>ov_flow11</bpmn:outgoing>
<bpmn:messageEventDefinition id="ov_s9_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp12" name="Capital calls and distributions">
<bpmn:incoming>ov_flow11</bpmn:incoming>
<bpmn:outgoing>ov_flow12</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e9" name="Capital event closed">
<bpmn:incoming>ov_flow12</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s3" name="Each business day">
<bpmn:outgoing>ov_flow13</bpmn:outgoing>
<bpmn:timerEventDefinition id="ov_s3_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp3" name="Cash settlement across three layers">
<bpmn:incoming>ov_flow13</bpmn:incoming>
<bpmn:outgoing>ov_flow14</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:subProcess id="ov_sp4" name="Position reconciliation">
<bpmn:incoming>ov_flow14</bpmn:incoming>
<bpmn:incoming>ov_flow18</bpmn:incoming>
<bpmn:outgoing>ov_flow15</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:exclusiveGateway id="ov_g1" name="Books proven?">
<bpmn:incoming>ov_flow15</bpmn:incoming>
<bpmn:outgoing>ov_flow16</bpmn:outgoing>
<bpmn:outgoing>ov_flow17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:subProcess id="ov_sp5" name="Break resolution (inside reconciliation)">
<bpmn:incoming>ov_flow17</bpmn:incoming>
<bpmn:outgoing>ov_flow18</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e2" name="Day closed">
<bpmn:incoming>ov_flow16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s4" name="Period end: monthly or quarterly">
<bpmn:outgoing>ov_flow19</bpmn:outgoing>
<bpmn:timerEventDefinition id="ov_s4_def" />
</bpmn:startEvent>
<bpmn:intermediateCatchEvent id="ov_ie" name="Period certified by reconciliation">
<bpmn:incoming>ov_flow19</bpmn:incoming>
<bpmn:outgoing>ov_flow20</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="ov_ie_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">condition_met == true</bpmn:condition></bpmn:conditionalEventDefinition>
</bpmn:intermediateCatchEvent>
<bpmn:parallelGateway id="ov_pg" name="">
<bpmn:incoming>ov_flow20</bpmn:incoming>
<bpmn:outgoing>ov_flow21</bpmn:outgoing>
<bpmn:outgoing>ov_flow22</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:subProcess id="ov_sp6" name="Advisor billing">
<bpmn:incoming>ov_flow21</bpmn:incoming>
<bpmn:outgoing>ov_flow23</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:subProcess id="ov_sp7" name="Client reporting">
<bpmn:incoming>ov_flow22</bpmn:incoming>
<bpmn:outgoing>ov_flow24</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:parallelGateway id="ov_pj" name="">
<bpmn:incoming>ov_flow23</bpmn:incoming>
<bpmn:incoming>ov_flow24</bpmn:incoming>
<bpmn:outgoing>ov_flow25</bpmn:outgoing>
</bpmn:parallelGateway>
<bpmn:endEvent id="ov_e3" name="Period closed">
<bpmn:incoming>ov_flow25</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ov_s6" name="Daily dormancy and lost-owner monitoring">
<bpmn:outgoing>ov_flow26</bpmn:outgoing>
<bpmn:timerEventDefinition id="ov_s6_def" />
</bpmn:startEvent>
<bpmn:subProcess id="ov_sp8" name="Escheatment and unclaimed property">
<bpmn:incoming>ov_flow26</bpmn:incoming>
<bpmn:outgoing>ov_flow27</bpmn:outgoing>
</bpmn:subProcess>
<bpmn:endEvent id="ov_e6" name="Owner located or property reported">
<bpmn:incoming>ov_flow27</bpmn:incoming>
</bpmn:endEvent>
