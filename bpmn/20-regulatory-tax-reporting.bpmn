<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="rg_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="rg_collab">
<bpmn:participant id="rg_main" name="Custody operations platform (synthetic reference implementation)" processRef="rg_process" />
<bpmn:participant id="rg_reg" name="Regulators and tax authority: CAT, FINRA TRACE, MSRB RTRS, SEC and FINRA (blue sheets), IRS IRIS" />
<bpmn:messageFlow id="rg_msg0" name="Blue sheet request" sourceRef="rg_reg" targetRef="rg_s2" />
<bpmn:messageFlow id="rg_msg1" name="Report or filing" sourceRef="rg_t7" targetRef="rg_reg" />
<bpmn:messageFlow id="rg_msg2" name="Acknowledgment" sourceRef="rg_reg" targetRef="rg_ie1" />
<bpmn:messageFlow id="rg_msg3" name="Reject" sourceRef="rg_reg" targetRef="rg_ie2" />
<bpmn:textAnnotation id="rg_ann0"><bpmn:text>Report types: CAT order and trade events; TRACE and MSRB RTRS bond trades; blue sheet responses; Forms 1099, 1099-R, 5498, and 1042-S through IRS IRIS.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="rg_ann1"><bpmn:text>Tax forms also go to clients, with copies to the RIA, through statement delivery.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="rg_process" name="Regulatory and tax reporting" isExecutable="false">
<bpmn:laneSet id="rg_laneset">
<bpmn:lane id="rg_lane_ops" name="Regulatory reporting analysts">
<bpmn:flowNodeRef>rg_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rg_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>rg_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rg_lane_rules" name="Rules and reporting engine">
<bpmn:flowNodeRef>rg_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_g2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rg_lane_ledger" name="Platform services (ledger, trade store, filing)">
<bpmn:flowNodeRef>rg_s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_ie1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_ie2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_tm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rg_e2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="rg_s1" name="Report due by type and deadline">
<bpmn:outgoing>rg_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="rg_s1_def" />
</bpmn:startEvent>
<bpmn:startEvent id="rg_s2" name="Blue sheet request from a regulator">
<bpmn:outgoing>rg_flow1</bpmn:outgoing>
<bpmn:messageEventDefinition id="rg_s2_def" />
</bpmn:startEvent>
<bpmn:exclusiveGateway id="rg_g0" name="">
<bpmn:incoming>rg_flow0</bpmn:incoming>
<bpmn:incoming>rg_flow1</bpmn:incoming>
<bpmn:outgoing>rg_flow2</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="rg_t1" name="Identify the report type, scope, and deadline">
<bpmn:incoming>rg_flow2</bpmn:incoming>
<bpmn:outgoing>rg_flow3</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="rg_t2" name="Assemble report data from the ledger and trade store">
<bpmn:incoming>rg_flow3</bpmn:incoming>
<bpmn:outgoing>rg_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="rg_t3" name="Pre-check for likely rejects and missing fields (AI)">
<bpmn:incoming>rg_flow4</bpmn:incoming>
<bpmn:outgoing>rg_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="rg_t4" name="Validate format, completeness, and deadline">
<bpmn:incoming>rg_flow5</bpmn:incoming>
<bpmn:incoming>rg_flow8</bpmn:incoming>
<bpmn:outgoing>rg_flow6</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="rg_g2" name="Exceptions?">
<bpmn:incoming>rg_flow6</bpmn:incoming>
<bpmn:outgoing>rg_flow7</bpmn:outgoing>
<bpmn:outgoing>rg_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="rg_t5" name="Correct the exceptions">
<bpmn:incoming>rg_flow7</bpmn:incoming>
<bpmn:incoming>rg_flow18</bpmn:incoming>
<bpmn:outgoing>rg_flow8</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="rg_t6" name="Approve for submission">
<bpmn:incoming>rg_flow9</bpmn:incoming>
<bpmn:outgoing>rg_flow10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sendTask id="rg_t7" name="Submit through the regulator or IRS interface">
<bpmn:incoming>rg_flow10</bpmn:incoming>
<bpmn:outgoing>rg_flow11</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="rg_eg" name="">
<bpmn:incoming>rg_flow11</bpmn:incoming>
<bpmn:outgoing>rg_flow12</bpmn:outgoing>
<bpmn:outgoing>rg_flow13</bpmn:outgoing>
<bpmn:outgoing>rg_flow14</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="rg_ie1" name="Accepted">
<bpmn:incoming>rg_flow12</bpmn:incoming>
<bpmn:outgoing>rg_flow15</bpmn:outgoing>
<bpmn:messageEventDefinition id="rg_ie1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="rg_ie2" name="Rejected">
<bpmn:incoming>rg_flow13</bpmn:incoming>
<bpmn:outgoing>rg_flow17</bpmn:outgoing>
<bpmn:messageEventDefinition id="rg_ie2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="rg_tm" name="No response by the deadline">
<bpmn:incoming>rg_flow14</bpmn:incoming>
<bpmn:outgoing>rg_flow19</bpmn:outgoing>
<bpmn:timerEventDefinition id="rg_tm_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="rg_t8" name="Store the acknowledgment and filing receipt">
<bpmn:incoming>rg_flow15</bpmn:incoming>
<bpmn:outgoing>rg_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="rg_e1" name="Filed">
<bpmn:incoming>rg_flow16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="rg_t9" name="Explain the reject and propose a correction (AI)">
<bpmn:incoming>rg_flow17</bpmn:incoming>
<bpmn:outgoing>rg_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="rg_t10" name="Alert the reporting supervisor">
<bpmn:incoming>rg_flow19</bpmn:incoming>
<bpmn:outgoing>rg_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="rg_e2" name="Escalated">
<bpmn:incoming>rg_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="rg_flow0" name="" sourceRef="rg_s1" targetRef="rg_g0" />
<bpmn:sequenceFlow id="rg_flow1" name="" sourceRef="rg_s2" targetRef="rg_g0" />
<bpmn:sequenceFlow id="rg_flow2" name="" sourceRef="rg_g0" targetRef="rg_t1" />
<bpmn:sequenceFlow id="rg_flow3" name="" sourceRef="rg_t1" targetRef="rg_t2" />
<bpmn:sequenceFlow id="rg_flow4" name="" sourceRef="rg_t2" targetRef="rg_t3" />
<bpmn:sequenceFlow id="rg_flow5" name="" sourceRef="rg_t3" targetRef="rg_t4" />
<bpmn:sequenceFlow id="rg_flow6" name="" sourceRef="rg_t4" targetRef="rg_g2" />
<bpmn:sequenceFlow id="rg_flow7" name="Yes" sourceRef="rg_g2" targetRef="rg_t5" />
<bpmn:sequenceFlow id="rg_flow8" name="" sourceRef="rg_t5" targetRef="rg_t4" />
<bpmn:sequenceFlow id="rg_flow9" name="No" sourceRef="rg_g2" targetRef="rg_t6" />
<bpmn:sequenceFlow id="rg_flow10" name="" sourceRef="rg_t6" targetRef="rg_t7" />
<bpmn:sequenceFlow id="rg_flow11" name="" sourceRef="rg_t7" targetRef="rg_eg" />
<bpmn:sequenceFlow id="rg_flow12" name="" sourceRef="rg_eg" targetRef="rg_ie1" />
<bpmn:sequenceFlow id="rg_flow13" name="" sourceRef="rg_eg" targetRef="rg_ie2" />
<bpmn:sequenceFlow id="rg_flow14" name="" sourceRef="rg_eg" targetRef="rg_tm" />
<bpmn:sequenceFlow id="rg_flow15" name="" sourceRef="rg_ie1" targetRef="rg_t8" />
<bpmn:sequenceFlow id="rg_flow16" name="" sourceRef="rg_t8" targetRef="rg_e1" />
<bpmn:sequenceFlow id="rg_flow17" name="" sourceRef="rg_ie2" targetRef="rg_t9" />
<bpmn:sequenceFlow id="rg_flow18" name="Resubmit" sourceRef="rg_t9" targetRef="rg_t5" />
<bpmn:sequenceFlow id="rg_flow19" name="" sourceRef="rg_tm" targetRef="rg_t10" />
<bpmn:sequenceFlow id="rg_flow20" name="" sourceRef="rg_t10" targetRef="rg_e2" />
</bpmn:process>
