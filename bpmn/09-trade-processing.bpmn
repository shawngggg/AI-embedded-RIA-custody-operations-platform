<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="tp_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="tp_collab">
<bpmn:participant id="tp_main" name="Custody operations platform (synthetic reference implementation)" processRef="tp_process" />
<bpmn:participant id="tp_adv" name="RIA advisor, or the client on self-directed and dual accounts" />
<bpmn:participant id="tp_mkt" name="Executing brokers and market infrastructure: NSCC/DTC, OCC, Fund/SERV, Fedwire Securities, CLS, fund administrators" />
<bpmn:messageFlow id="tp_msg0" name="Block order or trade-away notice" sourceRef="tp_adv" targetRef="tp_s" />
<bpmn:messageFlow id="tp_msg1" name="Rejection" sourceRef="tp_rej" targetRef="tp_adv" />
<bpmn:messageFlow id="tp_msg2" name="Trade confirmation" sourceRef="tp_e" targetRef="tp_adv" />
<bpmn:messageFlow id="tp_msg3" name="DVP instruction" sourceRef="tp_b1" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg4" name="OCC clearing" sourceRef="tp_b2" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg5" name="Settlement instruction" sourceRef="tp_b3" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg6" name="Fund/SERV order" sourceRef="tp_b4" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg7" name="FX settlement" sourceRef="tp_b5" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg8" name="Subscription and wire" sourceRef="tp_b6" targetRef="tp_mkt" />
<bpmn:messageFlow id="tp_msg9" name="Confirmation" sourceRef="tp_mkt" targetRef="tp_c1" />
<bpmn:messageFlow id="tp_msg10" name="Fail notice" sourceRef="tp_mkt" targetRef="tp_c2" />
<bpmn:textAnnotation id="tp_ann0"><bpmn:text>Buying power uses settled cash, so cash accounts avoid good-faith violations.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="tp_ann1"><bpmn:text>Block trades are allocated at one average price so every account gets the same execution.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="tp_ann2"><bpmn:text>Cash legs hand off to the daily cash settlement cycle; positions feed reconciliation.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="tp_process" name="Trade processing (all asset classes)" isExecutable="false">
<bpmn:laneSet id="tp_laneset">
<bpmn:lane id="tp_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>tp_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_gr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_rej</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tp_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>tp_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tp_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>tp_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tp_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>tp_b1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_b2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_b3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_b4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_b5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_b6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_c1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_c2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tp_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="tp_s" name="Order or trade instruction received">
<bpmn:outgoing>tp_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="tp_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="tp_t1" name="Parse instructions; flag anomalies: size, concentration, price, duplicates (AI)">
<bpmn:incoming>tp_flow0</bpmn:incoming>
<bpmn:outgoing>tp_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="tp_t2" name="Pre-trade checks: order source allowed for management type, restrictions, buying power, approvals">
<bpmn:incoming>tp_flow1</bpmn:incoming>
<bpmn:incoming>tp_flow5</bpmn:incoming>
<bpmn:outgoing>tp_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="tp_g1" name="Checks pass?">
<bpmn:incoming>tp_flow2</bpmn:incoming>
<bpmn:outgoing>tp_flow3</bpmn:outgoing>
<bpmn:outgoing>tp_flow7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="tp_t3" name="Resolve with advisor: amend or cancel">
<bpmn:incoming>tp_flow3</bpmn:incoming>
<bpmn:outgoing>tp_flow4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="tp_gr" name="Amended?">
<bpmn:incoming>tp_flow4</bpmn:incoming>
<bpmn:outgoing>tp_flow5</bpmn:outgoing>
<bpmn:outgoing>tp_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="tp_rej" name="Order rejected">
<bpmn:incoming>tp_flow6</bpmn:incoming>
<bpmn:messageEventDefinition id="tp_rej_def" />
</bpmn:endEvent>
<bpmn:exclusiveGateway id="tp_g2" name="Asset class?">
<bpmn:incoming>tp_flow7</bpmn:incoming>
<bpmn:outgoing>tp_flow8</bpmn:outgoing>
<bpmn:outgoing>tp_flow9</bpmn:outgoing>
<bpmn:outgoing>tp_flow10</bpmn:outgoing>
<bpmn:outgoing>tp_flow11</bpmn:outgoing>
<bpmn:outgoing>tp_flow12</bpmn:outgoing>
<bpmn:outgoing>tp_flow13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="tp_b1" name="Equity / ETF: execute or trade away; DVP via NSCC/DTC, T+1">
<bpmn:incoming>tp_flow8</bpmn:incoming>
<bpmn:outgoing>tp_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tp_b2" name="Options: check approval level and coverage; clear via OCC, T+1">
<bpmn:incoming>tp_flow9</bpmn:incoming>
<bpmn:outgoing>tp_flow15</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tp_b3" name="Bonds: price with accrued interest; DTC or Fedwire Securities, T+1">
<bpmn:incoming>tp_flow10</bpmn:incoming>
<bpmn:outgoing>tp_flow16</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tp_b4" name="Mutual funds and MMF: Fund/SERV at next NAV; MMF often same-day">
<bpmn:incoming>tp_flow11</bpmn:incoming>
<bpmn:outgoing>tp_flow17</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tp_b5" name="FX: spot conversion (typically T+2) for foreign settlement">
<bpmn:incoming>tp_flow12</bpmn:incoming>
<bpmn:outgoing>tp_flow18</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tp_b6" name="Alternative funds: subscription docs, investor qualification, fund admin">
<bpmn:incoming>tp_flow13</bpmn:incoming>
<bpmn:outgoing>tp_flow19</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:exclusiveGateway id="tp_gm" name="">
<bpmn:incoming>tp_flow14</bpmn:incoming>
<bpmn:incoming>tp_flow15</bpmn:incoming>
<bpmn:incoming>tp_flow16</bpmn:incoming>
<bpmn:incoming>tp_flow17</bpmn:incoming>
<bpmn:incoming>tp_flow18</bpmn:incoming>
<bpmn:incoming>tp_flow19</bpmn:incoming>
<bpmn:outgoing>tp_flow20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="tp_t4" name="Match executions, allocations, and broker confirms; flag breaks (AI)">
<bpmn:incoming>tp_flow20</bpmn:incoming>
<bpmn:incoming>tp_flow23</bpmn:incoming>
<bpmn:outgoing>tp_flow21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="tp_g3" name="Matched?">
<bpmn:incoming>tp_flow21</bpmn:incoming>
<bpmn:outgoing>tp_flow22</bpmn:outgoing>
<bpmn:outgoing>tp_flow24</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="tp_t5" name="Resolve break with executing broker or advisor">
<bpmn:incoming>tp_flow22</bpmn:incoming>
<bpmn:outgoing>tp_flow23</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="tp_t6" name="Allocate at average price; post trade-date pending at client, RIA master, GL">
<bpmn:incoming>tp_flow24</bpmn:incoming>
<bpmn:outgoing>tp_flow25</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:eventBasedGateway id="tp_eg" name="">
<bpmn:incoming>tp_flow25</bpmn:incoming>
<bpmn:incoming>tp_flow32</bpmn:incoming>
<bpmn:outgoing>tp_flow26</bpmn:outgoing>
<bpmn:outgoing>tp_flow27</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="tp_c1" name="Settlement confirmed">
<bpmn:incoming>tp_flow26</bpmn:incoming>
<bpmn:outgoing>tp_flow28</bpmn:outgoing>
<bpmn:messageEventDefinition id="tp_c1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="tp_c2" name="Fail or DK notice">
<bpmn:incoming>tp_flow27</bpmn:incoming>
<bpmn:outgoing>tp_flow30</bpmn:outgoing>
<bpmn:messageEventDefinition id="tp_c2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="tp_t7" name="Settle: pending to settled at three layers; cash to settlement cycle">
<bpmn:incoming>tp_flow28</bpmn:incoming>
<bpmn:outgoing>tp_flow29</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="tp_e" name="Trade settled">
<bpmn:incoming>tp_flow29</bpmn:incoming>
<bpmn:messageEventDefinition id="tp_e_def" />
</bpmn:endEvent>
<bpmn:serviceTask id="tp_t8" name="Triage fail: classify cause, suggest cure (AI)">
<bpmn:incoming>tp_flow30</bpmn:incoming>
<bpmn:outgoing>tp_flow31</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="tp_t9" name="Cure fail: re-instruct, buy-in, or contact counterparty">
<bpmn:incoming>tp_flow31</bpmn:incoming>
<bpmn:outgoing>tp_flow32</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sequenceFlow id="tp_flow0" name="" sourceRef="tp_s" targetRef="tp_t1" />
<bpmn:sequenceFlow id="tp_flow1" name="" sourceRef="tp_t1" targetRef="tp_t2" />
<bpmn:sequenceFlow id="tp_flow2" name="" sourceRef="tp_t2" targetRef="tp_g1" />
<bpmn:sequenceFlow id="tp_flow3" name="No" sourceRef="tp_g1" targetRef="tp_t3" />
<bpmn:sequenceFlow id="tp_flow4" name="" sourceRef="tp_t3" targetRef="tp_gr" />
<bpmn:sequenceFlow id="tp_flow5" name="Yes: re-check" sourceRef="tp_gr" targetRef="tp_t2" />
<bpmn:sequenceFlow id="tp_flow6" name="No" sourceRef="tp_gr" targetRef="tp_rej" />
<bpmn:sequenceFlow id="tp_flow7" name="Yes" sourceRef="tp_g1" targetRef="tp_g2" />
<bpmn:sequenceFlow id="tp_flow8" name="Equity, ETF" sourceRef="tp_g2" targetRef="tp_b1" />
<bpmn:sequenceFlow id="tp_flow9" name="Options" sourceRef="tp_g2" targetRef="tp_b2" />
<bpmn:sequenceFlow id="tp_flow10" name="Bonds" sourceRef="tp_g2" targetRef="tp_b3" />
<bpmn:sequenceFlow id="tp_flow11" name="MF, MMF" sourceRef="tp_g2" targetRef="tp_b4" />
<bpmn:sequenceFlow id="tp_flow12" name="FX" sourceRef="tp_g2" targetRef="tp_b5" />
<bpmn:sequenceFlow id="tp_flow13" name="Alt funds" sourceRef="tp_g2" targetRef="tp_b6" />
<bpmn:sequenceFlow id="tp_flow14" name="" sourceRef="tp_b1" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow15" name="" sourceRef="tp_b2" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow16" name="" sourceRef="tp_b3" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow17" name="" sourceRef="tp_b4" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow18" name="" sourceRef="tp_b5" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow19" name="" sourceRef="tp_b6" targetRef="tp_gm" />
<bpmn:sequenceFlow id="tp_flow20" name="" sourceRef="tp_gm" targetRef="tp_t4" />
<bpmn:sequenceFlow id="tp_flow21" name="" sourceRef="tp_t4" targetRef="tp_g3" />
<bpmn:sequenceFlow id="tp_flow22" name="No" sourceRef="tp_g3" targetRef="tp_t5" />
<bpmn:sequenceFlow id="tp_flow23" name="Re-match" sourceRef="tp_t5" targetRef="tp_t4" />
<bpmn:sequenceFlow id="tp_flow24" name="Yes" sourceRef="tp_g3" targetRef="tp_t6" />
<bpmn:sequenceFlow id="tp_flow25" name="" sourceRef="tp_t6" targetRef="tp_eg" />
<bpmn:sequenceFlow id="tp_flow26" name="" sourceRef="tp_eg" targetRef="tp_c1" />
<bpmn:sequenceFlow id="tp_flow27" name="" sourceRef="tp_eg" targetRef="tp_c2" />
<bpmn:sequenceFlow id="tp_flow28" name="" sourceRef="tp_c1" targetRef="tp_t7" />
<bpmn:sequenceFlow id="tp_flow29" name="" sourceRef="tp_t7" targetRef="tp_e" />
<bpmn:sequenceFlow id="tp_flow30" name="" sourceRef="tp_c2" targetRef="tp_t8" />
<bpmn:sequenceFlow id="tp_flow31" name="" sourceRef="tp_t8" targetRef="tp_t9" />
<bpmn:sequenceFlow id="tp_flow32" name="Wait again" sourceRef="tp_t9" targetRef="tp_eg" />
</bpmn:process>
<bpmndi:BPMNDiagram id="tp_diagram" name="Trade processing (all asset classes)">
<bpmndi:BPMNPlane id="tp_plane" bpmnElement="tp_collab">
<bpmndi:BPMNShape id="tp_main_di" bpmnElement="tp_main" isHorizontal="true"><dc:Bounds x="0" y="124" width="4100" height="1170" /></bpmndi:BPMNShape>
