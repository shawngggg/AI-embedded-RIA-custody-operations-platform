<bpmndi:BPMNShape id="tp_t4_di" bpmnElement="tp_t4" bioc:stroke="#534AB7" bioc:fill="#EEEDFE" color:background-color="#EEEDFE" color:border-color="#534AB7"><dc:Bounds x="2500" y="334" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tp_g3_di" bpmnElement="tp_g3" isMarkerVisible="true"><dc:Bounds x="2755" y="524" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2715" y="580" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tp_t5_di" bpmnElement="tp_t5" bioc:stroke="#8A5A00" bioc:fill="#FFF4DE" color:background-color="#FFF4DE" color:border-color="#8A5A00"><dc:Bounds x="2700" y="164" width="160" height="90" /></bpmndi:BPMNShape>
