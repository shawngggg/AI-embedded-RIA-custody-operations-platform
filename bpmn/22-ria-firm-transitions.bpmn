<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ft_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ft_collab">
<bpmn:participant id="ft_main" name="Custody operations platform (synthetic reference implementation)" processRef="ft_process" />
<bpmn:participant id="ft_ria" name="RIA firm and its clients (clients sign applications, LPOAs, and transfer forms)" />
<bpmn:participant id="ft_ext" name="Other custodian (NSCC ACATS), transfer agents, and fund sponsors" />
<bpmn:messageFlow id="ft_msg0" name="Transition request" sourceRef="ft_ria" targetRef="ft_js" />
<bpmn:messageFlow id="ft_msg1" name="Client-signed applications, LPOAs, transfer forms" sourceRef="ft_ria" targetRef="ft_jca2" />
<bpmn:messageFlow id="ft_msg2" name="Cost-basis statements" sourceRef="ft_ext" targetRef="ft_jie" />
<bpmn:messageFlow id="ft_msg3" name="Termination notice" sourceRef="ft_ria" targetRef="ft_ls" />
<bpmn:messageFlow id="ft_msg4" name="Transfer forms (ACATS)" sourceRef="ft_ext" targetRef="ft_lie" />
<bpmn:messageFlow id="ft_msg5" name="Residual credits" sourceRef="ft_lt4" targetRef="ft_ext" />
<bpmn:textAnnotation id="ft_ann0"><bpmn:text>Clients authorize the move themselves with new applications, LPOAs, and transfer forms; negative consent isn't available. The RIA tells clients the new custodian's name and address.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ft_ann1"><bpmn:text>Large books move in planned batches over weeks to months; accounts are opened and linked before the transfer forms go in.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ft_ann2"><bpmn:text>Advisor moves between RIAs and RIA mergers have their own map.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ft_ann3"><bpmn:text>When a transfer validates, the account freezes and open orders cancel (FINRA Rule 11870), so the final fee comes out first. Residual credits follow for at least 6 months.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ft_process" name="RIA firm transitions" isExecutable="false">
<bpmn:laneSet id="ft_laneset">
<bpmn:lane id="ft_lane_ops" name="Custody operations (transitions team)">
<bpmn:flowNodeRef>ft_js</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jca1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jt1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jca2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jca3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jca4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jt5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_ls</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lt1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lca1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lca2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ft_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>ft_jt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jt4</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ft_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ft_jg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lg1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ft_lane_ledger" name="Ledger, billing, and account services">
<bpmn:flowNodeRef>ft_jt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_jt6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_je</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_lt4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ft_le</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ft_js" name="RIA joins with its book">
<bpmn:outgoing>ft_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ft_js_def" />
</bpmn:startEvent>
<bpmn:callActivity id="ft_jca1" name="RIA firm onboarding, if the firm is new" calledElement="rf_process">
<bpmn:incoming>ft_flow0</bpmn:incoming>
<bpmn:outgoing>ft_flow1</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:userTask id="ft_jt1" name="Plan the move: account list, target date, transfer batches, fee schedules">
<bpmn:incoming>ft_flow1</bpmn:incoming>
<bpmn:outgoing>ft_flow2</bpmn:outgoing>
</bpmn:userTask>
<bpmn:callActivity id="ft_jca2" name="Open each client account (account opening)" calledElement="ao_process">
<bpmn:incoming>ft_flow2</bpmn:incoming>
<bpmn:outgoing>ft_flow3</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:serviceTask id="ft_jt2" name="Link accounts to the RIA master and rep codes; set fee schedules">
<bpmn:incoming>ft_flow3</bpmn:incoming>
<bpmn:outgoing>ft_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ft_jt3" name="Read prior-custodian statements; flag likely ACATS rejects and non-transferable assets (AI)">
<bpmn:incoming>ft_flow4</bpmn:incoming>
<bpmn:outgoing>ft_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:callActivity id="ft_jca3" name="Transferability review of incoming assets" calledElement="xr_process">
<bpmn:incoming>ft_flow5</bpmn:incoming>
<bpmn:outgoing>ft_flow6</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:callActivity id="ft_jca4" name="Bulk incoming transfers in batches (transfers process)" calledElement="tr_process">
<bpmn:incoming>ft_flow6</bpmn:incoming>
<bpmn:outgoing>ft_flow7</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:intermediateCatchEvent id="ft_jie" name="Cost-basis statements received (due within 15 days of settlement)">
<bpmn:incoming>ft_flow7</bpmn:incoming>
<bpmn:outgoing>ft_flow8</bpmn:outgoing>
<bpmn:messageEventDefinition id="ft_jie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="ft_jt4" name="Reconcile positions and cost basis against prior statements; flag breaks (AI)">
<bpmn:incoming>ft_flow8</bpmn:incoming>
<bpmn:incoming>ft_flow11</bpmn:incoming>
<bpmn:outgoing>ft_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ft_jg1" name="Breaks?">
<bpmn:incoming>ft_flow9</bpmn:incoming>
<bpmn:outgoing>ft_flow10</bpmn:outgoing>
<bpmn:outgoing>ft_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ft_jt5" name="Resolve breaks with the prior custodian or transfer agent">
<bpmn:incoming>ft_flow10</bpmn:incoming>
<bpmn:outgoing>ft_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="ft_jt6" name="Start billing from each account's funding date (pro-rated first period)">
<bpmn:incoming>ft_flow12</bpmn:incoming>
<bpmn:outgoing>ft_flow13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ft_je" name="Book transferred">
<bpmn:incoming>ft_flow13</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ft_ls" name="RIA gives notice it is leaving">
<bpmn:outgoing>ft_flow14</bpmn:outgoing>
<bpmn:messageEventDefinition id="ft_ls_def" />
</bpmn:startEvent>
<bpmn:userTask id="ft_lt1" name="Confirm the plan with the RIA: receiving custodian, date, accounts">
<bpmn:incoming>ft_flow14</bpmn:incoming>
<bpmn:outgoing>ft_flow15</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="ft_lt2" name="Deduct final pro-rated fees before transfers validate">
<bpmn:incoming>ft_flow15</bpmn:incoming>
<bpmn:outgoing>ft_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="ft_lie" name="Client-signed transfer forms arrive">
<bpmn:incoming>ft_flow16</bpmn:incoming>
<bpmn:outgoing>ft_flow17</bpmn:outgoing>
<bpmn:messageEventDefinition id="ft_lie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:callActivity id="ft_lca1" name="Outgoing transferability review and transfers (transfers process)" calledElement="tr_process">
<bpmn:incoming>ft_flow17</bpmn:incoming>
<bpmn:outgoing>ft_flow18</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="ft_lg1" name="Accounts left after the deadline?">
<bpmn:incoming>ft_flow18</bpmn:incoming>
<bpmn:outgoing>ft_flow19</bpmn:outgoing>
<bpmn:outgoing>ft_flow20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="ft_lca2" name="Client offboarding: pick an RIA on the platform or transfer out" calledElement="co_process">
<bpmn:incoming>ft_flow19</bpmn:incoming>
<bpmn:outgoing>ft_flow21</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:serviceTask id="ft_lt3" name="End the RIA's authority and fee deduction; deactivate its users and master">
<bpmn:incoming>ft_flow20</bpmn:incoming>
<bpmn:incoming>ft_flow21</bpmn:incoming>
<bpmn:outgoing>ft_flow22</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ft_lt4" name="Sweep residual credits to receiving firms for at least 6 months">
<bpmn:incoming>ft_flow22</bpmn:incoming>
<bpmn:outgoing>ft_flow23</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ft_le" name="Firm offboarded">
<bpmn:incoming>ft_flow23</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="ft_flow0" name="" sourceRef="ft_js" targetRef="ft_jca1" />
<bpmn:sequenceFlow id="ft_flow1" name="" sourceRef="ft_jca1" targetRef="ft_jt1" />
<bpmn:sequenceFlow id="ft_flow2" name="" sourceRef="ft_jt1" targetRef="ft_jca2" />
<bpmn:sequenceFlow id="ft_flow3" name="" sourceRef="ft_jca2" targetRef="ft_jt2" />
<bpmn:sequenceFlow id="ft_flow4" name="" sourceRef="ft_jt2" targetRef="ft_jt3" />
<bpmn:sequenceFlow id="ft_flow5" name="" sourceRef="ft_jt3" targetRef="ft_jca3" />
<bpmn:sequenceFlow id="ft_flow6" name="" sourceRef="ft_jca3" targetRef="ft_jca4" />
<bpmn:sequenceFlow id="ft_flow7" name="" sourceRef="ft_jca4" targetRef="ft_jie" />
<bpmn:sequenceFlow id="ft_flow8" name="" sourceRef="ft_jie" targetRef="ft_jt4" />
<bpmn:sequenceFlow id="ft_flow9" name="" sourceRef="ft_jt4" targetRef="ft_jg1" />
<bpmn:sequenceFlow id="ft_flow10" name="Yes" sourceRef="ft_jg1" targetRef="ft_jt5" />
<bpmn:sequenceFlow id="ft_flow11" name="Re-check" sourceRef="ft_jt5" targetRef="ft_jt4" />
<bpmn:sequenceFlow id="ft_flow12" name="No" sourceRef="ft_jg1" targetRef="ft_jt6" />
<bpmn:sequenceFlow id="ft_flow13" name="" sourceRef="ft_jt6" targetRef="ft_je" />
<bpmn:sequenceFlow id="ft_flow14" name="" sourceRef="ft_ls" targetRef="ft_lt1" />
<bpmn:sequenceFlow id="ft_flow15" name="" sourceRef="ft_lt1" targetRef="ft_lt2" />
<bpmn:sequenceFlow id="ft_flow16" name="" sourceRef="ft_lt2" targetRef="ft_lie" />
<bpmn:sequenceFlow id="ft_flow17" name="" sourceRef="ft_lie" targetRef="ft_lca1" />
<bpmn:sequenceFlow id="ft_flow18" name="" sourceRef="ft_lca1" targetRef="ft_lg1" />
<bpmn:sequenceFlow id="ft_flow19" name="Yes" sourceRef="ft_lg1" targetRef="ft_lca2" />
<bpmn:sequenceFlow id="ft_flow20" name="No" sourceRef="ft_lg1" targetRef="ft_lt3" />
<bpmn:sequenceFlow id="ft_flow21" name="" sourceRef="ft_lca2" targetRef="ft_lt3" />
<bpmn:sequenceFlow id="ft_flow22" name="" sourceRef="ft_lt3" targetRef="ft_lt4" />
<bpmn:sequenceFlow id="ft_flow23" name="" sourceRef="ft_lt4" targetRef="ft_le" />
</bpmn:process>
