<bpmndi:BPMNShape id="ft_ann1_di" bpmnElement="ft_ann1"><dc:Bounds x="300" y="367" width="360" height="64" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ft_ann2_di" bpmnElement="ft_ann2"><dc:Bounds x="450" y="554" width="260" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="ft_ann3_di" bpmnElement="ft_ann3"><dc:Bounds x="3110" y="541" width="340" height="76" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="ft_flow0_di" bpmnElement="ft_flow0"><di:waypoint x="198" y="219" /><di:waypoint x="300" y="219" /></bpmndi:BPMNEdge>
