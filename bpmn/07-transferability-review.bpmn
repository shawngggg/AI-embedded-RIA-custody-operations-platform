<bpmndi:BPMNShape id="xr_adv_di" bpmnElement="xr_adv" isHorizontal="true" bioc:stroke="#5B6578" bioc:fill="#F3F5F9" color:background-color="#F3F5F9" color:border-color="#5B6578"><dc:Bounds x="0" y="0" width="2300" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="xr_spn_di" bpmnElement="xr_spn" isHorizontal="true" bioc:stroke="#5B6578" bioc:fill="#F3F5F9" color:background-color="#F3F5F9" color:border-color="#5B6578"><dc:Bounds x="0" y="948" width="2300" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="xr_s_di" bpmnElement="xr_s"><dc:Bounds x="162" y="591" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="120" y="633" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
