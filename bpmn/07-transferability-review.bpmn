<bpmndi:BPMNShape id="xr_t2_di" bpmnElement="xr_t2" bioc:stroke="#1F3864" bioc:fill="#E6EDF7" color:background-color="#E6EDF7" color:border-color="#1F3864"><dc:Bounds x="500" y="564" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="xr_g1_di" bpmnElement="xr_g1"><dc:Bounds x="755" y="584" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="643" y="562" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
