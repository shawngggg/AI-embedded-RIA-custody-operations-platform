<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="co_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="co_collab">
<bpmn:participant id="co_main" name="Custody operations platform (synthetic reference implementation)" processRef="co_process" />
<bpmn:participant id="co_ria" name="RIA advisor" />
<bpmn:participant id="co_rcv" name="Receiving firm or institution (NSCC ACATS or direct)" />
<bpmn:messageFlow id="co_msg0" name="Termination notice" sourceRef="co_ria" targetRef="co_s1" />
<bpmn:messageFlow id="co_msg1" name="TIF or transfer instructions" sourceRef="co_rcv" targetRef="co_ie1" />
<bpmn:messageFlow id="co_msg2" name="Closure confirmation" sourceRef="co_e" targetRef="co_ria" />
<bpmn:textAnnotation id="co_ann0"><bpmn:text>The RIA notifies the custodian; the client never initiates offboarding. If no RIA-managed account will remain, the client&#39;s self-directed account is restricted and transferred out the same way.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="co_ann1"><bpmn:text>Undeliverable residuals and uncashed checks enter the escheatment process.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="co_process" name="Client offboarding (client leaves the RIA, or compliance exit)" isExecutable="false">
<bpmn:laneSet id="co_laneset">
<bpmn:lane id="co_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>co_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t7</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="co_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>co_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="co_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>co_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="co_lane_comp" name="Compliance and supervision">
<bpmn:flowNodeRef>co_s3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="co_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>co_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_ie1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_ca1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_ca2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_tw</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>co_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="co_s1" name="RIA notifies: client is leaving">
<bpmn:outgoing>co_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="co_s1_def" />
</bpmn:startEvent>
<bpmn:startEvent id="co_s3" name="Compliance exit decision">
<bpmn:outgoing>co_flow1</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="co_s3_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">condition_met == true</bpmn:condition></bpmn:conditionalEventDefinition>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="co_g0" name="">
<bpmn:incoming>co_flow0</bpmn:incoming>
<bpmn:incoming>co_flow1</bpmn:incoming>
<bpmn:outgoing>co_flow2</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="co_t1" name="Restriction code: outgoing transfers only (no trading, no other money movement)">
<bpmn:incoming>co_flow2</bpmn:incoming>
<bpmn:outgoing>co_flow3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="co_t2" name="Closure pre-checks: open orders, pending items, debit balances, other holds">
<bpmn:incoming>co_flow3</bpmn:incoming>
<bpmn:outgoing>co_flow4</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="co_g1" name="Other holds?">
<bpmn:incoming>co_flow4</bpmn:incoming>
<bpmn:outgoing>co_flow5</bpmn:outgoing>
<bpmn:outgoing>co_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="co_t3" name="Resolve hold: garnishment, levy, court order, AML (sanctions holds stay with the sanctions team)">
<bpmn:incoming>co_flow5</bpmn:incoming>
<bpmn:outgoing>co_flow7</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="co_g2" name="">
<bpmn:incoming>co_flow6</bpmn:incoming>
<bpmn:incoming>co_flow7</bpmn:incoming>
<bpmn:outgoing>co_flow8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="co_t4" name="Calculate final pro-rated advisory fee (refund if billed in advance)">
<bpmn:incoming>co_flow8</bpmn:incoming>
<bpmn:outgoing>co_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="co_ie1" name="Transfer request from the receiving firm">
<bpmn:incoming>co_flow9</bpmn:incoming>
<bpmn:outgoing>co_flow10</bpmn:outgoing>
<bpmn:messageEventDefinition id="co_ie1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:callActivity id="co_ca1" name="Transferability review, outgoing (shared subprocess)" calledElement="xr_process">
<bpmn:incoming>co_flow10</bpmn:incoming>
<bpmn:outgoing>co_flow11</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:callActivity id="co_ca2" name="Transfer assets (transfers process)" calledElement="tr_process">
<bpmn:incoming>co_flow11</bpmn:incoming>
<bpmn:outgoing>co_flow12</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:intermediateCatchEvent id="co_tw" name="Residual monitoring window ends">
<bpmn:incoming>co_flow12</bpmn:incoming>
<bpmn:outgoing>co_flow13</bpmn:outgoing>
<bpmn:timerEventDefinition id="co_tw_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="co_t5" name="Verify zero balances at client, RIA master, and GL">
<bpmn:incoming>co_flow13</bpmn:incoming>
<bpmn:incoming>co_flow18</bpmn:incoming>
<bpmn:outgoing>co_flow14</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="co_g3" name="Zero balance?">
<bpmn:incoming>co_flow14</bpmn:incoming>
<bpmn:outgoing>co_flow15</bpmn:outgoing>
<bpmn:outgoing>co_flow19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="co_t6" name="Identify residual items and propose disposition (AI)">
<bpmn:incoming>co_flow15</bpmn:incoming>
<bpmn:outgoing>co_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="co_t7" name="Approve residual disposition">
<bpmn:incoming>co_flow16</bpmn:incoming>
<bpmn:outgoing>co_flow17</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="co_t8" name="Post residual: deliver via transfers or move to unclaimed-property liability">
<bpmn:incoming>co_flow17</bpmn:incoming>
<bpmn:outgoing>co_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="co_t9" name="Close account: revoke RIA authority and client grants; end instructions">
<bpmn:incoming>co_flow19</bpmn:incoming>
<bpmn:outgoing>co_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="co_t10" name="Retain records; flag final-year tax reporting (1099s, 1099-R)">
<bpmn:incoming>co_flow20</bpmn:incoming>
<bpmn:outgoing>co_flow21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="co_e" name="Closure confirmed">
<bpmn:incoming>co_flow21</bpmn:incoming>
<bpmn:messageEventDefinition id="co_e_def" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="co_flow0" name="" sourceRef="co_s1" targetRef="co_g0" />
<bpmn:sequenceFlow id="co_flow1" name="" sourceRef="co_s3" targetRef="co_g0" />
<bpmn:sequenceFlow id="co_flow2" name="" sourceRef="co_g0" targetRef="co_t1" />
<bpmn:sequenceFlow id="co_flow3" name="" sourceRef="co_t1" targetRef="co_t2" />
<bpmn:sequenceFlow id="co_flow4" name="" sourceRef="co_t2" targetRef="co_g1" />
<bpmn:sequenceFlow id="co_flow5" name="Yes" sourceRef="co_g1" targetRef="co_t3" />
<bpmn:sequenceFlow id="co_flow6" name="No" sourceRef="co_g1" targetRef="co_g2" />
<bpmn:sequenceFlow id="co_flow7" name="" sourceRef="co_t3" targetRef="co_g2" />
<bpmn:sequenceFlow id="co_flow8" name="" sourceRef="co_g2" targetRef="co_t4" />
<bpmn:sequenceFlow id="co_flow9" name="" sourceRef="co_t4" targetRef="co_ie1" />
<bpmn:sequenceFlow id="co_flow10" name="" sourceRef="co_ie1" targetRef="co_ca1" />
<bpmn:sequenceFlow id="co_flow11" name="" sourceRef="co_ca1" targetRef="co_ca2" />
<bpmn:sequenceFlow id="co_flow12" name="" sourceRef="co_ca2" targetRef="co_tw" />
<bpmn:sequenceFlow id="co_flow13" name="" sourceRef="co_tw" targetRef="co_t5" />
<bpmn:sequenceFlow id="co_flow14" name="" sourceRef="co_t5" targetRef="co_g3" />
<bpmn:sequenceFlow id="co_flow15" name="No" sourceRef="co_g3" targetRef="co_t6" />
<bpmn:sequenceFlow id="co_flow16" name="" sourceRef="co_t6" targetRef="co_t7" />
<bpmn:sequenceFlow id="co_flow17" name="" sourceRef="co_t7" targetRef="co_t8" />
<bpmn:sequenceFlow id="co_flow18" name="Re-verify" sourceRef="co_t8" targetRef="co_t5" />
<bpmn:sequenceFlow id="co_flow19" name="Yes" sourceRef="co_g3" targetRef="co_t9" />
<bpmn:sequenceFlow id="co_flow20" name="" sourceRef="co_t9" targetRef="co_t10" />
<bpmn:sequenceFlow id="co_flow21" name="" sourceRef="co_t10" targetRef="co_e" />
</bpmn:process>
