<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="cc_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="cc_collab">
<bpmn:participant id="cc_main" name="Custody operations platform (synthetic reference implementation)" processRef="cc_process" />
<bpmn:participant id="cc_adv" name="RIA advisor" />
<bpmn:participant id="cc_fa" name="Fund administrators and general partners" />
<bpmn:messageFlow id="cc_msg0" name="Notice" sourceRef="cc_fa" targetRef="cc_s" />
<bpmn:messageFlow id="cc_msg1" name="Capital call notice" sourceRef="cc_k1" targetRef="cc_adv" />
<bpmn:messageFlow id="cc_msg2" name="Funding instruction" sourceRef="cc_adv" targetRef="cc_k2" />
<bpmn:messageFlow id="cc_msg3" name="Distribution wire" sourceRef="cc_fa" targetRef="cc_d1" />
<bpmn:messageFlow id="cc_msg4" name="Capital activity statement" sourceRef="cc_e" targetRef="cc_adv" />
<bpmn:textAnnotation id="cc_ann0"><bpmn:text>Notices arrive as PDFs and portal postings; AI extracts the terms and rules validate them against the commitment record.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="cc_ann1"><bpmn:text>Tax character comes from the fund; final figures arrive later on Schedule K-1.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="cc_process" name="Capital calls and distributions (alternative funds)" isExecutable="false">
<bpmn:laneSet id="cc_laneset">
<bpmn:lane id="cc_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>cc_k1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_ek</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cc_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>cc_t1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cc_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>cc_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_gk</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_d2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cc_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>cc_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_k8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_d1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_d3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cc_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="cc_s" name="Capital call or distribution notice received">
<bpmn:outgoing>cc_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="cc_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="cc_t1" name="Extract notice terms: amount, dates, commitment, tax character (AI)">
<bpmn:incoming>cc_flow0</bpmn:incoming>
<bpmn:outgoing>cc_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="cc_t2" name="Validate against fund records: commitment, unfunded balance, allocation">
<bpmn:incoming>cc_flow1</bpmn:incoming>
<bpmn:outgoing>cc_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="cc_g1" name="Notice type?">
<bpmn:incoming>cc_flow2</bpmn:incoming>
<bpmn:outgoing>cc_flow3</bpmn:outgoing>
<bpmn:outgoing>cc_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="cc_k1" name="Notify advisor: call amount, due date, funding source">
<bpmn:incoming>cc_flow3</bpmn:incoming>
<bpmn:outgoing>cc_flow4</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="cc_eg" name="">
<bpmn:incoming>cc_flow4</bpmn:incoming>
<bpmn:outgoing>cc_flow5</bpmn:outgoing>
<bpmn:outgoing>cc_flow6</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="cc_k2" name="Funding instruction received">
<bpmn:incoming>cc_flow5</bpmn:incoming>
<bpmn:outgoing>cc_flow9</bpmn:outgoing>
<bpmn:messageEventDefinition id="cc_k2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="cc_k3" name="Due date at risk">
<bpmn:incoming>cc_flow6</bpmn:incoming>
<bpmn:outgoing>cc_flow7</bpmn:outgoing>
<bpmn:timerEventDefinition id="cc_k3_def" />
</bpmn:intermediateCatchEvent>
<bpmn:userTask id="cc_k4" name="Escalate default risk to advisor and compliance">
<bpmn:incoming>cc_flow7</bpmn:incoming>
<bpmn:outgoing>cc_flow8</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="cc_ek" name="Escalated under fund default terms">
<bpmn:incoming>cc_flow8</bpmn:incoming>
</bpmn:endEvent>
<bpmn:businessRuleTask id="cc_k5" name="Check settled cash covers the call; reserve it">
<bpmn:incoming>cc_flow9</bpmn:incoming>
<bpmn:incoming>cc_flow13</bpmn:incoming>
<bpmn:outgoing>cc_flow10</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="cc_gk" name="Cash covers call?">
<bpmn:incoming>cc_flow10</bpmn:incoming>
<bpmn:outgoing>cc_flow11</bpmn:outgoing>
<bpmn:outgoing>cc_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="cc_k6" name="Advisor raises cash: sale or deposit">
<bpmn:incoming>cc_flow12</bpmn:incoming>
<bpmn:outgoing>cc_flow13</bpmn:outgoing>
</bpmn:userTask>
<bpmn:callActivity id="cc_k7" name="Wire capital to the fund (transfers process)" calledElement="shared_process">
<bpmn:incoming>cc_flow11</bpmn:incoming>
<bpmn:outgoing>cc_flow14</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:serviceTask id="cc_k8" name="Reduce unfunded commitment; record contributed capital (three layers)">
<bpmn:incoming>cc_flow14</bpmn:incoming>
<bpmn:outgoing>cc_flow15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="cc_d1" name="Distribution cash received">
<bpmn:incoming>cc_flow16</bpmn:incoming>
<bpmn:outgoing>cc_flow17</bpmn:outgoing>
<bpmn:messageEventDefinition id="cc_d1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="cc_d2" name="Classify distribution: income, gain, or return of capital">
<bpmn:incoming>cc_flow17</bpmn:incoming>
<bpmn:outgoing>cc_flow18</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="cc_d3" name="Credit client cash; reduce basis for return of capital (three layers)">
<bpmn:incoming>cc_flow18</bpmn:incoming>
<bpmn:outgoing>cc_flow19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cc_gm" name="">
<bpmn:incoming>cc_flow15</bpmn:incoming>
<bpmn:incoming>cc_flow19</bpmn:incoming>
<bpmn:outgoing>cc_flow20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cc_t9" name="Update investor capital account and commitment schedule">
<bpmn:incoming>cc_flow20</bpmn:incoming>
<bpmn:outgoing>cc_flow21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="cc_e" name="Capital event closed">
<bpmn:incoming>cc_flow21</bpmn:incoming>
<bpmn:messageEventDefinition id="cc_e_def" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="cc_flow0" name="" sourceRef="cc_s" targetRef="cc_t1" />
<bpmn:sequenceFlow id="cc_flow1" name="" sourceRef="cc_t1" targetRef="cc_t2" />
<bpmn:sequenceFlow id="cc_flow2" name="" sourceRef="cc_t2" targetRef="cc_g1" />
<bpmn:sequenceFlow id="cc_flow3" name="Capital call" sourceRef="cc_g1" targetRef="cc_k1" />
<bpmn:sequenceFlow id="cc_flow4" name="" sourceRef="cc_k1" targetRef="cc_eg" />
<bpmn:sequenceFlow id="cc_flow5" name="" sourceRef="cc_eg" targetRef="cc_k2" />
<bpmn:sequenceFlow id="cc_flow6" name="" sourceRef="cc_eg" targetRef="cc_k3" />
<bpmn:sequenceFlow id="cc_flow7" name="" sourceRef="cc_k3" targetRef="cc_k4" />
<bpmn:sequenceFlow id="cc_flow8" name="" sourceRef="cc_k4" targetRef="cc_ek" />
<bpmn:sequenceFlow id="cc_flow9" name="" sourceRef="cc_k2" targetRef="cc_k5" />
<bpmn:sequenceFlow id="cc_flow10" name="" sourceRef="cc_k5" targetRef="cc_gk" />
<bpmn:sequenceFlow id="cc_flow11" name="Yes" sourceRef="cc_gk" targetRef="cc_k7" />
<bpmn:sequenceFlow id="cc_flow12" name="No" sourceRef="cc_gk" targetRef="cc_k6" />
<bpmn:sequenceFlow id="cc_flow13" name="Re-check" sourceRef="cc_k6" targetRef="cc_k5" />
<bpmn:sequenceFlow id="cc_flow14" name="" sourceRef="cc_k7" targetRef="cc_k8" />
<bpmn:sequenceFlow id="cc_flow15" name="" sourceRef="cc_k8" targetRef="cc_gm" />
<bpmn:sequenceFlow id="cc_flow16" name="Distribution" sourceRef="cc_g1" targetRef="cc_d1" />
<bpmn:sequenceFlow id="cc_flow17" name="" sourceRef="cc_d1" targetRef="cc_d2" />
<bpmn:sequenceFlow id="cc_flow18" name="" sourceRef="cc_d2" targetRef="cc_d3" />
<bpmn:sequenceFlow id="cc_flow19" name="" sourceRef="cc_d3" targetRef="cc_gm" />
<bpmn:sequenceFlow id="cc_flow20" name="" sourceRef="cc_gm" targetRef="cc_t9" />
<bpmn:sequenceFlow id="cc_flow21" name="" sourceRef="cc_t9" targetRef="cc_e" />
</bpmn:process>
