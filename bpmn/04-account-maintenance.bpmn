<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="am_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="am_collab">
<bpmn:participant id="am_main" name="Custody operations platform (synthetic reference implementation)" processRef="am_process" />
<bpmn:participant id="am_ria" name="RIA advisor (sole channel for account changes)" />
<bpmn:participant id="am_cli" name="Client (notices only)" />
<bpmn:messageFlow id="am_msg0" name="Change request" sourceRef="am_ria" targetRef="am_s" />
<bpmn:messageFlow id="am_msg1" name="Rejection or redirect" sourceRef="am_e0" targetRef="am_ria" />
<bpmn:messageFlow id="am_msg2" name="Return for correction" sourceRef="am_t3" targetRef="am_ria" />
<bpmn:messageFlow id="am_msg3" name="Corrected request" sourceRef="am_ria" targetRef="am_ie" />
<bpmn:messageFlow id="am_msg4" name="Authenticity check" sourceRef="am_t5" targetRef="am_ria" />
<bpmn:messageFlow id="am_msg5" name="Change confirmation" sourceRef="am_t8" targetRef="am_cli" />
<bpmn:textAnnotation id="am_ann0"><bpmn:text>Client-signed forms (beneficiary, title, bank instructions) are submitted by the RIA.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="am_ann1"><bpmn:text>No cooling periods: RIA-confirmed changes take effect directly; new bank instructions activate only after verification.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="am_process" name="Account maintenance (RIA-only channel)" isExecutable="false">
<bpmn:laneSet id="am_laneset">
<bpmn:lane id="am_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>am_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_e0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_casx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_gc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_es</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_cadd</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="am_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>am_t1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="am_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>am_t0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_gm1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_gm2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_gm3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="am_lane_comp" name="AML compliance (second line)">
<bpmn:flowNodeRef>am_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_g2b</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_ef</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="am_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>am_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>am_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="am_s" name="Change request received">
<bpmn:outgoing>am_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="am_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="am_t0" name="Channel check: request from an authorized RIA user">
<bpmn:incoming>am_flow0</bpmn:incoming>
<bpmn:outgoing>am_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="am_g0" name="Authorized RIA user?">
<bpmn:incoming>am_flow1</bpmn:incoming>
<bpmn:outgoing>am_flow2</bpmn:outgoing>
<bpmn:outgoing>am_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="am_e0" name="Rejected; client requests redirected to the RIA">
<bpmn:incoming>am_flow2</bpmn:incoming>
<bpmn:messageEventDefinition id="am_e0_def" />
</bpmn:endEvent>
<bpmn:serviceTask id="am_t1" name="Classify change type; extract forms and documents (AI)">
<bpmn:incoming>am_flow3</bpmn:incoming>
<bpmn:incoming>am_flow8</bpmn:incoming>
<bpmn:outgoing>am_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="am_t2" name="Authority check: within the RIA's LPOA, or a client-signed form required">
<bpmn:incoming>am_flow4</bpmn:incoming>
<bpmn:outgoing>am_flow5</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="am_g1" name="In good order?">
<bpmn:incoming>am_flow5</bpmn:incoming>
<bpmn:outgoing>am_flow6</bpmn:outgoing>
<bpmn:outgoing>am_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="am_t3" name="Return to the RIA: missing signature, document, or medallion">
<bpmn:incoming>am_flow6</bpmn:incoming>
<bpmn:outgoing>am_flow7</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="am_ie" name="Corrected request received">
<bpmn:incoming>am_flow7</bpmn:incoming>
<bpmn:outgoing>am_flow8</bpmn:outgoing>
<bpmn:messageEventDefinition id="am_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="am_t4" name="Fraud-pattern check: address, bank, and disbursement changes together">
<bpmn:incoming>am_flow9</bpmn:incoming>
<bpmn:outgoing>am_flow10</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="am_g2" name="Suspicious pattern?">
<bpmn:incoming>am_flow10</bpmn:incoming>
<bpmn:outgoing>am_flow11</bpmn:outgoing>
<bpmn:outgoing>am_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="am_t5" name="Confirm authenticity of the request with the RIA">
<bpmn:incoming>am_flow11</bpmn:incoming>
<bpmn:outgoing>am_flow12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="am_g2b" name="Confirmed?">
<bpmn:incoming>am_flow12</bpmn:incoming>
<bpmn:outgoing>am_flow13</bpmn:outgoing>
<bpmn:outgoing>am_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="am_ef" name="Rejected; fraud case opened">
<bpmn:incoming>am_flow13</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="am_gm1" name="">
<bpmn:incoming>am_flow14</bpmn:incoming>
<bpmn:incoming>am_flow15</bpmn:incoming>
<bpmn:outgoing>am_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="am_t6" name="First-line flagged-list check on new parties: owner, trustee, beneficiary, bank">
<bpmn:incoming>am_flow16</bpmn:incoming>
<bpmn:outgoing>am_flow17</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="am_g3" name="Flagged?">
<bpmn:incoming>am_flow17</bpmn:incoming>
<bpmn:outgoing>am_flow18</bpmn:outgoing>
<bpmn:outgoing>am_flow22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="am_casx" name="Sanctions escalation (shared subprocess)" calledElement="sx_process">
<bpmn:incoming>am_flow18</bpmn:incoming>
<bpmn:outgoing>am_flow19</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="am_gc" name="Released?">
<bpmn:incoming>am_flow19</bpmn:incoming>
<bpmn:outgoing>am_flow20</bpmn:outgoing>
<bpmn:outgoing>am_flow21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="am_es" name="Change stopped; sanctions team directs">
<bpmn:incoming>am_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="am_gm2" name="">
<bpmn:incoming>am_flow21</bpmn:incoming>
<bpmn:incoming>am_flow22</bpmn:incoming>
<bpmn:outgoing>am_flow23</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="am_g4" name="Due diligence affected?">
<bpmn:incoming>am_flow23</bpmn:incoming>
<bpmn:outgoing>am_flow24</bpmn:outgoing>
<bpmn:outgoing>am_flow25</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="am_cadd" name="Re-run due diligence: CIP on new parties" calledElement="ao_process">
<bpmn:incoming>am_flow24</bpmn:incoming>
<bpmn:outgoing>am_flow26</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="am_gm3" name="">
<bpmn:incoming>am_flow25</bpmn:incoming>
<bpmn:incoming>am_flow26</bpmn:incoming>
<bpmn:outgoing>am_flow27</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="am_t7" name="Apply change with audit trail; new bank links stay inactive until verified">
<bpmn:incoming>am_flow27</bpmn:incoming>
<bpmn:outgoing>am_flow28</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="am_t8" name="Send confirmation notices: client at old and new address, and the RIA">
<bpmn:incoming>am_flow28</bpmn:incoming>
<bpmn:outgoing>am_flow29</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="am_t9" name="Refresh the rolling-review profile">
<bpmn:incoming>am_flow29</bpmn:incoming>
<bpmn:outgoing>am_flow30</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="am_e" name="Change complete">
<bpmn:incoming>am_flow30</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="am_flow0" name="" sourceRef="am_s" targetRef="am_t0" />
<bpmn:sequenceFlow id="am_flow1" name="" sourceRef="am_t0" targetRef="am_g0" />
<bpmn:sequenceFlow id="am_flow2" name="No" sourceRef="am_g0" targetRef="am_e0" />
<bpmn:sequenceFlow id="am_flow3" name="Yes" sourceRef="am_g0" targetRef="am_t1" />
<bpmn:sequenceFlow id="am_flow4" name="" sourceRef="am_t1" targetRef="am_t2" />
<bpmn:sequenceFlow id="am_flow5" name="" sourceRef="am_t2" targetRef="am_g1" />
<bpmn:sequenceFlow id="am_flow6" name="No" sourceRef="am_g1" targetRef="am_t3" />
<bpmn:sequenceFlow id="am_flow7" name="" sourceRef="am_t3" targetRef="am_ie" />
<bpmn:sequenceFlow id="am_flow8" name="Re-extract" sourceRef="am_ie" targetRef="am_t1" />
<bpmn:sequenceFlow id="am_flow9" name="Yes" sourceRef="am_g1" targetRef="am_t4" />
<bpmn:sequenceFlow id="am_flow10" name="" sourceRef="am_t4" targetRef="am_g2" />
<bpmn:sequenceFlow id="am_flow11" name="Yes" sourceRef="am_g2" targetRef="am_t5" />
<bpmn:sequenceFlow id="am_flow12" name="" sourceRef="am_t5" targetRef="am_g2b" />
<bpmn:sequenceFlow id="am_flow13" name="No" sourceRef="am_g2b" targetRef="am_ef" />
<bpmn:sequenceFlow id="am_flow14" name="Yes" sourceRef="am_g2b" targetRef="am_gm1" />
<bpmn:sequenceFlow id="am_flow15" name="No" sourceRef="am_g2" targetRef="am_gm1" />
<bpmn:sequenceFlow id="am_flow16" name="" sourceRef="am_gm1" targetRef="am_t6" />
<bpmn:sequenceFlow id="am_flow17" name="" sourceRef="am_t6" targetRef="am_g3" />
<bpmn:sequenceFlow id="am_flow18" name="Yes" sourceRef="am_g3" targetRef="am_casx" />
<bpmn:sequenceFlow id="am_flow19" name="" sourceRef="am_casx" targetRef="am_gc" />
<bpmn:sequenceFlow id="am_flow20" name="No" sourceRef="am_gc" targetRef="am_es" />
<bpmn:sequenceFlow id="am_flow21" name="Yes" sourceRef="am_gc" targetRef="am_gm2" />
<bpmn:sequenceFlow id="am_flow22" name="No" sourceRef="am_g3" targetRef="am_gm2" />
<bpmn:sequenceFlow id="am_flow23" name="" sourceRef="am_gm2" targetRef="am_g4" />
<bpmn:sequenceFlow id="am_flow24" name="Yes" sourceRef="am_g4" targetRef="am_cadd" />
<bpmn:sequenceFlow id="am_flow25" name="No" sourceRef="am_g4" targetRef="am_gm3" />
<bpmn:sequenceFlow id="am_flow26" name="" sourceRef="am_cadd" targetRef="am_gm3" />
<bpmn:sequenceFlow id="am_flow27" name="" sourceRef="am_gm3" targetRef="am_t7" />
<bpmn:sequenceFlow id="am_flow28" name="" sourceRef="am_t7" targetRef="am_t8" />
<bpmn:sequenceFlow id="am_flow29" name="" sourceRef="am_t8" targetRef="am_t9" />
<bpmn:sequenceFlow id="am_flow30" name="" sourceRef="am_t9" targetRef="am_e" />
</bpmn:process>
