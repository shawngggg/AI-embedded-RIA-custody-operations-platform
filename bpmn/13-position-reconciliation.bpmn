<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="pr_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="pr_collab">
<bpmn:participant id="pr_main" name="Custody operations platform (synthetic reference implementation)" processRef="pr_process" />
<bpmn:participant id="pr_ext" name="Depository, transfer agents, fund administrators" />
<bpmn:messageFlow id="pr_msg0" name="Position files" sourceRef="pr_ext" targetRef="pr_t1" />
<bpmn:textAnnotation id="pr_ann0"><bpmn:text>Stale in-transit items from the transfers module show up here as expected breaks. Quarterly counts follow Rule 17a-13; short differences unresolved after 7 business days draw net capital charges.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="pr_ann0_assoc" sourceRef="pr_t2" targetRef="pr_ann0" />
</bpmn:collaboration>
<bpmn:process id="pr_process" name="Position reconciliation" isExecutable="false">
<bpmn:laneSet id="pr_laneset">
<bpmn:lane id="pr_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>pr_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_esc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_ee</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_bt</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pr_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>pr_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pr_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>pr_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_g2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pr_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>pr_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pr_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="pr_s" name="Daily, after the settlement cycle">
<bpmn:outgoing>pr_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="pr_s_def" />
</bpmn:startEvent>
<bpmn:receiveTask id="pr_t1" name="Receive external position files">
<bpmn:incoming>pr_flow0</bpmn:incoming>
<bpmn:outgoing>pr_flow1</bpmn:outgoing>
</bpmn:receiveTask>
<bpmn:serviceTask id="pr_t2" name="Assemble positions: client, RIA master, GL, external">
<bpmn:incoming>pr_flow1</bpmn:incoming>
<bpmn:outgoing>pr_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="pr_t3" name="Match client, RIA master, GL, and external (quantity and value tolerances)">
<bpmn:incoming>pr_flow2</bpmn:incoming>
<bpmn:incoming>pr_flow15</bpmn:incoming>
<bpmn:outgoing>pr_flow3</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="pr_g1" name="Breaks found?">
<bpmn:incoming>pr_flow3</bpmn:incoming>
<bpmn:outgoing>pr_flow4</bpmn:outgoing>
<bpmn:outgoing>pr_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="pr_t4" name="Classify breaks and cluster by root cause (AI)">
<bpmn:incoming>pr_flow4</bpmn:incoming>
<bpmn:outgoing>pr_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="pr_t5" name="Route by break type and value">
<bpmn:incoming>pr_flow5</bpmn:incoming>
<bpmn:outgoing>pr_flow6</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="pr_g2" name="Route?">
<bpmn:incoming>pr_flow6</bpmn:incoming>
<bpmn:outgoing>pr_flow7</bpmn:outgoing>
<bpmn:outgoing>pr_flow8</bpmn:outgoing>
<bpmn:outgoing>pr_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="pr_t6" name="Draft resolution with evidence (AI)">
<bpmn:incoming>pr_flow7</bpmn:incoming>
<bpmn:outgoing>pr_flow10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="pr_t7" name="Approve or edit resolution">
<bpmn:incoming>pr_flow10</bpmn:incoming>
<bpmn:outgoing>pr_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="pr_t8" name="Investigate break">
<bpmn:incoming>pr_flow8</bpmn:incoming>
<bpmn:outgoing>pr_flow12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="pr_t9" name="Post correcting entries (balanced)">
<bpmn:incoming>pr_flow9</bpmn:incoming>
<bpmn:incoming>pr_flow11</bpmn:incoming>
<bpmn:incoming>pr_flow12</bpmn:incoming>
<bpmn:outgoing>pr_flow15</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="pr_esc" name="Escalate to a supervisor by age and dollar value">
<bpmn:incoming>pr_flow13</bpmn:incoming>
<bpmn:outgoing>pr_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="pr_ee" name="Supervisor notified">
<bpmn:incoming>pr_flow14</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="pr_t10" name="Certify books; publish suspense aging to transfers">
<bpmn:incoming>pr_flow16</bpmn:incoming>
<bpmn:outgoing>pr_flow17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="pr_e" name="Books proven">
<bpmn:incoming>pr_flow17</bpmn:incoming>
</bpmn:endEvent>
<bpmn:boundaryEvent id="pr_bt" name="Break past its age or dollar threshold" attachedToRef="pr_t8" cancelActivity="false">
<bpmn:outgoing>pr_flow13</bpmn:outgoing>
<bpmn:timerEventDefinition id="pr_bt_def" />
</bpmn:boundaryEvent>
<bpmn:sequenceFlow id="pr_flow0" name="" sourceRef="pr_s" targetRef="pr_t1" />
<bpmn:sequenceFlow id="pr_flow1" name="" sourceRef="pr_t1" targetRef="pr_t2" />
<bpmn:sequenceFlow id="pr_flow2" name="" sourceRef="pr_t2" targetRef="pr_t3" />
<bpmn:sequenceFlow id="pr_flow3" name="" sourceRef="pr_t3" targetRef="pr_g1" />
<bpmn:sequenceFlow id="pr_flow4" name="Yes" sourceRef="pr_g1" targetRef="pr_t4" />
<bpmn:sequenceFlow id="pr_flow5" name="" sourceRef="pr_t4" targetRef="pr_t5" />
<bpmn:sequenceFlow id="pr_flow6" name="" sourceRef="pr_t5" targetRef="pr_g2" />
<bpmn:sequenceFlow id="pr_flow7" name="AI-suggest" sourceRef="pr_g2" targetRef="pr_t6" />
<bpmn:sequenceFlow id="pr_flow8" name="Human-only" sourceRef="pr_g2" targetRef="pr_t8" />
<bpmn:sequenceFlow id="pr_flow9" name="Auto-fix" sourceRef="pr_g2" targetRef="pr_t9" />
<bpmn:sequenceFlow id="pr_flow10" name="" sourceRef="pr_t6" targetRef="pr_t7" />
<bpmn:sequenceFlow id="pr_flow11" name="" sourceRef="pr_t7" targetRef="pr_t9" />
<bpmn:sequenceFlow id="pr_flow12" name="" sourceRef="pr_t8" targetRef="pr_t9" />
<bpmn:sequenceFlow id="pr_flow13" name="" sourceRef="pr_bt" targetRef="pr_esc" />
<bpmn:sequenceFlow id="pr_flow14" name="" sourceRef="pr_esc" targetRef="pr_ee" />
<bpmn:sequenceFlow id="pr_flow15" name="Re-run match" sourceRef="pr_t9" targetRef="pr_t3" />
<bpmn:sequenceFlow id="pr_flow16" name="No" sourceRef="pr_g1" targetRef="pr_t10" />
<bpmn:sequenceFlow id="pr_flow17" name="" sourceRef="pr_t10" targetRef="pr_e" />
</bpmn:process>
<bpmndi:BPMNDiagram id="pr_diagram" name="Position reconciliation">
<bpmndi:BPMNPlane id="pr_plane" bpmnElement="pr_collab">
