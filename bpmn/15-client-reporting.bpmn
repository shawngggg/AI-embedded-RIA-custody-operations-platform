<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="cr_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="cr_collab">
<bpmn:participant id="cr_main" name="Custody operations platform (synthetic reference implementation)" processRef="cr_process" />
<bpmn:participant id="cr_cli" name="End client" />
<bpmn:participant id="cr_adv" name="RIA advisor" />
<bpmn:messageFlow id="cr_msg0" name="Account statements" sourceRef="cr_t8" targetRef="cr_cli" />
<bpmn:messageFlow id="cr_msg1" name="Advisor reports" sourceRef="cr_t9" targetRef="cr_adv" />
<bpmn:textAnnotation id="cr_ann0"><bpmn:text>Under the SEC custody rule, the qualified custodian sends account statements directly to clients at least quarterly.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="cr_ann0_assoc" sourceRef="cr_t8" targetRef="cr_ann0" />
</bpmn:collaboration>
<bpmn:process id="cr_process" name="Client reporting (monthly and quarterly)" isExecutable="false">
<bpmn:laneSet id="cr_laneset">
<bpmn:lane id="cr_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>cr_t7</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>cr_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>cr_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>cr_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="cr_s" name="Month end or quarter end">
<bpmn:outgoing>cr_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="cr_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="cr_t1" name="Confirm period closed: reconciliation certified, fees posted">
<bpmn:incoming>cr_flow0</bpmn:incoming>
<bpmn:outgoing>cr_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="cr_t2" name="Assemble statement data: holdings, activity, pending transfers, fees">
<bpmn:incoming>cr_flow1</bpmn:incoming>
<bpmn:outgoing>cr_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cr_g1" name="Quarter end?">
<bpmn:incoming>cr_flow2</bpmn:incoming>
<bpmn:outgoing>cr_flow3</bpmn:outgoing>
<bpmn:outgoing>cr_flow4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cr_t3" name="Calculate time-weighted performance and allocation">
<bpmn:incoming>cr_flow3</bpmn:incoming>
<bpmn:outgoing>cr_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cr_g2" name="">
<bpmn:incoming>cr_flow4</bpmn:incoming>
<bpmn:incoming>cr_flow5</bpmn:incoming>
<bpmn:outgoing>cr_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cr_t4" name="Draft commentary from computed figures only (AI)">
<bpmn:incoming>cr_flow6</bpmn:incoming>
<bpmn:outgoing>cr_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="cr_t5" name="Grounding check: every number traces to the ledger">
<bpmn:incoming>cr_flow7</bpmn:incoming>
<bpmn:incoming>cr_flow10</bpmn:incoming>
<bpmn:outgoing>cr_flow8</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="cr_g3" name="All figures trace?">
<bpmn:incoming>cr_flow8</bpmn:incoming>
<bpmn:outgoing>cr_flow9</bpmn:outgoing>
<bpmn:outgoing>cr_flow11</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cr_t6" name="Regenerate with untraceable figures removed (AI)">
<bpmn:incoming>cr_flow9</bpmn:incoming>
<bpmn:outgoing>cr_flow10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="cr_t7" name="Review and approve statements: samples and exceptions">
<bpmn:incoming>cr_flow11</bpmn:incoming>
<bpmn:outgoing>cr_flow12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sendTask id="cr_t8" name="Deliver statements directly to clients">
<bpmn:incoming>cr_flow12</bpmn:incoming>
<bpmn:outgoing>cr_flow13</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="cr_t9" name="Deliver reports to advisor">
<bpmn:incoming>cr_flow13</bpmn:incoming>
<bpmn:outgoing>cr_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="cr_e" name="Reporting cycle complete">
<bpmn:incoming>cr_flow14</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="cr_flow0" name="" sourceRef="cr_s" targetRef="cr_t1" />
<bpmn:sequenceFlow id="cr_flow1" name="" sourceRef="cr_t1" targetRef="cr_t2" />
<bpmn:sequenceFlow id="cr_flow2" name="" sourceRef="cr_t2" targetRef="cr_g1" />
<bpmn:sequenceFlow id="cr_flow3" name="Yes" sourceRef="cr_g1" targetRef="cr_t3" />
<bpmn:sequenceFlow id="cr_flow4" name="No" sourceRef="cr_g1" targetRef="cr_g2" />
<bpmn:sequenceFlow id="cr_flow5" name="" sourceRef="cr_t3" targetRef="cr_g2" />
<bpmn:sequenceFlow id="cr_flow6" name="" sourceRef="cr_g2" targetRef="cr_t4" />
<bpmn:sequenceFlow id="cr_flow7" name="" sourceRef="cr_t4" targetRef="cr_t5" />
<bpmn:sequenceFlow id="cr_flow8" name="" sourceRef="cr_t5" targetRef="cr_g3" />
<bpmn:sequenceFlow id="cr_flow9" name="No" sourceRef="cr_g3" targetRef="cr_t6" />
<bpmn:sequenceFlow id="cr_flow10" name="Re-check" sourceRef="cr_t6" targetRef="cr_t5" />
<bpmn:sequenceFlow id="cr_flow11" name="Yes" sourceRef="cr_g3" targetRef="cr_t7" />
<bpmn:sequenceFlow id="cr_flow12" name="" sourceRef="cr_t7" targetRef="cr_t8" />
<bpmn:sequenceFlow id="cr_flow13" name="" sourceRef="cr_t8" targetRef="cr_t9" />
<bpmn:sequenceFlow id="cr_flow14" name="" sourceRef="cr_t9" targetRef="cr_e" />
</bpmn:process>
