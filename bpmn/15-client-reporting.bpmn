<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="cr_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="cr_collab">
<bpmn:participant id="cr_main" name="Custody operations platform (synthetic reference implementation)" processRef="cr_process" />
<bpmn:participant id="cr_ext" name="Clients (statements) and RIA advisors (duplicates and data feeds)" />
<bpmn:messageFlow id="cr_msg0" name="Paper statements" sourceRef="cr_t9" targetRef="cr_ext" />
<bpmn:messageFlow id="cr_msg1" name="Duplicates" sourceRef="cr_t10" targetRef="cr_ext" />
<bpmn:messageFlow id="cr_msg2" name="Error report" sourceRef="cr_ext" targetRef="cr_cs" />
<bpmn:messageFlow id="cr_msg3" name="Daily data files" sourceRef="cr_dt2" targetRef="cr_ext" />
<bpmn:textAnnotation id="cr_ann0"><bpmn:text>FINRA Rule 2231 requires statements at least quarterly; monthly statements when there's activity are common practice. Under the custody rule, the qualified custodian sends statements directly to clients at least quarterly.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="cr_ann1"><bpmn:text>AI-drafted commentary is a client communication: FINRA's content standards and supervision apply (Regulatory Notice 24-09).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="cr_ann2"><bpmn:text>Feeds to RIA portfolio vendors fall under Reg S-P's service-provider and incident-notice rules.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="cr_process" name="Client reporting" isExecutable="false">
<bpmn:laneSet id="cr_laneset">
<bpmn:lane id="cr_lane_ops" name="Custody operations (reporting)">
<bpmn:flowNodeRef>cr_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_cs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_ct1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>cr_t5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>cr_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_ds</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="cr_lane_ledger" name="Ledger and statement services">
<bpmn:flowNodeRef>cr_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_e</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_ct2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_ct3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_ce</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_dt1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_dt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>cr_de</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="cr_s" name="Month end">
<bpmn:outgoing>cr_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="cr_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="cr_t1" name="Select accounts: any activity this month, plus every account at quarter end">
<bpmn:incoming>cr_flow0</bpmn:incoming>
<bpmn:outgoing>cr_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:businessRuleTask id="cr_t2" name="Confirm the period is closed: reconciliation certified, fees posted">
<bpmn:incoming>cr_flow1</bpmn:incoming>
<bpmn:outgoing>cr_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="cr_t3" name="Assemble statement data: holdings, activity, fees, estimated values for DPPs and REITs">
<bpmn:incoming>cr_flow2</bpmn:incoming>
<bpmn:outgoing>cr_flow3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="cr_g1" name="Quarter end?">
<bpmn:incoming>cr_flow3</bpmn:incoming>
<bpmn:outgoing>cr_flow4</bpmn:outgoing>
<bpmn:outgoing>cr_flow5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="cr_t4" name="Calculate time-weighted performance and allocation">
<bpmn:incoming>cr_flow4</bpmn:incoming>
<bpmn:outgoing>cr_flow6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="cr_t5" name="Draft commentary from computed figures only (AI)">
<bpmn:incoming>cr_flow6</bpmn:incoming>
<bpmn:outgoing>cr_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="cr_t6" name="Grounding check: every number traces to the ledger">
<bpmn:incoming>cr_flow7</bpmn:incoming>
<bpmn:outgoing>cr_flow8</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="cr_gm" name="">
<bpmn:incoming>cr_flow5</bpmn:incoming>
<bpmn:incoming>cr_flow8</bpmn:incoming>
<bpmn:outgoing>cr_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="cr_t7" name="Statement checks: samples and exceptions">
<bpmn:incoming>cr_flow9</bpmn:incoming>
<bpmn:outgoing>cr_flow10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="cr_g2" name="Delivery?">
<bpmn:incoming>cr_flow10</bpmn:incoming>
<bpmn:outgoing>cr_flow11</bpmn:outgoing>
<bpmn:outgoing>cr_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="cr_t9" name="Print and mail statements (print vendor)">
<bpmn:incoming>cr_flow11</bpmn:incoming>
<bpmn:outgoing>cr_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="cr_t8" name="Post statements online and notify clients">
<bpmn:incoming>cr_flow12</bpmn:incoming>
<bpmn:outgoing>cr_flow13</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="cr_t10" name="Send duplicate statements to the RIA">
<bpmn:incoming>cr_flow13</bpmn:incoming>
<bpmn:incoming>cr_flow14</bpmn:incoming>
<bpmn:outgoing>cr_flow15</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="cr_e" name="Statements delivered">
<bpmn:incoming>cr_flow15</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="cr_cs" name="Statement error found (client, RIA, or internal)">
<bpmn:outgoing>cr_flow16</bpmn:outgoing>
<bpmn:messageEventDefinition id="cr_cs_def" />
</bpmn:startEvent>
<bpmn:userTask id="cr_ct1" name="Find the cause; fix the source data in the ledger">
<bpmn:incoming>cr_flow16</bpmn:incoming>
<bpmn:outgoing>cr_flow17</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="cr_ct2" name="Regenerate the statement marked as corrected">
<bpmn:incoming>cr_flow17</bpmn:incoming>
<bpmn:outgoing>cr_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="cr_ct3" name="Send the corrected statement to the client and the RIA">
<bpmn:incoming>cr_flow18</bpmn:incoming>
<bpmn:outgoing>cr_flow19</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="cr_ce" name="Correction delivered">
<bpmn:incoming>cr_flow19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="cr_ds" name="Each business day">
<bpmn:outgoing>cr_flow20</bpmn:outgoing>
<bpmn:timerEventDefinition id="cr_ds_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="cr_dt1" name="Build position, transaction, and cost files per RIA">
<bpmn:incoming>cr_flow20</bpmn:incoming>
<bpmn:outgoing>cr_flow21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="cr_dt2" name="Send files to RIA portfolio systems; stop feeds when an RIA relationship ends">
<bpmn:incoming>cr_flow21</bpmn:incoming>
<bpmn:outgoing>cr_flow22</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="cr_de" name="Feeds delivered">
<bpmn:incoming>cr_flow22</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="cr_flow0" name="" sourceRef="cr_s" targetRef="cr_t1" />
<bpmn:sequenceFlow id="cr_flow1" name="" sourceRef="cr_t1" targetRef="cr_t2" />
<bpmn:sequenceFlow id="cr_flow2" name="" sourceRef="cr_t2" targetRef="cr_t3" />
<bpmn:sequenceFlow id="cr_flow3" name="" sourceRef="cr_t3" targetRef="cr_g1" />
<bpmn:sequenceFlow id="cr_flow4" name="Yes" sourceRef="cr_g1" targetRef="cr_t4" />
<bpmn:sequenceFlow id="cr_flow5" name="No" sourceRef="cr_g1" targetRef="cr_gm" />
<bpmn:sequenceFlow id="cr_flow6" name="" sourceRef="cr_t4" targetRef="cr_t5" />
<bpmn:sequenceFlow id="cr_flow7" name="" sourceRef="cr_t5" targetRef="cr_t6" />
<bpmn:sequenceFlow id="cr_flow8" name="" sourceRef="cr_t6" targetRef="cr_gm" />
<bpmn:sequenceFlow id="cr_flow9" name="" sourceRef="cr_gm" targetRef="cr_t7" />
<bpmn:sequenceFlow id="cr_flow10" name="" sourceRef="cr_t7" targetRef="cr_g2" />
<bpmn:sequenceFlow id="cr_flow11" name="Paper" sourceRef="cr_g2" targetRef="cr_t9" />
<bpmn:sequenceFlow id="cr_flow12" name="E-delivery (consent on file)" sourceRef="cr_g2" targetRef="cr_t8" />
<bpmn:sequenceFlow id="cr_flow13" name="" sourceRef="cr_t8" targetRef="cr_t10" />
<bpmn:sequenceFlow id="cr_flow14" name="" sourceRef="cr_t9" targetRef="cr_t10" />
<bpmn:sequenceFlow id="cr_flow15" name="" sourceRef="cr_t10" targetRef="cr_e" />
<bpmn:sequenceFlow id="cr_flow16" name="" sourceRef="cr_cs" targetRef="cr_ct1" />
<bpmn:sequenceFlow id="cr_flow17" name="" sourceRef="cr_ct1" targetRef="cr_ct2" />
<bpmn:sequenceFlow id="cr_flow18" name="" sourceRef="cr_ct2" targetRef="cr_ct3" />
<bpmn:sequenceFlow id="cr_flow19" name="" sourceRef="cr_ct3" targetRef="cr_ce" />
<bpmn:sequenceFlow id="cr_flow20" name="" sourceRef="cr_ds" targetRef="cr_dt1" />
<bpmn:sequenceFlow id="cr_flow21" name="" sourceRef="cr_dt1" targetRef="cr_dt2" />
<bpmn:sequenceFlow id="cr_flow22" name="" sourceRef="cr_dt2" targetRef="cr_de" />
</bpmn:process>
