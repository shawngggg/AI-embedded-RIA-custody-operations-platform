<bpmn:flowNodeRef>ao_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_t5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ao_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ao_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_a1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_b1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_b2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_b3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_gm2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_gm3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ao_lane_comp" name="AML compliance (second line)">
<bpmn:flowNodeRef>ao_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_g5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_ed</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ao_lane_principal" name="RIA service team (FINRA-licensed principal)">
<bpmn:flowNodeRef>ao_r7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_ep</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_gp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_p1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ao_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>ao_r5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_r2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ao_t10</bpmn:flowNodeRef>
