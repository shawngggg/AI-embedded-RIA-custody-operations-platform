<bpmndi:BPMNDiagram id="ao_diagram" name="Client account opening (paths A and B)">
<bpmndi:BPMNPlane id="ao_plane" bpmnElement="ao_collab">
<bpmndi:BPMNShape id="ao_main_di" bpmnElement="ao_main" isHorizontal="true"><dc:Bounds x="0" y="124" width="7100" height="1100" /></bpmndi:BPMNShape>
