</bpmn:laneSet>
<bpmn:startEvent id="ao_s" name="Account application received">
<bpmn:outgoing>ao_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ao_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ao_t1" name="Gate: RIA active; a self-directed account needs an active RIA-managed account, one per client">
<bpmn:incoming>ao_flow0</bpmn:incoming>
<bpmn:outgoing>ao_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ao_g0" name="Eligible?">
<bpmn:incoming>ao_flow1</bpmn:incoming>
<bpmn:outgoing>ao_flow2</bpmn:outgoing>
<bpmn:outgoing>ao_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ao_e0" name="Application returned">
<bpmn:incoming>ao_flow2</bpmn:incoming>
<bpmn:messageEventDefinition id="ao_e0_def" />
</bpmn:endEvent>
<bpmn:serviceTask id="ao_t2" name="Extract application, title, LPOA, tax forms, entity documents; categorize NIGO (AI)">
<bpmn:incoming>ao_flow3</bpmn:incoming>
<bpmn:incoming>ao_flow7</bpmn:incoming>
<bpmn:outgoing>ao_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ao_g1" name="Regulatory items in good order?">
<bpmn:incoming>ao_flow4</bpmn:incoming>
<bpmn:outgoing>ao_flow5</bpmn:outgoing>
<bpmn:outgoing>ao_flow8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="ao_t3" name="Request corrections from the RIA">
<bpmn:incoming>ao_flow5</bpmn:incoming>
<bpmn:outgoing>ao_flow6</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="ao_ie" name="Corrections received">
<bpmn:incoming>ao_flow6</bpmn:incoming>
<bpmn:outgoing>ao_flow7</bpmn:outgoing>
<bpmn:messageEventDefinition id="ao_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="ao_g2" name="Path A applies?">
<bpmn:incoming>ao_flow8</bpmn:incoming>
<bpmn:outgoing>ao_flow9</bpmn:outgoing>
<bpmn:outgoing>ao_flow10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="ao_a1" name="Path A: rely on RIA for CIP and beneficial ownership; RIA-provided information only">
<bpmn:incoming>ao_flow9</bpmn:incoming>
<bpmn:outgoing>ao_flow13</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ao_b1" name="Path B: verify identity (documentary or non-documentary)">
<bpmn:incoming>ao_flow10</bpmn:incoming>
<bpmn:outgoing>ao_flow11</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="ao_b2" name="Path B: CDD on purpose, expected activity, beneficial owners of entities">
<bpmn:incoming>ao_flow11</bpmn:incoming>
<bpmn:outgoing>ao_flow12</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ao_b3" name="Path B: enroll in account-level AML monitoring and trading surveillance">
<bpmn:incoming>ao_flow12</bpmn:incoming>
<bpmn:outgoing>ao_flow14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ao_gm" name="">
<bpmn:incoming>ao_flow13</bpmn:incoming>
<bpmn:incoming>ao_flow14</bpmn:incoming>
<bpmn:outgoing>ao_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ao_t5" name="PEP and adverse media screening; summarize hits (AI)">
<bpmn:incoming>ao_flow15</bpmn:incoming>
<bpmn:outgoing>ao_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="ao_t6" name="First-line check against the sanctions flagged list">
<bpmn:incoming>ao_flow16</bpmn:incoming>
<bpmn:outgoing>ao_flow17</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ao_g3" name="Flagged?">
<bpmn:incoming>ao_flow17</bpmn:incoming>
<bpmn:outgoing>ao_flow18</bpmn:outgoing>
<bpmn:outgoing>ao_flow22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="ao_ca1" name="Sanctions escalation (shared subprocess)" calledElement="sx_process">
<bpmn:incoming>ao_flow18</bpmn:incoming>
<bpmn:outgoing>ao_flow19</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="ao_g3b" name="Cleared?">
<bpmn:incoming>ao_flow19</bpmn:incoming>
<bpmn:outgoing>ao_flow20</bpmn:outgoing>
<bpmn:outgoing>ao_flow21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ao_es" name="Not opened; sanctions team directs next steps">
<bpmn:incoming>ao_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="ao_gm2" name="">
<bpmn:incoming>ao_flow21</bpmn:incoming>
<bpmn:incoming>ao_flow22</bpmn:incoming>
<bpmn:outgoing>ao_flow23</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="ao_t7" name="Risk-rate the account (path A uses RIA-provided information only)">
<bpmn:incoming>ao_flow23</bpmn:incoming>
<bpmn:outgoing>ao_flow24</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ao_g4" name="Risk level?">
<bpmn:incoming>ao_flow24</bpmn:incoming>
<bpmn:outgoing>ao_flow25</bpmn:outgoing>
<bpmn:outgoing>ao_flow29</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ao_t8" name="EDD: source of funds and source of wealth; approve">
<bpmn:incoming>ao_flow25</bpmn:incoming>
<bpmn:outgoing>ao_flow26</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ao_g5" name="Approved?">
<bpmn:incoming>ao_flow26</bpmn:incoming>
<bpmn:outgoing>ao_flow27</bpmn:outgoing>
<bpmn:outgoing>ao_flow28</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ao_ed" name="Application declined">
<bpmn:incoming>ao_flow27</bpmn:incoming>
<bpmn:messageEventDefinition id="ao_ed_def" />
</bpmn:endEvent>
<bpmn:exclusiveGateway id="ao_gm3" name="">
<bpmn:incoming>ao_flow28</bpmn:incoming>
<bpmn:incoming>ao_flow29</bpmn:incoming>
<bpmn:outgoing>ao_flow30</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ao_t9" name="Create account under RIA master; map to GL; apply restriction codes, incl. DOCS">
<bpmn:incoming>ao_flow35</bpmn:incoming>
<bpmn:outgoing>ao_flow31</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ao_t10" name="Schedule rolling review by risk level">
<bpmn:incoming>ao_flow31</bpmn:incoming>
<bpmn:outgoing>ao_flow32</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:callActivity id="ao_ca2" name="Transferability review of funding assets (shared subprocess)" calledElement="xr_process">
<bpmn:incoming>ao_flow32</bpmn:incoming>
<bpmn:outgoing>ao_flow33</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="ao_e" name="Account open; funding handed to transfers">
<bpmn:incoming>ao_flow33</bpmn:incoming>
<bpmn:messageEventDefinition id="ao_e_def" />
</bpmn:endEvent>
<bpmn:userTask id="ao_p1" name="Principal accepts the account (FINRA Rule 4512)">
<bpmn:outgoing>ao_flow34</bpmn:outgoing>
<bpmn:incoming>ao_flow30</bpmn:incoming>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ao_gp" name="Accepted?">
<bpmn:outgoing>ao_flow36</bpmn:outgoing>
<bpmn:outgoing>ao_flow35</bpmn:outgoing>
<bpmn:incoming>ao_flow34</bpmn:incoming>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ao_ep" name="Declined by the principal">
<bpmn:incoming>ao_flow36</bpmn:incoming>
<bpmn:messageEventDefinition id="ao_ep_def" />
</bpmn:endEvent>
<bpmn:startEvent id="ao_r0" name="Principal asks to rescind: accepted before review, or a regulatory issue found">
<bpmn:outgoing>ao_flow37</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="ao_r0_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></bpmn:conditionalEventDefinition>
</bpmn:startEvent>
<bpmn:userTask id="ao_r1" name="Request the rescission with a written reason">
<bpmn:outgoing>ao_flow38</bpmn:outgoing>
<bpmn:incoming>ao_flow37</bpmn:incoming>
</bpmn:userTask>
<bpmn:serviceTask id="ao_r2" name="Restrict the account at once (RSCN): no activity">
<bpmn:outgoing>ao_flow39</bpmn:outgoing>
<bpmn:incoming>ao_flow38</bpmn:incoming>
</bpmn:serviceTask>
<bpmn:userTask id="ao_r3" name="Team lead approves or rejects; never the requester">
<bpmn:outgoing>ao_flow40</bpmn:outgoing>
<bpmn:incoming>ao_flow39</bpmn:incoming>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ao_r4" name="Approved?">
<bpmn:outgoing>ao_flow42</bpmn:outgoing>
<bpmn:outgoing>ao_flow41</bpmn:outgoing>
<bpmn:incoming>ao_flow40</bpmn:incoming>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="ao_r9" name="Rejected: RSCN lifted; the acceptance stands">
<bpmn:incoming>ao_flow41</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="ao_r5" name="Withdraw acceptance; account to pending; log an operational risk event">
<bpmn:outgoing>ao_flow43</bpmn:outgoing>
<bpmn:incoming>ao_flow42</bpmn:incoming>
</bpmn:serviceTask>
<bpmn:userTask id="ao_r6" name="Lead records the remediation: training, technology, or procedure">
<bpmn:outgoing>ao_flow44</bpmn:outgoing>
<bpmn:incoming>ao_flow43</bpmn:incoming>
</bpmn:userTask>
<bpmn:endEvent id="ao_r7" name="Back to the principal or operations for rework">
<bpmn:incoming>ao_flow44</bpmn:incoming>
</bpmn:endEvent>
