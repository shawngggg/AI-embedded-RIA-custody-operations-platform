<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="av_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="av_collab">
<bpmn:participant id="av_main" name="Custody operations platform (synthetic reference implementation)" processRef="av_process" />
<bpmn:participant id="av_ria" name="RIAs (old, new, or acquiring) and their clients" />
<bpmn:messageFlow id="av_msg0" name="Signed LPOA" sourceRef="av_ria" targetRef="av_as" />
<bpmn:messageFlow id="av_msg1" name="Notices" sourceRef="av_at6" targetRef="av_ria" />
<bpmn:messageFlow id="av_msg2" name="Deal notice" sourceRef="av_ria" targetRef="av_ms" />
<bpmn:messageFlow id="av_msg3" name="Consent requests" sourceRef="av_mt4" targetRef="av_ria" />
<bpmn:messageFlow id="av_msg4" name="Signed LPOAs or objections" sourceRef="av_ria" targetRef="av_mt4" />
<bpmn:textAnnotation id="av_ann0"><bpmn:text>The custodian doesn't decide which RIA keeps a client; the client's signed instruction does. An LPOA isn't transferable, so a new RIA needs a new client-signed LPOA, and the old RIA can't block the move.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="av_ann1"><bpmn:text>If an RIA's principal dies or is incapacitated, the custodian acts for a successor only after reviewing the succession agreement on file; without one, trading and fee deduction pause.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="av_ann2"><bpmn:text>Advisers Act §205(a)(2): no assignment of an advisory contract without client consent, and a change of control is an assignment. Negative consent is common practice but not codified; some states and ERISA plans need affirmative consent.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="av_ann3"><bpmn:text>Rebrands and reorganizations without a change of control keep the same SEC registration, so LPOAs stay valid.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="av_process" name="Advisor moves and RIA mergers" isExecutable="false">
<bpmn:laneSet id="av_laneset">
<bpmn:lane id="av_lane_ops" name="Custody operations">
<bpmn:flowNodeRef>av_as</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_at6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_ae</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mca1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mt4</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="av_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>av_at1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mt1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="av_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>av_at2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_ag1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mg2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="av_lane_comp" name="Compliance and legal">
<bpmn:flowNodeRef>av_at3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_ms</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mca2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_me3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="av_lane_ledger" name="Ledger, billing, and account services">
<bpmn:flowNodeRef>av_at4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_at5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_me1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_mt5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>av_me2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="av_as" name="Client-signed LPOA naming a new RIA">
<bpmn:outgoing>av_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="av_as_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="av_at1" name="Check the LPOA and signatures; categorize NIGO (AI)">
<bpmn:incoming>av_flow0</bpmn:incoming>
<bpmn:outgoing>av_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="av_at2" name="Check the new RIA is onboarded and the advisor is registered with it">
<bpmn:incoming>av_flow1</bpmn:incoming>
<bpmn:outgoing>av_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="av_ag1" name="Dispute or court order on file?">
<bpmn:incoming>av_flow2</bpmn:incoming>
<bpmn:outgoing>av_flow3</bpmn:outgoing>
<bpmn:outgoing>av_flow4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="av_at3" name="Hold; follow the client's signed instruction or the court order">
<bpmn:incoming>av_flow3</bpmn:incoming>
<bpmn:outgoing>av_flow5</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="av_at4" name="Re-link to the new RIA's master and rep code; old LPOA revoked; no assets move">
<bpmn:incoming>av_flow4</bpmn:incoming>
<bpmn:incoming>av_flow5</bpmn:incoming>
<bpmn:outgoing>av_flow6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="av_at5" name="Fee cutover: old RIA bills through the effective date, new RIA from the re-link">
<bpmn:incoming>av_flow6</bpmn:incoming>
<bpmn:outgoing>av_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="av_at6" name="Notify the client, the old RIA, and the new RIA">
<bpmn:incoming>av_flow7</bpmn:incoming>
<bpmn:outgoing>av_flow8</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="av_ae" name="Account under the new RIA">
<bpmn:incoming>av_flow8</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="av_ms" name="Merger, acquisition, succession, or rebrand notice">
<bpmn:outgoing>av_flow9</bpmn:outgoing>
<bpmn:messageEventDefinition id="av_ms_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="av_mt1" name="Extract deal terms, Form ADV changes, and account lists (AI)">
<bpmn:incoming>av_flow9</bpmn:incoming>
<bpmn:outgoing>av_flow10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="av_mt2" name="Classify: change of control (needs consent) or a rebrand or reorganization">
<bpmn:incoming>av_flow10</bpmn:incoming>
<bpmn:outgoing>av_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="av_mg1" name="Assignment?">
<bpmn:incoming>av_flow11</bpmn:incoming>
<bpmn:outgoing>av_flow12</bpmn:outgoing>
<bpmn:outgoing>av_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="av_mt3" name="Update the firm's name and records; LPOAs and masters stay">
<bpmn:incoming>av_flow12</bpmn:incoming>
<bpmn:outgoing>av_flow13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="av_me1" name="Records updated">
<bpmn:incoming>av_flow13</bpmn:incoming>
</bpmn:endEvent>
<bpmn:callActivity id="av_mca1" name="RIA firm onboarding for the acquirer, if new" calledElement="rf_process">
<bpmn:incoming>av_flow14</bpmn:incoming>
<bpmn:outgoing>av_flow15</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:userTask id="av_mt4" name="Collect consent: new LPOAs or an approved negative-consent package">
<bpmn:incoming>av_flow15</bpmn:incoming>
<bpmn:outgoing>av_flow16</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="av_mg2" name="Consented, or no objection by the deadline?">
<bpmn:incoming>av_flow16</bpmn:incoming>
<bpmn:outgoing>av_flow17</bpmn:outgoing>
<bpmn:outgoing>av_flow19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="av_mca2" name="Client offboarding: the client picks another RIA or transfers out" calledElement="co_process">
<bpmn:incoming>av_flow17</bpmn:incoming>
<bpmn:outgoing>av_flow18</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="av_me3" name="Client moved or offboarded">
<bpmn:incoming>av_flow18</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="av_mt5" name="Re-link accounts to the acquirer's master; map rep codes; fee cutover">
<bpmn:incoming>av_flow19</bpmn:incoming>
<bpmn:outgoing>av_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="av_me2" name="Accounts under the acquirer">
<bpmn:incoming>av_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="av_flow0" name="" sourceRef="av_as" targetRef="av_at1" />
<bpmn:sequenceFlow id="av_flow1" name="" sourceRef="av_at1" targetRef="av_at2" />
<bpmn:sequenceFlow id="av_flow2" name="" sourceRef="av_at2" targetRef="av_ag1" />
<bpmn:sequenceFlow id="av_flow3" name="Yes" sourceRef="av_ag1" targetRef="av_at3" />
<bpmn:sequenceFlow id="av_flow4" name="No" sourceRef="av_ag1" targetRef="av_at4" />
<bpmn:sequenceFlow id="av_flow5" name="" sourceRef="av_at3" targetRef="av_at4" />
<bpmn:sequenceFlow id="av_flow6" name="" sourceRef="av_at4" targetRef="av_at5" />
<bpmn:sequenceFlow id="av_flow7" name="" sourceRef="av_at5" targetRef="av_at6" />
<bpmn:sequenceFlow id="av_flow8" name="" sourceRef="av_at6" targetRef="av_ae" />
<bpmn:sequenceFlow id="av_flow9" name="" sourceRef="av_ms" targetRef="av_mt1" />
<bpmn:sequenceFlow id="av_flow10" name="" sourceRef="av_mt1" targetRef="av_mt2" />
<bpmn:sequenceFlow id="av_flow11" name="" sourceRef="av_mt2" targetRef="av_mg1" />
<bpmn:sequenceFlow id="av_flow12" name="No" sourceRef="av_mg1" targetRef="av_mt3" />
<bpmn:sequenceFlow id="av_flow13" name="" sourceRef="av_mt3" targetRef="av_me1" />
<bpmn:sequenceFlow id="av_flow14" name="Yes" sourceRef="av_mg1" targetRef="av_mca1" />
<bpmn:sequenceFlow id="av_flow15" name="" sourceRef="av_mca1" targetRef="av_mt4" />
<bpmn:sequenceFlow id="av_flow16" name="" sourceRef="av_mt4" targetRef="av_mg2" />
<bpmn:sequenceFlow id="av_flow17" name="No" sourceRef="av_mg2" targetRef="av_mca2" />
<bpmn:sequenceFlow id="av_flow18" name="" sourceRef="av_mca2" targetRef="av_me3" />
<bpmn:sequenceFlow id="av_flow19" name="Yes" sourceRef="av_mg2" targetRef="av_mt5" />
<bpmn:sequenceFlow id="av_flow20" name="" sourceRef="av_mt5" targetRef="av_me2" />
</bpmn:process>
