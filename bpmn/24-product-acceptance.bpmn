<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="pa_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="pa_collab">
<bpmn:participant id="pa_main" name="Custody operations platform (synthetic reference implementation)" processRef="pa_process" />
<bpmn:participant id="pa_ria" name="RIA advisor" />
<bpmn:participant id="pa_ext" name="Fund sponsors, administrators, transfer agents, and DTCC (AIP, Fund/SERV, DTC)" />
<bpmn:messageFlow id="pa_msg0" name="Product request" sourceRef="pa_ria" targetRef="pa_s" />
<bpmn:messageFlow id="pa_msg1" name="Decline with reason" sourceRef="pa_t4" targetRef="pa_ria" />
<bpmn:messageFlow id="pa_msg2" name="Availability notice" sourceRef="pa_t7" targetRef="pa_ria" />
<bpmn:messageFlow id="pa_msg3" name="Agreement and connection" sourceRef="pa_t6" targetRef="pa_ext" />
<bpmn:messageFlow id="pa_msg4" name="Valuations (statements or AIP)" sourceRef="pa_ext" targetRef="pa_s2" />
<bpmn:messageFlow id="pa_msg5" name="Restriction notice" sourceRef="pa_t12" targetRef="pa_ria" />
<bpmn:textAnnotation id="pa_ann0"><bpmn:text>Acceptance means the custodian can hold, price, and service the product. Suitability stays with the RIA, and the sponsor checks investor qualification through its subscription documents.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="pa_ann1"><bpmn:text>Operations reviews each request and recommends; risk and compliance decide and own the acceptance policy.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="pa_ann2"><bpmn:text>DTCC AIP links custodians with fund administrators for subscriptions, capital calls, and NAV feeds; mutual funds settle through Fund/SERV and ETFs through DTC.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="pa_ann3"><bpmn:text>Illiquid products show the last reported value with its date; non-listed REITs and DPPs need per-share estimated values on statements (FINRA Rule 2231).</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="pa_process" name="Product acceptance" isExecutable="false">
<bpmn:laneSet id="pa_laneset">
<bpmn:lane id="pa_lane_ops" name="Custody operations (product acceptance)">
<bpmn:flowNodeRef>pa_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_e0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_e3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pa_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>pa_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_a1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pa_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>pa_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_f1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_a2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_s3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pa_lane_comp" name="Risk and compliance (decision)">
<bpmn:flowNodeRef>pa_c1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="pa_lane_ledger" name="Platform services (security master, pricing, ledger)">
<bpmn:flowNodeRef>pa_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>pa_e2</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="pa_s" name="Product request from an RIA">
<bpmn:outgoing>pa_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="pa_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="pa_t1" name="Extract offering documents: prospectus or PPM, subscription docs, financials (AI)">
<bpmn:incoming>pa_flow0</bpmn:incoming>
<bpmn:outgoing>pa_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="pa_t2" name="Classify the product; check whether it is already held">
<bpmn:incoming>pa_flow1</bpmn:incoming>
<bpmn:outgoing>pa_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="pa_g1" name="Product type?">
<bpmn:incoming>pa_flow2</bpmn:incoming>
<bpmn:outgoing>pa_flow3</bpmn:outgoing>
<bpmn:outgoing>pa_flow4</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="pa_f1" name="Check fund agreements (Fund/SERV, Rule 22c-2) and ETF DTC eligibility">
<bpmn:incoming>pa_flow3</bpmn:incoming>
<bpmn:outgoing>pa_flow6</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="pa_a1" name="Check the sponsor: background, audited financials, flagged list, adverse media (AI)">
<bpmn:incoming>pa_flow4</bpmn:incoming>
<bpmn:outgoing>pa_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="pa_a2" name="Check feasibility: nominee registration, administrator, AIP, valuation, capital calls">
<bpmn:incoming>pa_flow5</bpmn:incoming>
<bpmn:outgoing>pa_flow7</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="pa_gm" name="">
<bpmn:incoming>pa_flow6</bpmn:incoming>
<bpmn:incoming>pa_flow7</bpmn:incoming>
<bpmn:outgoing>pa_flow8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="pa_t3" name="Review: sponsor agreement, operational fit, sponsor background; recommend">
<bpmn:incoming>pa_flow8</bpmn:incoming>
<bpmn:outgoing>pa_flow9</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="pa_c1" name="Decide: accept or decline">
<bpmn:incoming>pa_flow9</bpmn:incoming>
<bpmn:outgoing>pa_flow10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="pa_g3" name="Accepted?">
<bpmn:incoming>pa_flow10</bpmn:incoming>
<bpmn:outgoing>pa_flow11</bpmn:outgoing>
<bpmn:outgoing>pa_flow13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="pa_t4" name="Decline with the reason; options: hold away or use an alternate custodian">
<bpmn:incoming>pa_flow11</bpmn:incoming>
<bpmn:outgoing>pa_flow12</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="pa_e0" name="Declined">
<bpmn:incoming>pa_flow12</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="pa_t5" name="Set up the security: security master, pricing and valuation source, settlement method">
<bpmn:incoming>pa_flow13</bpmn:incoming>
<bpmn:outgoing>pa_flow14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="pa_t6" name="Execute the custody or servicing agreement; connect AIP or Fund/SERV">
<bpmn:incoming>pa_flow14</bpmn:incoming>
<bpmn:outgoing>pa_flow15</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="pa_t7" name="Notify the RIA: product available, fees, subscription documents">
<bpmn:incoming>pa_flow15</bpmn:incoming>
<bpmn:outgoing>pa_flow16</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="pa_e1" name="Product available">
<bpmn:incoming>pa_flow16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="pa_s2" name="Valuation statement or NAV received">
<bpmn:outgoing>pa_flow17</bpmn:outgoing>
<bpmn:messageEventDefinition id="pa_s2_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="pa_t8" name="Check the valuation: date, change from prior, missing statements (AI)">
<bpmn:incoming>pa_flow17</bpmn:incoming>
<bpmn:outgoing>pa_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="pa_t9" name="Post the valuation to holding accounts with its as-of date">
<bpmn:incoming>pa_flow18</bpmn:incoming>
<bpmn:outgoing>pa_flow19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="pa_e2" name="Valuation posted">
<bpmn:incoming>pa_flow19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="pa_s3" name="Product out of policy: re-review, sponsor event, or fund instruction">
<bpmn:outgoing>pa_flow20</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="pa_s3_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></bpmn:conditionalEventDefinition>
</bpmn:startEvent>
<bpmn:userTask id="pa_t10" name="Decide: stop new purchases, hold away, or require transfer or liquidation">
<bpmn:incoming>pa_flow20</bpmn:incoming>
<bpmn:outgoing>pa_flow21</bpmn:outgoing>
</bpmn:userTask>
<bpmn:businessRuleTask id="pa_t11" name="Apply the product restriction: block new purchases; set any exit deadline">
<bpmn:incoming>pa_flow21</bpmn:incoming>
<bpmn:outgoing>pa_flow22</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:sendTask id="pa_t12" name="Notify affected RIAs of the restriction, options, and deadline">
<bpmn:incoming>pa_flow22</bpmn:incoming>
<bpmn:outgoing>pa_flow23</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="pa_e3" name="Restriction in place">
<bpmn:incoming>pa_flow23</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="pa_flow0" name="" sourceRef="pa_s" targetRef="pa_t1" />
<bpmn:sequenceFlow id="pa_flow1" name="" sourceRef="pa_t1" targetRef="pa_t2" />
<bpmn:sequenceFlow id="pa_flow2" name="" sourceRef="pa_t2" targetRef="pa_g1" />
<bpmn:sequenceFlow id="pa_flow3" name="Fund or ETF" sourceRef="pa_g1" targetRef="pa_f1" />
<bpmn:sequenceFlow id="pa_flow4" name="Alternative" sourceRef="pa_g1" targetRef="pa_a1" />
<bpmn:sequenceFlow id="pa_flow5" name="" sourceRef="pa_a1" targetRef="pa_a2" />
<bpmn:sequenceFlow id="pa_flow6" name="" sourceRef="pa_f1" targetRef="pa_gm" />
<bpmn:sequenceFlow id="pa_flow7" name="" sourceRef="pa_a2" targetRef="pa_gm" />
<bpmn:sequenceFlow id="pa_flow8" name="" sourceRef="pa_gm" targetRef="pa_t3" />
<bpmn:sequenceFlow id="pa_flow9" name="" sourceRef="pa_t3" targetRef="pa_c1" />
<bpmn:sequenceFlow id="pa_flow10" name="" sourceRef="pa_c1" targetRef="pa_g3" />
<bpmn:sequenceFlow id="pa_flow11" name="No" sourceRef="pa_g3" targetRef="pa_t4" />
<bpmn:sequenceFlow id="pa_flow12" name="" sourceRef="pa_t4" targetRef="pa_e0" />
<bpmn:sequenceFlow id="pa_flow13" name="Yes" sourceRef="pa_g3" targetRef="pa_t5" />
<bpmn:sequenceFlow id="pa_flow14" name="" sourceRef="pa_t5" targetRef="pa_t6" />
<bpmn:sequenceFlow id="pa_flow15" name="" sourceRef="pa_t6" targetRef="pa_t7" />
<bpmn:sequenceFlow id="pa_flow16" name="" sourceRef="pa_t7" targetRef="pa_e1" />
<bpmn:sequenceFlow id="pa_flow17" name="" sourceRef="pa_s2" targetRef="pa_t8" />
<bpmn:sequenceFlow id="pa_flow18" name="" sourceRef="pa_t8" targetRef="pa_t9" />
<bpmn:sequenceFlow id="pa_flow19" name="" sourceRef="pa_t9" targetRef="pa_e2" />
<bpmn:sequenceFlow id="pa_flow20" name="" sourceRef="pa_s3" targetRef="pa_t10" />
<bpmn:sequenceFlow id="pa_flow21" name="" sourceRef="pa_t10" targetRef="pa_t11" />
<bpmn:sequenceFlow id="pa_flow22" name="" sourceRef="pa_t11" targetRef="pa_t12" />
<bpmn:sequenceFlow id="pa_flow23" name="" sourceRef="pa_t12" targetRef="pa_e3" />
</bpmn:process>
