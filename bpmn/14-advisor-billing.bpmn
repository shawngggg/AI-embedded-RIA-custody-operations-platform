<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ab_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ab_collab">
<bpmn:participant id="ab_main" name="Custody operations platform (synthetic reference implementation)" processRef="ab_process" />
<bpmn:participant id="ab_adv" name="RIA advisor" />
<bpmn:messageFlow id="ab_msg0" name="Fee report" sourceRef="ab_t11" targetRef="ab_adv" />
<bpmn:textAnnotation id="ab_ann0"><bpmn:text>Fee plans are configured at onboarding: AI-parsed, human-approved.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="ab_ann0_assoc" sourceRef="ab_t2" targetRef="ab_ann0" />
<bpmn:textAnnotation id="ab_ann1"><bpmn:text>Pending-in assets are excluded from billable AUM by default (plan setting).</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ab_process" name="Advisor billing (AUM-based)" isExecutable="false">
<bpmn:laneSet id="ab_laneset">
<bpmn:lane id="ab_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>ab_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>ab_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ab_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>ab_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ab_s" name="Billing period end: monthly or quarterly">
<bpmn:outgoing>ab_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="ab_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ab_t1" name="Check period positions are certified by reconciliation">
<bpmn:incoming>ab_flow0</bpmn:incoming>
<bpmn:outgoing>ab_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ab_g0" name="Period certified?">
<bpmn:incoming>ab_flow1</bpmn:incoming>
<bpmn:outgoing>ab_flow2</bpmn:outgoing>
<bpmn:outgoing>ab_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="ab_ie" name="Reconciliation certified">
<bpmn:incoming>ab_flow2</bpmn:incoming>
<bpmn:outgoing>ab_flow4</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="ab_ie_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">condition_met == true</bpmn:condition></bpmn:conditionalEventDefinition>
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="ab_t2" name="Load fee plan: tiered, flat, minimums, householding, advance or arrears">
<bpmn:incoming>ab_flow3</bpmn:incoming>
<bpmn:incoming>ab_flow4</bpmn:incoming>
<bpmn:outgoing>ab_flow5</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_t3" name="Value billable assets: period-end or average daily balance, settled only">
<bpmn:incoming>ab_flow5</bpmn:incoming>
<bpmn:outgoing>ab_flow6</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ab_t4" name="Calculate fees: tiers, breakpoints, minimums, household aggregation">
<bpmn:incoming>ab_flow6</bpmn:incoming>
<bpmn:incoming>ab_flow13</bpmn:incoming>
<bpmn:outgoing>ab_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ab_t5" name="Pro-rate for flows and account opens and closes">
<bpmn:incoming>ab_flow7</bpmn:incoming>
<bpmn:outgoing>ab_flow8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ab_t6" name="Detect fee anomalies vs. prior period (AI)">
<bpmn:incoming>ab_flow8</bpmn:incoming>
<bpmn:outgoing>ab_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ab_g1" name="Anomalies flagged?">
<bpmn:incoming>ab_flow9</bpmn:incoming>
<bpmn:outgoing>ab_flow10</bpmn:outgoing>
<bpmn:outgoing>ab_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ab_t7" name="Review flagged fees">
<bpmn:incoming>ab_flow10</bpmn:incoming>
<bpmn:outgoing>ab_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ab_g2" name="Fee correct?">
<bpmn:incoming>ab_flow11</bpmn:incoming>
<bpmn:outgoing>ab_flow12</bpmn:outgoing>
<bpmn:outgoing>ab_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ab_t8" name="Correct fee-plan configuration">
<bpmn:incoming>ab_flow12</bpmn:incoming>
<bpmn:outgoing>ab_flow13</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ab_g3" name="">
<bpmn:incoming>ab_flow14</bpmn:incoming>
<bpmn:incoming>ab_flow15</bpmn:incoming>
<bpmn:outgoing>ab_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="ab_t9" name="Controls gate: billing file maker-checker approval">
<bpmn:incoming>ab_flow16</bpmn:incoming>
<bpmn:outgoing>ab_flow17</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_t10" name="Debit fees: client account to RIA fee account (three layers)">
<bpmn:incoming>ab_flow17</bpmn:incoming>
<bpmn:outgoing>ab_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="ab_t11" name="Send fee report to advisor">
<bpmn:incoming>ab_flow18</bpmn:incoming>
<bpmn:outgoing>ab_flow19</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="ab_e" name="Fees collected">
<bpmn:incoming>ab_flow19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="ab_flow0" name="" sourceRef="ab_s" targetRef="ab_t1" />
<bpmn:sequenceFlow id="ab_flow1" name="" sourceRef="ab_t1" targetRef="ab_g0" />
<bpmn:sequenceFlow id="ab_flow2" name="No" sourceRef="ab_g0" targetRef="ab_ie" />
<bpmn:sequenceFlow id="ab_flow3" name="Yes" sourceRef="ab_g0" targetRef="ab_t2" />
<bpmn:sequenceFlow id="ab_flow4" name="" sourceRef="ab_ie" targetRef="ab_t2" />
<bpmn:sequenceFlow id="ab_flow5" name="" sourceRef="ab_t2" targetRef="ab_t3" />
<bpmn:sequenceFlow id="ab_flow6" name="" sourceRef="ab_t3" targetRef="ab_t4" />
<bpmn:sequenceFlow id="ab_flow7" name="" sourceRef="ab_t4" targetRef="ab_t5" />
<bpmn:sequenceFlow id="ab_flow8" name="" sourceRef="ab_t5" targetRef="ab_t6" />
<bpmn:sequenceFlow id="ab_flow9" name="" sourceRef="ab_t6" targetRef="ab_g1" />
<bpmn:sequenceFlow id="ab_flow10" name="Yes" sourceRef="ab_g1" targetRef="ab_t7" />
<bpmn:sequenceFlow id="ab_flow11" name="" sourceRef="ab_t7" targetRef="ab_g2" />
<bpmn:sequenceFlow id="ab_flow12" name="No" sourceRef="ab_g2" targetRef="ab_t8" />
<bpmn:sequenceFlow id="ab_flow13" name="Recalculate" sourceRef="ab_t8" targetRef="ab_t4" />
<bpmn:sequenceFlow id="ab_flow14" name="No" sourceRef="ab_g1" targetRef="ab_g3" />
<bpmn:sequenceFlow id="ab_flow15" name="Yes" sourceRef="ab_g2" targetRef="ab_g3" />
<bpmn:sequenceFlow id="ab_flow16" name="" sourceRef="ab_g3" targetRef="ab_t9" />
<bpmn:sequenceFlow id="ab_flow17" name="" sourceRef="ab_t9" targetRef="ab_t10" />
<bpmn:sequenceFlow id="ab_flow18" name="" sourceRef="ab_t10" targetRef="ab_t11" />
<bpmn:sequenceFlow id="ab_flow19" name="" sourceRef="ab_t11" targetRef="ab_e" />
</bpmn:process>
