<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ab_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ab_collab">
<bpmn:participant id="ab_main" name="Custody operations platform (synthetic reference implementation)" processRef="ab_process" />
<bpmn:participant id="ab_ria" name="RIA advisor" />
<bpmn:messageFlow id="ab_msg0" name="Fee schedule" sourceRef="ab_ria" targetRef="ab_ss" />
<bpmn:messageFlow id="ab_msg1" name="Fee file" sourceRef="ab_ria" targetRef="ab_fie" />
<bpmn:messageFlow id="ab_msg2" name="Fee report" sourceRef="ab_t7" targetRef="ab_ria" />
<bpmn:messageFlow id="ab_msg3" name="Refund instruction" sourceRef="ab_ria" targetRef="ab_rs" />
<bpmn:textAnnotation id="ab_ann0"><bpmn:text>Fee deduction needs the client's written authorization, and the custodian's statements show every fee debit. Some states also require the RIA to send clients an invoice.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ab_ann1"><bpmn:text>Advance billing: a closed account gets a pro-rated refund under the RIA's agreement, and an outgoing transfer triggers the refund review.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ab_process" name="Advisor billing" isExecutable="false">
<bpmn:laneSet id="ab_laneset">
<bpmn:lane id="ab_lane_ops" name="Custody operations (billing)">
<bpmn:flowNodeRef>ab_ss</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_st2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_fie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_rs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_rt1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>ab_st1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ab_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_f1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_rt2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ab_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>ab_st3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_se</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_c1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_c2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_e</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_rt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ab_re</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ab_ss" name="Fee schedule or billing setting from the RIA">
<bpmn:outgoing>ab_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ab_ss_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="ab_st1" name="Parse the fee schedule: tiers, minimums, householding, timing (AI)">
<bpmn:incoming>ab_flow0</bpmn:incoming>
<bpmn:outgoing>ab_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="ab_st2" name="Approve the setup; confirm the client's fee authorization is on file">
<bpmn:incoming>ab_flow1</bpmn:incoming>
<bpmn:outgoing>ab_flow2</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="ab_st3" name="Store the schedule, effective-dated">
<bpmn:incoming>ab_flow2</bpmn:incoming>
<bpmn:outgoing>ab_flow3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ab_se" name="Schedule active">
<bpmn:incoming>ab_flow3</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ab_s" name="Billing period end">
<bpmn:outgoing>ab_flow4</bpmn:outgoing>
<bpmn:timerEventDefinition id="ab_s_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ab_t1" name="Check the period is certified by reconciliation">
<bpmn:incoming>ab_flow4</bpmn:incoming>
<bpmn:outgoing>ab_flow5</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ab_g0" name="Fee method?">
<bpmn:incoming>ab_flow5</bpmn:incoming>
<bpmn:outgoing>ab_flow6</bpmn:outgoing>
<bpmn:outgoing>ab_flow7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="ab_fie" name="Fee file received from the RIA">
<bpmn:incoming>ab_flow6</bpmn:incoming>
<bpmn:outgoing>ab_flow8</bpmn:outgoing>
<bpmn:messageEventDefinition id="ab_fie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="ab_f1" name="Validate the file: active authorization, open accounts, duplicates; an IRA pays only its own fee">
<bpmn:incoming>ab_flow8</bpmn:incoming>
<bpmn:outgoing>ab_flow10</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_c1" name="Value billable assets: period-end or average daily balance, settled only">
<bpmn:incoming>ab_flow7</bpmn:incoming>
<bpmn:outgoing>ab_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ab_c2" name="Calculate fees: tiers, breakpoints, minimums, householding; pro-rate flows, opens, closes">
<bpmn:incoming>ab_flow9</bpmn:incoming>
<bpmn:outgoing>ab_flow11</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ab_gm" name="">
<bpmn:incoming>ab_flow10</bpmn:incoming>
<bpmn:incoming>ab_flow11</bpmn:incoming>
<bpmn:outgoing>ab_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="ab_t2" name="Reasonableness check: fee vs. account value, schedule, and prior period">
<bpmn:incoming>ab_flow12</bpmn:incoming>
<bpmn:incoming>ab_flow16</bpmn:incoming>
<bpmn:outgoing>ab_flow13</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_t3" name="Flag fee anomalies and explain them (AI)">
<bpmn:incoming>ab_flow13</bpmn:incoming>
<bpmn:outgoing>ab_flow14</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ab_g1" name="Flagged?">
<bpmn:incoming>ab_flow14</bpmn:incoming>
<bpmn:outgoing>ab_flow15</bpmn:outgoing>
<bpmn:outgoing>ab_flow17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ab_t4" name="Review with the RIA; correct the schedule or the file">
<bpmn:incoming>ab_flow15</bpmn:incoming>
<bpmn:outgoing>ab_flow16</bpmn:outgoing>
</bpmn:userTask>
<bpmn:businessRuleTask id="ab_t5" name="Maker-checker approval of the fee run">
<bpmn:incoming>ab_flow17</bpmn:incoming>
<bpmn:outgoing>ab_flow18</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_t6" name="Debit fees to the RIA fee account (three layers); cash and sweep first, sales only on the RIA's trade">
<bpmn:incoming>ab_flow18</bpmn:incoming>
<bpmn:outgoing>ab_flow19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="ab_t7" name="Send the fee report to the RIA">
<bpmn:incoming>ab_flow19</bpmn:incoming>
<bpmn:outgoing>ab_flow20</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="ab_e" name="Fees collected">
<bpmn:incoming>ab_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ab_rs" name="Refund or correction: billing error, or an account closed mid-period">
<bpmn:outgoing>ab_flow21</bpmn:outgoing>
<bpmn:messageEventDefinition id="ab_rs_def" />
</bpmn:startEvent>
<bpmn:userTask id="ab_rt1" name="Calculate the refund under the RIA's agreement; the RIA approves">
<bpmn:incoming>ab_flow21</bpmn:incoming>
<bpmn:outgoing>ab_flow22</bpmn:outgoing>
</bpmn:userTask>
<bpmn:businessRuleTask id="ab_rt2" name="Maker-checker approval">
<bpmn:incoming>ab_flow22</bpmn:incoming>
<bpmn:outgoing>ab_flow23</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="ab_rt3" name="Credit the client account; reverse from the RIA fee account (three layers)">
<bpmn:incoming>ab_flow23</bpmn:incoming>
<bpmn:outgoing>ab_flow24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ab_re" name="Refund posted">
<bpmn:incoming>ab_flow24</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="ab_flow0" name="" sourceRef="ab_ss" targetRef="ab_st1" />
<bpmn:sequenceFlow id="ab_flow1" name="" sourceRef="ab_st1" targetRef="ab_st2" />
<bpmn:sequenceFlow id="ab_flow2" name="" sourceRef="ab_st2" targetRef="ab_st3" />
<bpmn:sequenceFlow id="ab_flow3" name="" sourceRef="ab_st3" targetRef="ab_se" />
<bpmn:sequenceFlow id="ab_flow4" name="" sourceRef="ab_s" targetRef="ab_t1" />
<bpmn:sequenceFlow id="ab_flow5" name="" sourceRef="ab_t1" targetRef="ab_g0" />
<bpmn:sequenceFlow id="ab_flow6" name="RIA fee file" sourceRef="ab_g0" targetRef="ab_fie" />
<bpmn:sequenceFlow id="ab_flow7" name="Custodian calculates" sourceRef="ab_g0" targetRef="ab_c1" />
<bpmn:sequenceFlow id="ab_flow8" name="" sourceRef="ab_fie" targetRef="ab_f1" />
<bpmn:sequenceFlow id="ab_flow9" name="" sourceRef="ab_c1" targetRef="ab_c2" />
<bpmn:sequenceFlow id="ab_flow10" name="" sourceRef="ab_f1" targetRef="ab_gm" />
<bpmn:sequenceFlow id="ab_flow11" name="" sourceRef="ab_c2" targetRef="ab_gm" />
<bpmn:sequenceFlow id="ab_flow12" name="" sourceRef="ab_gm" targetRef="ab_t2" />
<bpmn:sequenceFlow id="ab_flow13" name="" sourceRef="ab_t2" targetRef="ab_t3" />
<bpmn:sequenceFlow id="ab_flow14" name="" sourceRef="ab_t3" targetRef="ab_g1" />
<bpmn:sequenceFlow id="ab_flow15" name="Yes" sourceRef="ab_g1" targetRef="ab_t4" />
<bpmn:sequenceFlow id="ab_flow16" name="Re-check" sourceRef="ab_t4" targetRef="ab_t2" />
<bpmn:sequenceFlow id="ab_flow17" name="No" sourceRef="ab_g1" targetRef="ab_t5" />
<bpmn:sequenceFlow id="ab_flow18" name="" sourceRef="ab_t5" targetRef="ab_t6" />
<bpmn:sequenceFlow id="ab_flow19" name="" sourceRef="ab_t6" targetRef="ab_t7" />
<bpmn:sequenceFlow id="ab_flow20" name="" sourceRef="ab_t7" targetRef="ab_e" />
<bpmn:sequenceFlow id="ab_flow21" name="" sourceRef="ab_rs" targetRef="ab_rt1" />
<bpmn:sequenceFlow id="ab_flow22" name="" sourceRef="ab_rt1" targetRef="ab_rt2" />
<bpmn:sequenceFlow id="ab_flow23" name="" sourceRef="ab_rt2" targetRef="ab_rt3" />
<bpmn:sequenceFlow id="ab_flow24" name="" sourceRef="ab_rt3" targetRef="ab_re" />
</bpmn:process>
