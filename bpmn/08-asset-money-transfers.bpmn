<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="tr_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="tr_collab">
<bpmn:participant id="tr_main" name="Custody operations platform (synthetic reference implementation)" processRef="tr_process" />
<bpmn:participant id="tr_adv" name="RIA advisor, or the client (incoming anytime; outgoing by self-service grant or a signed request)" />
<bpmn:participant id="tr_infra" name="Market infrastructure: NSCC ACATS, contra firms, transfer agents, Fedwire, ACH" />
<bpmn:messageFlow id="tr_msg0" name="Transfer or disbursement request" sourceRef="tr_adv" targetRef="tr_s" />
<bpmn:messageFlow id="tr_msg1" name="Rejection with reason" sourceRef="tr_rej" targetRef="tr_adv" />
<bpmn:messageFlow id="tr_msg2" name="Completion notice" sourceRef="tr_done" targetRef="tr_adv" />
<bpmn:messageFlow id="tr_msg3" name="TIF" sourceRef="tr_r1" targetRef="tr_infra" />
<bpmn:messageFlow id="tr_msg4" name="Re-registration" sourceRef="tr_r2" targetRef="tr_infra" />
<bpmn:messageFlow id="tr_msg5" name="Payment order" sourceRef="tr_r3" targetRef="tr_infra" />
<bpmn:messageFlow id="tr_msg6" name="Confirmation" sourceRef="tr_infra" targetRef="tr_c1" />
<bpmn:messageFlow id="tr_msg7" name="Reject or exception" sourceRef="tr_infra" targetRef="tr_c2" />
<bpmn:textAnnotation id="tr_ann0"><bpmn:text>Residual credits (late dividends or interest after a full ACATS transfer) arrive as new items linked to the original transfer.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="tr_ann1"><bpmn:text>Pending items sit in suspense so the three-layer rollup balances mid-transfer.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="tr_process" name="Asset and money transfers" isExecutable="false">
<bpmn:laneSet id="tr_laneset">
<bpmn:lane id="tr_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>tr_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_casx</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_eb</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_fix</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_chase</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tr_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>tr_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_tri</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tr_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>tr_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_ts</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gm1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gt</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gm2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tr_lane_comp" name="Compliance and supervision">
<bpmn:flowNodeRef>tr_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_rej</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tr_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>tr_caxr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_r1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_r2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_r3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_r4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_ct</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_c1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_c2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_set</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_bas</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tr_done</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="tr_s" name="Transfer or disbursement request received">
<bpmn:outgoing>tr_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="tr_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="tr_t1" name="Extract request, prior-custodian statement, and LOA data">
<bpmn:incoming>tr_flow0</bpmn:incoming>
<bpmn:outgoing>tr_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="tr_t2" name="Pre-screen: predict rejects (title, tax ID, non-transferable assets) and risk signals">
<bpmn:incoming>tr_flow1</bpmn:incoming>
<bpmn:outgoing>tr_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="tr_t3" name="Validate requester and authority: RIA, client grant, or client-signed request">
<bpmn:incoming>tr_flow2</bpmn:incoming>
<bpmn:outgoing>tr_flow3</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:businessRuleTask id="tr_ts" name="First-line check vs. flagged list: parties, counterparty institution, products">
<bpmn:incoming>tr_flow3</bpmn:incoming>
<bpmn:outgoing>tr_flow4</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="tr_gs" name="Flagged?">
<bpmn:incoming>tr_flow4</bpmn:incoming>
<bpmn:outgoing>tr_flow5</bpmn:outgoing>
<bpmn:outgoing>tr_flow9</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="tr_casx" name="Sanctions escalation (shared subprocess)" calledElement="sx_process">
<bpmn:incoming>tr_flow5</bpmn:incoming>
<bpmn:outgoing>tr_flow6</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="tr_gc" name="Released?">
<bpmn:incoming>tr_flow6</bpmn:incoming>
<bpmn:outgoing>tr_flow7</bpmn:outgoing>
<bpmn:outgoing>tr_flow8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="tr_eb" name="Transfer stopped; sanctions team directs">
<bpmn:incoming>tr_flow7</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="tr_gm1" name="">
<bpmn:incoming>tr_flow8</bpmn:incoming>
<bpmn:incoming>tr_flow9</bpmn:incoming>
<bpmn:outgoing>tr_flow10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="tr_gt" name="Asset transfer?">
<bpmn:incoming>tr_flow10</bpmn:incoming>
<bpmn:outgoing>tr_flow11</bpmn:outgoing>
<bpmn:outgoing>tr_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="tr_caxr" name="Transferability review (shared subprocess)" calledElement="xr_process">
<bpmn:incoming>tr_flow11</bpmn:incoming>
<bpmn:outgoing>tr_flow13</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="tr_gm2" name="">
<bpmn:incoming>tr_flow12</bpmn:incoming>
<bpmn:incoming>tr_flow13</bpmn:incoming>
<bpmn:outgoing>tr_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="tr_g1" name="Pre-screen result?">
<bpmn:incoming>tr_flow14</bpmn:incoming>
<bpmn:outgoing>tr_flow15</bpmn:outgoing>
<bpmn:outgoing>tr_flow16</bpmn:outgoing>
<bpmn:outgoing>tr_flow17</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="tr_t4" name="Review and apply AI-suggested fix">
<bpmn:incoming>tr_flow15</bpmn:incoming>
<bpmn:outgoing>tr_flow21</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="tr_t5" name="Risk review: third-party payee, recent changes, SLOA conditions, low-priced deposits">
<bpmn:incoming>tr_flow16</bpmn:incoming>
<bpmn:outgoing>tr_flow18</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="tr_g2" name="Approved?">
<bpmn:incoming>tr_flow18</bpmn:incoming>
<bpmn:outgoing>tr_flow19</bpmn:outgoing>
<bpmn:outgoing>tr_flow20</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="tr_rej" name="Request rejected">
<bpmn:incoming>tr_flow19</bpmn:incoming>
<bpmn:messageEventDefinition id="tr_rej_def" />
</bpmn:endEvent>
<bpmn:exclusiveGateway id="tr_g3" name="">
<bpmn:incoming>tr_flow17</bpmn:incoming>
<bpmn:incoming>tr_flow20</bpmn:incoming>
<bpmn:incoming>tr_flow21</bpmn:incoming>
<bpmn:outgoing>tr_flow22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="tr_t6" name="Controls gate: dollar authority, maker-checker; RIA confirmation, client OTP and verified link, or callback">
<bpmn:incoming>tr_flow22</bpmn:incoming>
<bpmn:incoming>tr_flow42</bpmn:incoming>
<bpmn:outgoing>tr_flow23</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="tr_t7" name="Post pending bucket and in-transit suspense (three layers)">
<bpmn:incoming>tr_flow23</bpmn:incoming>
<bpmn:outgoing>tr_flow24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="tr_g4" name="Rail?">
<bpmn:incoming>tr_flow24</bpmn:incoming>
<bpmn:outgoing>tr_flow25</bpmn:outgoing>
<bpmn:outgoing>tr_flow26</bpmn:outgoing>
<bpmn:outgoing>tr_flow27</bpmn:outgoing>
<bpmn:outgoing>tr_flow28</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="tr_r1" name="Submit ACATS transfer (TIF)">
<bpmn:incoming>tr_flow25</bpmn:incoming>
<bpmn:outgoing>tr_flow29</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tr_r2" name="Non-ACATS: complete re-registration arranged by LOI">
<bpmn:incoming>tr_flow26</bpmn:incoming>
<bpmn:outgoing>tr_flow30</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tr_r3" name="Release wire or ACH via payment rail">
<bpmn:incoming>tr_flow27</bpmn:incoming>
<bpmn:outgoing>tr_flow31</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="tr_r4" name="Book internal journal">
<bpmn:incoming>tr_flow28</bpmn:incoming>
<bpmn:outgoing>tr_flow37</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="tr_gm" name="">
<bpmn:incoming>tr_flow29</bpmn:incoming>
<bpmn:incoming>tr_flow30</bpmn:incoming>
<bpmn:incoming>tr_flow31</bpmn:incoming>
<bpmn:incoming>tr_flow44</bpmn:incoming>
<bpmn:outgoing>tr_flow32</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:eventBasedGateway id="tr_eg" name="">
<bpmn:incoming>tr_flow32</bpmn:incoming>
<bpmn:outgoing>tr_flow33</bpmn:outgoing>
<bpmn:outgoing>tr_flow34</bpmn:outgoing>
<bpmn:outgoing>tr_flow35</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="tr_ct" name="Expected settlement date passed">
<bpmn:incoming>tr_flow33</bpmn:incoming>
<bpmn:outgoing>tr_flow43</bpmn:outgoing>
<bpmn:timerEventDefinition id="tr_ct_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="tr_c1" name="Settlement confirmation received">
<bpmn:incoming>tr_flow34</bpmn:incoming>
<bpmn:outgoing>tr_flow36</bpmn:outgoing>
<bpmn:messageEventDefinition id="tr_c1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="tr_c2" name="Reject or exception received">
<bpmn:incoming>tr_flow35</bpmn:incoming>
<bpmn:outgoing>tr_flow40</bpmn:outgoing>
<bpmn:messageEventDefinition id="tr_c2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="tr_set" name="Settle: clear suspense, move pending to settled (three layers)">
<bpmn:incoming>tr_flow36</bpmn:incoming>
<bpmn:incoming>tr_flow37</bpmn:incoming>
<bpmn:outgoing>tr_flow38</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="tr_bas" name="Track cost basis as its own pending item">
<bpmn:incoming>tr_flow38</bpmn:incoming>
<bpmn:outgoing>tr_flow39</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="tr_done" name="Transfer complete">
<bpmn:incoming>tr_flow39</bpmn:incoming>
<bpmn:messageEventDefinition id="tr_done_def" />
</bpmn:endEvent>
<bpmn:serviceTask id="tr_tri" name="Triage exception and draft correction (AI)">
<bpmn:incoming>tr_flow40</bpmn:incoming>
<bpmn:outgoing>tr_flow41</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="tr_fix" name="Approve correction">
<bpmn:incoming>tr_flow41</bpmn:incoming>
<bpmn:outgoing>tr_flow42</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="tr_chase" name="Chase contra party with AI-drafted inquiry">
<bpmn:incoming>tr_flow43</bpmn:incoming>
<bpmn:outgoing>tr_flow44</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sequenceFlow id="tr_flow0" name="" sourceRef="tr_s" targetRef="tr_t1" />
<bpmn:sequenceFlow id="tr_flow1" name="" sourceRef="tr_t1" targetRef="tr_t2" />
<bpmn:sequenceFlow id="tr_flow2" name="" sourceRef="tr_t2" targetRef="tr_t3" />
<bpmn:sequenceFlow id="tr_flow3" name="" sourceRef="tr_t3" targetRef="tr_ts" />
<bpmn:sequenceFlow id="tr_flow4" name="" sourceRef="tr_ts" targetRef="tr_gs" />
