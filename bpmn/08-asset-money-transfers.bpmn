<bpmn:sequenceFlow id="tr_flow43" name="" sourceRef="tr_ct" targetRef="tr_chase" />
<bpmn:sequenceFlow id="tr_flow44" name="Keep waiting" sourceRef="tr_chase" targetRef="tr_gm" />
</bpmn:process>
<bpmndi:BPMNDiagram id="tr_diagram" name="Asset and money transfers">
<bpmndi:BPMNPlane id="tr_plane" bpmnElement="tr_collab">
