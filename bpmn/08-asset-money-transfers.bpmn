<bpmn:sequenceFlow id="tr_flow6" name="" sourceRef="tr_casx" targetRef="tr_gc" />
<bpmn:sequenceFlow id="tr_flow7" name="No" sourceRef="tr_gc" targetRef="tr_eb" />
<bpmn:sequenceFlow id="tr_flow8" name="Yes" sourceRef="tr_gc" targetRef="tr_gm1" />
<bpmn:sequenceFlow id="tr_flow9" name="No" sourceRef="tr_gs" targetRef="tr_gm1" />
<bpmn:sequenceFlow id="tr_flow10" name="" sourceRef="tr_gm1" targetRef="tr_gt" />
<bpmn:sequenceFlow id="tr_flow11" name="Assets" sourceRef="tr_gt" targetRef="tr_caxr" />
<bpmn:sequenceFlow id="tr_flow12" name="Cash only" sourceRef="tr_gt" targetRef="tr_gm2" />
<bpmn:sequenceFlow id="tr_flow13" name="" sourceRef="tr_caxr" targetRef="tr_gm2" />
<bpmn:sequenceFlow id="tr_flow14" name="" sourceRef="tr_gm2" targetRef="tr_g1" />
<bpmn:sequenceFlow id="tr_flow15" name="AI-suggest fix" sourceRef="tr_g1" targetRef="tr_t4" />
<bpmn:sequenceFlow id="tr_flow16" name="Human-only" sourceRef="tr_g1" targetRef="tr_t5" />
<bpmn:sequenceFlow id="tr_flow17" name="Clean" sourceRef="tr_g1" targetRef="tr_g3" />
<bpmn:sequenceFlow id="tr_flow18" name="" sourceRef="tr_t5" targetRef="tr_g2" />
<bpmn:sequenceFlow id="tr_flow19" name="No" sourceRef="tr_g2" targetRef="tr_rej" />
<bpmn:sequenceFlow id="tr_flow20" name="Yes" sourceRef="tr_g2" targetRef="tr_g3" />
<bpmn:sequenceFlow id="tr_flow21" name="" sourceRef="tr_t4" targetRef="tr_g3" />
<bpmn:sequenceFlow id="tr_flow22" name="" sourceRef="tr_g3" targetRef="tr_t6" />
<bpmn:sequenceFlow id="tr_flow23" name="" sourceRef="tr_t6" targetRef="tr_t7" />
<bpmn:sequenceFlow id="tr_flow24" name="" sourceRef="tr_t7" targetRef="tr_g4" />
<bpmn:sequenceFlow id="tr_flow25" name="ACATS" sourceRef="tr_g4" targetRef="tr_r1" />
<bpmn:sequenceFlow id="tr_flow26" name="Non-ACATS" sourceRef="tr_g4" targetRef="tr_r2" />
<bpmn:sequenceFlow id="tr_flow27" name="Wire or ACH" sourceRef="tr_g4" targetRef="tr_r3" />
<bpmn:sequenceFlow id="tr_flow28" name="Journal" sourceRef="tr_g4" targetRef="tr_r4" />
<bpmn:sequenceFlow id="tr_flow29" name="" sourceRef="tr_r1" targetRef="tr_gm" />
<bpmn:sequenceFlow id="tr_flow30" name="" sourceRef="tr_r2" targetRef="tr_gm" />
<bpmn:sequenceFlow id="tr_flow31" name="" sourceRef="tr_r3" targetRef="tr_gm" />
<bpmn:sequenceFlow id="tr_flow32" name="" sourceRef="tr_gm" targetRef="tr_eg" />
<bpmn:sequenceFlow id="tr_flow33" name="" sourceRef="tr_eg" targetRef="tr_ct" />
<bpmn:sequenceFlow id="tr_flow34" name="" sourceRef="tr_eg" targetRef="tr_c1" />
<bpmn:sequenceFlow id="tr_flow35" name="" sourceRef="tr_eg" targetRef="tr_c2" />
<bpmn:sequenceFlow id="tr_flow36" name="" sourceRef="tr_c1" targetRef="tr_set" />
<bpmn:sequenceFlow id="tr_flow37" name="" sourceRef="tr_r4" targetRef="tr_set" />
<bpmn:sequenceFlow id="tr_flow38" name="" sourceRef="tr_set" targetRef="tr_bas" />
<bpmn:sequenceFlow id="tr_flow39" name="" sourceRef="tr_bas" targetRef="tr_done" />
<bpmn:sequenceFlow id="tr_flow40" name="" sourceRef="tr_c2" targetRef="tr_tri" />
