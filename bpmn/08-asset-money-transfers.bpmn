<bpmndi:BPMNShape id="tr_adv_di" bpmnElement="tr_adv" isHorizontal="true" bioc:stroke="#5B6578" bioc:fill="#F3F5F9" color:background-color="#F3F5F9" color:border-color="#5B6578"><dc:Bounds x="0" y="0" width="5900" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tr_infra_di" bpmnElement="tr_infra" isHorizontal="true" bioc:stroke="#5B6578" bioc:fill="#F3F5F9" color:background-color="#F3F5F9" color:border-color="#5B6578"><dc:Bounds x="0" y="1348" width="5900" height="60" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tr_s_di" bpmnElement="tr_s"><dc:Bounds x="162" y="191" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="204" y="195" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tr_t1_di" bpmnElement="tr_t1" bioc:stroke="#534AB7" bioc:fill="#EEEDFE" color:background-color="#EEEDFE" color:border-color="#534AB7"><dc:Bounds x="300" y="334" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="tr_t2_di" bpmnElement="tr_t2" bioc:stroke="#534AB7" bioc:fill="#EEEDFE" color:background-color="#EEEDFE" color:border-color="#534AB7"><dc:Bounds x="500" y="334" width="160" height="90" /></bpmndi:BPMNShape>
