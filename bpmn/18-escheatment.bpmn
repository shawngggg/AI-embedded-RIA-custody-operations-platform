<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="es_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="es_collab">
<bpmn:participant id="es_main" name="Custody operations platform (synthetic reference implementation)" processRef="es_process" />
<bpmn:participant id="es_adv" name="RIA advisor" />
<bpmn:participant id="es_own" name="End client (owner)" />
<bpmn:participant id="es_srch" name="Address search provider" />
<bpmn:participant id="es_state" name="State unclaimed property administrators" />
<bpmn:messageFlow id="es_msg0" name="Search request" sourceRef="es_t4" targetRef="es_srch" />
<bpmn:messageFlow id="es_msg1" name="Candidate addresses" sourceRef="es_srch" targetRef="es_ie" />
<bpmn:messageFlow id="es_msg2" name="Outreach request" sourceRef="es_t7" targetRef="es_adv" />
<bpmn:messageFlow id="es_msg3" name="Due-diligence letter" sourceRef="es_t9" targetRef="es_own" />
<bpmn:messageFlow id="es_msg4" name="Owner response" sourceRef="es_own" targetRef="es_cr" />
<bpmn:messageFlow id="es_msg5" name="Cash remittance" sourceRef="es_t12" targetRef="es_state" />
<bpmn:messageFlow id="es_msg6" name="Securities delivery" sourceRef="es_t13" targetRef="es_state" />
<bpmn:messageFlow id="es_msg7" name="Holder report" sourceRef="es_t14" targetRef="es_state" />
<bpmn:textAnnotation id="es_ann0"><bpmn:text>Dormancy periods, due-diligence windows, and report deadlines vary by state; they are configured as effective-dated rules.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="es_ann1"><bpmn:text>Owners later claim escheated property from the state; the custodian keeps records to support the claim.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="es_ann1_assoc" sourceRef="es_t15" targetRef="es_ann1" />
</bpmn:collaboration>
<bpmn:process id="es_process" name="Escheatment and unclaimed property" isExecutable="false">
<bpmn:laneSet id="es_laneset">
<bpmn:lane id="es_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>es_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_el</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_cr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_tr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_er</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="es_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>es_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="es_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>es_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_e0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_ct</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t14</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="es_lane_comp" name="Compliance and supervision">
<bpmn:flowNodeRef>es_t10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="es_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>es_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_j</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_t15</bpmn:flowNodeRef>
<bpmn:flowNodeRef>es_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="es_s" name="Daily: dormancy and lost-owner monitoring">
<bpmn:outgoing>es_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="es_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="es_t1" name="Collect triggers: returned mail, uncashed checks, last owner-generated contact">
<bpmn:incoming>es_flow0</bpmn:incoming>
<bpmn:outgoing>es_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="es_t2" name="Review contact signals (logins, calls, trades, advisor notes); flag likely-lost owners (AI)">
<bpmn:incoming>es_flow1</bpmn:incoming>
<bpmn:outgoing>es_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="es_t3" name="Apply state dormancy rules and lost-securityholder status (effective-dated)">
<bpmn:incoming>es_flow2</bpmn:incoming>
<bpmn:outgoing>es_flow3</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="es_g1" name="Account status?">
<bpmn:incoming>es_flow3</bpmn:incoming>
<bpmn:outgoing>es_flow4</bpmn:outgoing>
<bpmn:outgoing>es_flow5</bpmn:outgoing>
<bpmn:outgoing>es_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="es_e0" name="Active: no action">
<bpmn:incoming>es_flow4</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sendTask id="es_t4" name="Run lost-securityholder database search (Rule 17Ad-17 where applicable)">
<bpmn:incoming>es_flow5</bpmn:incoming>
<bpmn:outgoing>es_flow7</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="es_ie" name="Search results received">
<bpmn:incoming>es_flow7</bpmn:incoming>
<bpmn:outgoing>es_flow8</bpmn:outgoing>
<bpmn:messageEventDefinition id="es_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="es_t5" name="Match candidate addresses to the owner (AI)">
<bpmn:incoming>es_flow8</bpmn:incoming>
<bpmn:outgoing>es_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="es_g2" name="Confident match?">
<bpmn:incoming>es_flow9</bpmn:incoming>
<bpmn:outgoing>es_flow10</bpmn:outgoing>
<bpmn:outgoing>es_flow12</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="es_t6" name="Verify and update address; reset dormancy clock">
<bpmn:incoming>es_flow10</bpmn:incoming>
<bpmn:outgoing>es_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="es_el" name="Owner located">
<bpmn:incoming>es_flow11</bpmn:incoming>
</bpmn:endEvent>
<bpmn:exclusiveGateway id="es_g3" name="">
<bpmn:incoming>es_flow6</bpmn:incoming>
<bpmn:incoming>es_flow12</bpmn:incoming>
<bpmn:outgoing>es_flow13</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="es_t7" name="Ask advisor to contact the client">
<bpmn:incoming>es_flow13</bpmn:incoming>
<bpmn:outgoing>es_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:businessRuleTask id="es_t8" name="Determine escheat state (owner's last known address, else holder's state)">
<bpmn:incoming>es_flow14</bpmn:incoming>
<bpmn:outgoing>es_flow15</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:sendTask id="es_t9" name="Send due-diligence letter to owner">
<bpmn:incoming>es_flow15</bpmn:incoming>
<bpmn:outgoing>es_flow16</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="es_eg" name="">
<bpmn:incoming>es_flow16</bpmn:incoming>
<bpmn:outgoing>es_flow17</bpmn:outgoing>
<bpmn:outgoing>es_flow18</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="es_cr" name="Owner responds">
<bpmn:incoming>es_flow17</bpmn:incoming>
<bpmn:outgoing>es_flow19</bpmn:outgoing>
<bpmn:messageEventDefinition id="es_cr_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="es_ct" name="Response window expires">
<bpmn:incoming>es_flow18</bpmn:incoming>
<bpmn:outgoing>es_flow21</bpmn:outgoing>
<bpmn:timerEventDefinition id="es_ct_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="es_tr" name="Record owner contact; reset dormancy clock">
<bpmn:incoming>es_flow19</bpmn:incoming>
<bpmn:outgoing>es_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="es_er" name="Owner retained">
<bpmn:incoming>es_flow20</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="es_t10" name="Approve escheat list and holder report">
<bpmn:incoming>es_flow21</bpmn:incoming>
<bpmn:outgoing>es_flow22</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="es_t11" name="Freeze account; move property to escheat-pending suspense (three layers)">
<bpmn:incoming>es_flow22</bpmn:incoming>
<bpmn:outgoing>es_flow23</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:inclusiveGateway id="es_g4" name="Property types held?">
<bpmn:incoming>es_flow23</bpmn:incoming>
<bpmn:outgoing>es_flow24</bpmn:outgoing>
<bpmn:outgoing>es_flow25</bpmn:outgoing>
</bpmn:inclusiveGateway>
<bpmn:sendTask id="es_t12" name="Remit cash to the state">
<bpmn:incoming>es_flow24</bpmn:incoming>
<bpmn:outgoing>es_flow26</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="es_t13" name="Deliver securities to the state's custodian">
<bpmn:incoming>es_flow25</bpmn:incoming>
<bpmn:outgoing>es_flow27</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:inclusiveGateway id="es_j" name="">
<bpmn:incoming>es_flow26</bpmn:incoming>
<bpmn:incoming>es_flow27</bpmn:incoming>
<bpmn:outgoing>es_flow28</bpmn:outgoing>
</bpmn:inclusiveGateway>
<bpmn:sendTask id="es_t14" name="File holder report (NAUPA format) by the state deadline">
<bpmn:incoming>es_flow28</bpmn:incoming>
<bpmn:outgoing>es_flow29</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="es_t15" name="Post escheatment at client, RIA master, and GL; retain claim records">
<bpmn:incoming>es_flow29</bpmn:incoming>
<bpmn:outgoing>es_flow30</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="es_e" name="Property escheated">
<bpmn:incoming>es_flow30</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="es_flow0" name="" sourceRef="es_s" targetRef="es_t1" />
<bpmn:sequenceFlow id="es_flow1" name="" sourceRef="es_t1" targetRef="es_t2" />
<bpmn:sequenceFlow id="es_flow2" name="" sourceRef="es_t2" targetRef="es_t3" />
<bpmn:sequenceFlow id="es_flow3" name="" sourceRef="es_t3" targetRef="es_g1" />
<bpmn:sequenceFlow id="es_flow4" name="Active" sourceRef="es_g1" targetRef="es_e0" />
<bpmn:sequenceFlow id="es_flow5" name="Lost securityholder" sourceRef="es_g1" targetRef="es_t4" />
<bpmn:sequenceFlow id="es_flow6" name="Dormancy reached" sourceRef="es_g1" targetRef="es_g3" />
<bpmn:sequenceFlow id="es_flow7" name="" sourceRef="es_t4" targetRef="es_ie" />
<bpmn:sequenceFlow id="es_flow8" name="" sourceRef="es_ie" targetRef="es_t5" />
<bpmn:sequenceFlow id="es_flow9" name="" sourceRef="es_t5" targetRef="es_g2" />
<bpmn:sequenceFlow id="es_flow10" name="Yes" sourceRef="es_g2" targetRef="es_t6" />
<bpmn:sequenceFlow id="es_flow11" name="" sourceRef="es_t6" targetRef="es_el" />
<bpmn:sequenceFlow id="es_flow12" name="No" sourceRef="es_g2" targetRef="es_g3" />
<bpmn:sequenceFlow id="es_flow13" name="" sourceRef="es_g3" targetRef="es_t7" />
<bpmn:sequenceFlow id="es_flow14" name="" sourceRef="es_t7" targetRef="es_t8" />
<bpmn:sequenceFlow id="es_flow15" name="" sourceRef="es_t8" targetRef="es_t9" />
<bpmn:sequenceFlow id="es_flow16" name="" sourceRef="es_t9" targetRef="es_eg" />
<bpmn:sequenceFlow id="es_flow17" name="" sourceRef="es_eg" targetRef="es_cr" />
<bpmn:sequenceFlow id="es_flow18" name="" sourceRef="es_eg" targetRef="es_ct" />
<bpmn:sequenceFlow id="es_flow19" name="" sourceRef="es_cr" targetRef="es_tr" />
<bpmn:sequenceFlow id="es_flow20" name="" sourceRef="es_tr" targetRef="es_er" />
<bpmn:sequenceFlow id="es_flow21" name="" sourceRef="es_ct" targetRef="es_t10" />
<bpmn:sequenceFlow id="es_flow22" name="" sourceRef="es_t10" targetRef="es_t11" />
<bpmn:sequenceFlow id="es_flow23" name="" sourceRef="es_t11" targetRef="es_g4" />
<bpmn:sequenceFlow id="es_flow24" name="Cash" sourceRef="es_g4" targetRef="es_t12" />
<bpmn:sequenceFlow id="es_flow25" name="Securities" sourceRef="es_g4" targetRef="es_t13" />
<bpmn:sequenceFlow id="es_flow26" name="" sourceRef="es_t12" targetRef="es_j" />
<bpmn:sequenceFlow id="es_flow27" name="" sourceRef="es_t13" targetRef="es_j" />
<bpmn:sequenceFlow id="es_flow28" name="" sourceRef="es_j" targetRef="es_t14" />
<bpmn:sequenceFlow id="es_flow29" name="" sourceRef="es_t14" targetRef="es_t15" />
<bpmn:sequenceFlow id="es_flow30" name="" sourceRef="es_t15" targetRef="es_e" />
</bpmn:process>
