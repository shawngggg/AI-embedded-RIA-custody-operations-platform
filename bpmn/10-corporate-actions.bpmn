<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ca_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ca_collab">
<bpmn:participant id="ca_main" name="Custody operations platform (synthetic reference implementation)" processRef="ca_process" />
<bpmn:participant id="ca_adv" name="RIA advisor (or the client for the self-directed account)" />
<bpmn:participant id="ca_agt" name="DTC, announcement sources, paying and exchange agents" />
<bpmn:messageFlow id="ca_msg0" name="Announcement" sourceRef="ca_agt" targetRef="ca_s" />
<bpmn:messageFlow id="ca_msg1" name="Election request" sourceRef="ca_v1" targetRef="ca_adv" />
<bpmn:messageFlow id="ca_msg2" name="Election" sourceRef="ca_adv" targetRef="ca_v2" />
<bpmn:messageFlow id="ca_msg3" name="Election instruction" sourceRef="ca_v5" targetRef="ca_agt" />
<bpmn:messageFlow id="ca_msg4" name="Payment or shares" sourceRef="ca_agt" targetRef="ca_c1" />
<bpmn:textAnnotation id="ca_ann0"><bpmn:text>Golden copy: one validated version of each event, built from several announcement sources. With T+1, the ex-date equals the record date for most cash dividends.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ca_ann1"><bpmn:text>Splits restate per-share basis; conversions and mergers carry basis to the new security.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ca_process" name="Corporate actions (mandatory and voluntary)" isExecutable="false">
<bpmn:laneSet id="ca_laneset">
<bpmn:lane id="ca_lane_ops" name="Operations analyst">
<bpmn:flowNodeRef>ca_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_v1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_eg</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_v2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_v3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ca_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>ca_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_v4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ca_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>ca_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_v5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ca_lane_ledger" name="Ledger and settlement engine">
<bpmn:flowNodeRef>ca_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_m1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_m2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_m3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_m4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_c1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ca_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ca_s" name="Event announcement received">
<bpmn:outgoing>ca_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ca_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="ca_t1" name="Normalize announcements; compare sources; flag discrepancies (AI)">
<bpmn:incoming>ca_flow0</bpmn:incoming>
<bpmn:outgoing>ca_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="ca_t2" name="Validate golden copy: event type, key dates, rates, ratios">
<bpmn:incoming>ca_flow1</bpmn:incoming>
<bpmn:incoming>ca_flow4</bpmn:incoming>
<bpmn:outgoing>ca_flow2</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ca_g1" name="Terms confirmed?">
<bpmn:incoming>ca_flow2</bpmn:incoming>
<bpmn:outgoing>ca_flow3</bpmn:outgoing>
<bpmn:outgoing>ca_flow5</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="ca_t3" name="Confirm terms with the agent">
<bpmn:incoming>ca_flow3</bpmn:incoming>
<bpmn:outgoing>ca_flow4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:businessRuleTask id="ca_t4" name="Identify holders and entitlements at record date (client, RIA master, GL)">
<bpmn:incoming>ca_flow5</bpmn:incoming>
<bpmn:outgoing>ca_flow6</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ca_g2" name="Event type?">
<bpmn:incoming>ca_flow6</bpmn:incoming>
<bpmn:outgoing>ca_flow7</bpmn:outgoing>
<bpmn:outgoing>ca_flow15</bpmn:outgoing>
<bpmn:outgoing>ca_flow16</bpmn:outgoing>
<bpmn:outgoing>ca_flow17</bpmn:outgoing>
<bpmn:outgoing>ca_flow18</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="ca_v1" name="Notify the RIA, or the client for the self-directed account: options, deadline, default">
<bpmn:incoming>ca_flow7</bpmn:incoming>
<bpmn:outgoing>ca_flow8</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:eventBasedGateway id="ca_eg" name="">
<bpmn:incoming>ca_flow8</bpmn:incoming>
<bpmn:outgoing>ca_flow9</bpmn:outgoing>
<bpmn:outgoing>ca_flow10</bpmn:outgoing>
</bpmn:eventBasedGateway>
<bpmn:intermediateCatchEvent id="ca_v2" name="Election received">
<bpmn:incoming>ca_flow9</bpmn:incoming>
<bpmn:outgoing>ca_flow11</bpmn:outgoing>
<bpmn:messageEventDefinition id="ca_v2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:intermediateCatchEvent id="ca_v3" name="Deadline passes: default applies">
<bpmn:incoming>ca_flow10</bpmn:incoming>
<bpmn:outgoing>ca_flow12</bpmn:outgoing>
<bpmn:timerEventDefinition id="ca_v3_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="ca_v4" name="Validate election against eligible position (AI flags mismatches)">
<bpmn:incoming>ca_flow11</bpmn:incoming>
<bpmn:incoming>ca_flow12</bpmn:incoming>
<bpmn:outgoing>ca_flow13</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="ca_v5" name="Submit election to the agent">
<bpmn:incoming>ca_flow13</bpmn:incoming>
<bpmn:outgoing>ca_flow14</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="ca_m1" name="Cash dividend: accrue at ex-date; pay cash or reinvest on pay date">
<bpmn:incoming>ca_flow15</bpmn:incoming>
<bpmn:outgoing>ca_flow19</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ca_m2" name="Forward split: increase quantity; restate cost basis per share">
<bpmn:incoming>ca_flow16</bpmn:incoming>
<bpmn:outgoing>ca_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ca_m3" name="Reverse split: reduce quantity; cash in lieu of fractional shares">
<bpmn:incoming>ca_flow17</bpmn:incoming>
<bpmn:outgoing>ca_flow21</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ca_m4" name="Merger, conversion, or symbol change: exchange or rename; basis per Form 8937">
<bpmn:incoming>ca_flow18</bpmn:incoming>
<bpmn:outgoing>ca_flow22</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="ca_gm" name="">
<bpmn:incoming>ca_flow14</bpmn:incoming>
<bpmn:incoming>ca_flow19</bpmn:incoming>
<bpmn:incoming>ca_flow20</bpmn:incoming>
<bpmn:incoming>ca_flow21</bpmn:incoming>
<bpmn:incoming>ca_flow22</bpmn:incoming>
<bpmn:outgoing>ca_flow23</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ca_t5" name="Post entitlements at client, RIA master, GL (pending until pay date)">
<bpmn:incoming>ca_flow23</bpmn:incoming>
<bpmn:outgoing>ca_flow24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="ca_c1" name="Payment or new shares received from agent">
<bpmn:incoming>ca_flow24</bpmn:incoming>
<bpmn:outgoing>ca_flow25</bpmn:outgoing>
<bpmn:messageEventDefinition id="ca_c1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="ca_t6" name="Reconcile positions and cash against expected entitlements after the event">
<bpmn:incoming>ca_flow25</bpmn:incoming>
<bpmn:incoming>ca_flow31</bpmn:incoming>
<bpmn:outgoing>ca_flow26</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ca_g3" name="Matches?">
<bpmn:incoming>ca_flow26</bpmn:incoming>
<bpmn:outgoing>ca_flow27</bpmn:outgoing>
<bpmn:outgoing>ca_flow29</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ca_t7" name="Release pending: settle at three layers; update tax lots">
<bpmn:incoming>ca_flow27</bpmn:incoming>
<bpmn:outgoing>ca_flow28</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ca_e" name="Event closed">
<bpmn:incoming>ca_flow28</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="ca_t8" name="Classify difference and draft claim (AI)">
<bpmn:incoming>ca_flow29</bpmn:incoming>
<bpmn:outgoing>ca_flow30</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="ca_t9" name="Pursue claim with agent or counterparty">
<bpmn:incoming>ca_flow30</bpmn:incoming>
<bpmn:outgoing>ca_flow31</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sequenceFlow id="ca_flow0" name="" sourceRef="ca_s" targetRef="ca_t1" />
<bpmn:sequenceFlow id="ca_flow1" name="" sourceRef="ca_t1" targetRef="ca_t2" />
<bpmn:sequenceFlow id="ca_flow2" name="" sourceRef="ca_t2" targetRef="ca_g1" />
<bpmn:sequenceFlow id="ca_flow3" name="No" sourceRef="ca_g1" targetRef="ca_t3" />
<bpmn:sequenceFlow id="ca_flow4" name="Re-validate" sourceRef="ca_t3" targetRef="ca_t2" />
<bpmn:sequenceFlow id="ca_flow5" name="Yes" sourceRef="ca_g1" targetRef="ca_t4" />
<bpmn:sequenceFlow id="ca_flow6" name="" sourceRef="ca_t4" targetRef="ca_g2" />
<bpmn:sequenceFlow id="ca_flow7" name="Voluntary" sourceRef="ca_g2" targetRef="ca_v1" />
<bpmn:sequenceFlow id="ca_flow8" name="" sourceRef="ca_v1" targetRef="ca_eg" />
<bpmn:sequenceFlow id="ca_flow9" name="" sourceRef="ca_eg" targetRef="ca_v2" />
<bpmn:sequenceFlow id="ca_flow10" name="" sourceRef="ca_eg" targetRef="ca_v3" />
<bpmn:sequenceFlow id="ca_flow11" name="" sourceRef="ca_v2" targetRef="ca_v4" />
<bpmn:sequenceFlow id="ca_flow12" name="" sourceRef="ca_v3" targetRef="ca_v4" />
<bpmn:sequenceFlow id="ca_flow13" name="" sourceRef="ca_v4" targetRef="ca_v5" />
<bpmn:sequenceFlow id="ca_flow14" name="" sourceRef="ca_v5" targetRef="ca_gm" />
<bpmn:sequenceFlow id="ca_flow15" name="Cash dividend" sourceRef="ca_g2" targetRef="ca_m1" />
<bpmn:sequenceFlow id="ca_flow16" name="Forward split" sourceRef="ca_g2" targetRef="ca_m2" />
<bpmn:sequenceFlow id="ca_flow17" name="Reverse split" sourceRef="ca_g2" targetRef="ca_m3" />
<bpmn:sequenceFlow id="ca_flow18" name="Merger, conversion, symbol change" sourceRef="ca_g2" targetRef="ca_m4" />
<bpmn:sequenceFlow id="ca_flow19" name="" sourceRef="ca_m1" targetRef="ca_gm" />
<bpmn:sequenceFlow id="ca_flow20" name="" sourceRef="ca_m2" targetRef="ca_gm" />
<bpmn:sequenceFlow id="ca_flow21" name="" sourceRef="ca_m3" targetRef="ca_gm" />
<bpmn:sequenceFlow id="ca_flow22" name="" sourceRef="ca_m4" targetRef="ca_gm" />
<bpmn:sequenceFlow id="ca_flow23" name="" sourceRef="ca_gm" targetRef="ca_t5" />
<bpmn:sequenceFlow id="ca_flow24" name="" sourceRef="ca_t5" targetRef="ca_c1" />
<bpmn:sequenceFlow id="ca_flow25" name="" sourceRef="ca_c1" targetRef="ca_t6" />
<bpmn:sequenceFlow id="ca_flow26" name="" sourceRef="ca_t6" targetRef="ca_g3" />
<bpmn:sequenceFlow id="ca_flow27" name="Yes" sourceRef="ca_g3" targetRef="ca_t7" />
<bpmn:sequenceFlow id="ca_flow28" name="" sourceRef="ca_t7" targetRef="ca_e" />
<bpmn:sequenceFlow id="ca_flow29" name="No" sourceRef="ca_g3" targetRef="ca_t8" />
<bpmn:sequenceFlow id="ca_flow30" name="" sourceRef="ca_t8" targetRef="ca_t9" />
<bpmn:sequenceFlow id="ca_flow31" name="Re-reconcile" sourceRef="ca_t9" targetRef="ca_t6" />
</bpmn:process>
