<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="fc_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="fc_collab">
<bpmn:participant id="fc_main" name="Custody operations platform (synthetic reference implementation)" processRef="fc_process" />
<bpmn:participant id="fc_ria" name="RIA advisor (asked for facts only; never told whether a SAR exists)" />
<bpmn:participant id="fc_fin" name="FinCEN BSA E-Filing" />
<bpmn:messageFlow id="fc_msg0" name="Request for facts and documents" sourceRef="fc_t2" targetRef="fc_ria" />
<bpmn:messageFlow id="fc_msg1" name="Facts and documents" sourceRef="fc_ria" targetRef="fc_t2" />
<bpmn:messageFlow id="fc_msg2" name="SAR (BSA XML)" sourceRef="fc_t11" targetRef="fc_fin" />
<bpmn:messageFlow id="fc_msg3" name="Acknowledgment" sourceRef="fc_fin" targetRef="fc_ie" />
<bpmn:textAnnotation id="fc_ann0"><bpmn:text>First line refers and stops there: referrers get an acknowledgment, never the outcome. No one tells the RIA, the client, or anyone outside the case team whether a SAR exists.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="fc_ann1"><bpmn:text>AI drafts on an isolated, no-retention deployment approved for SAR data; it never decides or files.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="fc_ann2"><bpmn:text>Flagged-list hits go to sanctions escalation instead. FinCEN 314(a) requests run separately: search 12 months of accounts and 6 months of transactions within 2 weeks; reply only on a match.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="fc_ann3"><bpmn:text>Investigators may ask the RIA for underlying facts and documents but never mention a SAR. No joint SAR with the RIA: advisers aren't under a SAR rule before Jan 1, 2028.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="fc_ann4"><bpmn:text>Ongoing schemes or terrorist financing: also call law enforcement right away. A law enforcement keep-open request doesn't bind the firm; requests run up to six months.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="fc_ann5"><bpmn:text>Continuing activity: FinCEN's October 2025 SAR FAQs dropped the required 90-day re-review; risk-based monitoring is enough. BSA E-Filing acknowledges within about 2 business days; a rejected batch is fixed and resubmitted.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="fc_process" name="Financial crimes and SAR filing" isExecutable="false">
<bpmn:laneSet id="fc_laneset">
<bpmn:lane id="fc_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>fc_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t0</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="fc_lane_ai" name="AI assist (isolated deployment)">
<bpmn:flowNodeRef>fc_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="fc_lane_rules" name="Rules and monitoring engine">
<bpmn:flowNodeRef>fc_s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_g0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="fc_lane_inv" name="Financial crimes investigations">
<bpmn:flowNodeRef>fc_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_ca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_e4</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="fc_lane_bsa" name="BSA/AML officer">
<bpmn:flowNodeRef>fc_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_e2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="fc_lane_ledger" name="Platform services (ledger, filing, records)">
<bpmn:flowNodeRef>fc_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t15</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_t14</bpmn:flowNodeRef>
<bpmn:flowNodeRef>fc_e3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="fc_s1" name="Unusual activity noticed in daily work">
<bpmn:outgoing>fc_flow0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="fc_t0" name="Refer it with the facts: money movement, deposits, trading, or RIA or entity concerns">
<bpmn:incoming>fc_flow0</bpmn:incoming>
<bpmn:outgoing>fc_flow1</bpmn:outgoing>
</bpmn:userTask>
<bpmn:startEvent id="fc_s2" name="Monitoring scenario hit: money movement, deposits, trading">
<bpmn:outgoing>fc_flow2</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="fc_s2_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></bpmn:conditionalEventDefinition>
</bpmn:startEvent>
<bpmn:exclusiveGateway id="fc_g0" name="">
<bpmn:incoming>fc_flow1</bpmn:incoming>
<bpmn:incoming>fc_flow2</bpmn:incoming>
<bpmn:outgoing>fc_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="fc_t1" name="Cluster related alerts across accounts and RIAs; assemble the case file (AI)">
<bpmn:incoming>fc_flow3</bpmn:incoming>
<bpmn:outgoing>fc_flow4</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="fc_t2" name="Investigate: activity, KYC file, history; ask the RIA for facts unless it may be involved">
<bpmn:incoming>fc_flow4</bpmn:incoming>
<bpmn:outgoing>fc_flow5</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="fc_g1" name="Suspicious?">
<bpmn:incoming>fc_flow5</bpmn:incoming>
<bpmn:outgoing>fc_flow6</bpmn:outgoing>
<bpmn:outgoing>fc_flow8</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="fc_t4" name="Close the alert with a short rationale">
<bpmn:incoming>fc_flow6</bpmn:incoming>
<bpmn:outgoing>fc_flow7</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="fc_e1" name="Closed, no filing">
<bpmn:incoming>fc_flow7</bpmn:incoming>
</bpmn:endEvent>
<bpmn:businessRuleTask id="fc_t5" name="Record when suspicion was established; clock: 30 days, up to 60 with no suspect">
<bpmn:incoming>fc_flow8</bpmn:incoming>
<bpmn:outgoing>fc_flow9</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="fc_t6" name="Draft the SAR narrative and pre-fill filing fields from case facts (AI)">
<bpmn:incoming>fc_flow9</bpmn:incoming>
<bpmn:outgoing>fc_flow10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="fc_t7" name="Review and finalize the narrative; recommend filing">
<bpmn:incoming>fc_flow10</bpmn:incoming>
<bpmn:incoming>fc_flow13</bpmn:incoming>
<bpmn:outgoing>fc_flow11</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="fc_t8" name="Review the recommendation and narrative">
<bpmn:incoming>fc_flow11</bpmn:incoming>
<bpmn:outgoing>fc_flow12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="fc_g2" name="Decision?">
<bpmn:incoming>fc_flow12</bpmn:incoming>
<bpmn:outgoing>fc_flow13</bpmn:outgoing>
<bpmn:outgoing>fc_flow14</bpmn:outgoing>
<bpmn:outgoing>fc_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="fc_t9" name="Record the decision not to file with a short rationale">
<bpmn:incoming>fc_flow14</bpmn:incoming>
<bpmn:outgoing>fc_flow15</bpmn:outgoing>
</bpmn:userTask>
<bpmn:endEvent id="fc_e2" name="Not filed">
<bpmn:incoming>fc_flow15</bpmn:incoming>
</bpmn:endEvent>
<bpmn:businessRuleTask id="fc_t10" name="Validate against FinCEN's SAR schema; confirm the deadline">
<bpmn:incoming>fc_flow16</bpmn:incoming>
<bpmn:outgoing>fc_flow17</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:sendTask id="fc_t11" name="Submit the SAR through BSA E-Filing">
<bpmn:incoming>fc_flow17</bpmn:incoming>
<bpmn:outgoing>fc_flow18</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="fc_ie" name="Acknowledgment with BSA ID">
<bpmn:incoming>fc_flow18</bpmn:incoming>
<bpmn:outgoing>fc_flow19</bpmn:outgoing>
<bpmn:messageEventDefinition id="fc_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="fc_t12" name="Store the SAR, acknowledgment, and supporting documents for 5 years (restricted)">
<bpmn:incoming>fc_flow19</bpmn:incoming>
<bpmn:outgoing>fc_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="fc_t13" name="Decide the relationship: continue, restrict, or exit">
<bpmn:incoming>fc_flow20</bpmn:incoming>
<bpmn:outgoing>fc_flow21</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="fc_g3" name="Action?">
<bpmn:incoming>fc_flow21</bpmn:incoming>
<bpmn:outgoing>fc_flow22</bpmn:outgoing>
<bpmn:outgoing>fc_flow24</bpmn:outgoing>
<bpmn:outgoing>fc_flow26</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="fc_ca" name="Exit through client offboarding" calledElement="co_process">
<bpmn:incoming>fc_flow22</bpmn:incoming>
<bpmn:outgoing>fc_flow23</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="fc_e4" name="Exit started">
<bpmn:incoming>fc_flow23</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="fc_t15" name="Apply AML restriction code (owner: AML compliance)">
<bpmn:incoming>fc_flow24</bpmn:incoming>
<bpmn:outgoing>fc_flow25</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="fc_t14" name="Keep under risk-based monitoring; file a continuing SAR if activity persists">
<bpmn:incoming>fc_flow25</bpmn:incoming>
<bpmn:incoming>fc_flow26</bpmn:incoming>
<bpmn:outgoing>fc_flow27</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="fc_e3" name="Case closed; monitoring continues">
<bpmn:incoming>fc_flow27</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="fc_flow0" name="" sourceRef="fc_s1" targetRef="fc_t0" />
<bpmn:sequenceFlow id="fc_flow1" name="" sourceRef="fc_t0" targetRef="fc_g0" />
<bpmn:sequenceFlow id="fc_flow2" name="" sourceRef="fc_s2" targetRef="fc_g0" />
<bpmn:sequenceFlow id="fc_flow3" name="" sourceRef="fc_g0" targetRef="fc_t1" />
<bpmn:sequenceFlow id="fc_flow4" name="" sourceRef="fc_t1" targetRef="fc_t2" />
<bpmn:sequenceFlow id="fc_flow5" name="" sourceRef="fc_t2" targetRef="fc_g1" />
<bpmn:sequenceFlow id="fc_flow6" name="No" sourceRef="fc_g1" targetRef="fc_t4" />
<bpmn:sequenceFlow id="fc_flow7" name="" sourceRef="fc_t4" targetRef="fc_e1" />
<bpmn:sequenceFlow id="fc_flow8" name="Yes" sourceRef="fc_g1" targetRef="fc_t5" />
<bpmn:sequenceFlow id="fc_flow9" name="" sourceRef="fc_t5" targetRef="fc_t6" />
<bpmn:sequenceFlow id="fc_flow10" name="" sourceRef="fc_t6" targetRef="fc_t7" />
<bpmn:sequenceFlow id="fc_flow11" name="" sourceRef="fc_t7" targetRef="fc_t8" />
<bpmn:sequenceFlow id="fc_flow12" name="" sourceRef="fc_t8" targetRef="fc_g2" />
<bpmn:sequenceFlow id="fc_flow13" name="Revise" sourceRef="fc_g2" targetRef="fc_t7" />
<bpmn:sequenceFlow id="fc_flow14" name="Decline" sourceRef="fc_g2" targetRef="fc_t9" />
<bpmn:sequenceFlow id="fc_flow15" name="" sourceRef="fc_t9" targetRef="fc_e2" />
<bpmn:sequenceFlow id="fc_flow16" name="File" sourceRef="fc_g2" targetRef="fc_t10" />
<bpmn:sequenceFlow id="fc_flow17" name="" sourceRef="fc_t10" targetRef="fc_t11" />
<bpmn:sequenceFlow id="fc_flow18" name="" sourceRef="fc_t11" targetRef="fc_ie" />
<bpmn:sequenceFlow id="fc_flow19" name="" sourceRef="fc_ie" targetRef="fc_t12" />
<bpmn:sequenceFlow id="fc_flow20" name="" sourceRef="fc_t12" targetRef="fc_t13" />
<bpmn:sequenceFlow id="fc_flow21" name="" sourceRef="fc_t13" targetRef="fc_g3" />
<bpmn:sequenceFlow id="fc_flow22" name="Exit" sourceRef="fc_g3" targetRef="fc_ca" />
<bpmn:sequenceFlow id="fc_flow23" name="" sourceRef="fc_ca" targetRef="fc_e4" />
<bpmn:sequenceFlow id="fc_flow24" name="Restrict" sourceRef="fc_g3" targetRef="fc_t15" />
<bpmn:sequenceFlow id="fc_flow25" name="" sourceRef="fc_t15" targetRef="fc_t14" />
<bpmn:sequenceFlow id="fc_flow26" name="Continue" sourceRef="fc_g3" targetRef="fc_t14" />
<bpmn:sequenceFlow id="fc_flow27" name="" sourceRef="fc_t14" targetRef="fc_e3" />
</bpmn:process>
