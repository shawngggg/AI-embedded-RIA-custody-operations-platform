<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="ra_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="ra_collab">
<bpmn:participant id="ra_main" name="Custody operations platform (synthetic reference implementation)" processRef="ra_process" />
<bpmn:participant id="ra_ria" name="RIA advisor (submits client-signed forms), the client, or beneficiaries" />
<bpmn:messageFlow id="ra_msg0" name="Contribution" sourceRef="ra_ria" targetRef="ra_as" />
<bpmn:messageFlow id="ra_msg1" name="Excess notice" sourceRef="ra_at2" targetRef="ra_ria" />
<bpmn:messageFlow id="ra_msg2" name="Signed distribution form" sourceRef="ra_ria" targetRef="ra_bs" />
<bpmn:messageFlow id="ra_msg3" name="Signed rollover or transfer form" sourceRef="ra_ria" targetRef="ra_cs" />
<bpmn:messageFlow id="ra_msg4" name="RMD statement" sourceRef="ra_dt2" targetRef="ra_ria" />
<bpmn:messageFlow id="ra_msg5" name="Claim forms" sourceRef="ra_ria" targetRef="ra_es" />
<bpmn:textAnnotation id="ra_ann0"><bpmn:text>2026 limits: $7,500, plus $1,100 at age 50 or older. Prior-year contributions are accepted until the April filing deadline.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ra_ann1"><bpmn:text>Requests come through the RIA on client-signed forms. Clients may also contact the custodian directly, and beneficiaries file death claims themselves because the RIA's authority ends at death.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ra_ann2"><bpmn:text>Trustee-to-trustee transfers aren't limited or reported. A 60-day IRA-to-IRA rollover is limited to one per 12 months, an RMD can't be rolled over, and late rollovers can use self-certification (Rev. Proc. 2020-46).</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ra_ann3"><bpmn:text>RMDs start at 73 (75 for people who turn 74 after 2032); Roth IRAs have no lifetime RMDs. A missed RMD carries a 25% excise tax, or 10% if corrected in time. Payments run through the distribution flow.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ra_ann4"><bpmn:text>Non-spouse beneficiaries follow the 10-year rule, with annual RMDs in years 1–9 if the owner had started them; eligible designated beneficiaries can stretch; estates follow the 5-year or the owner's life-expectancy rule. Shares split by December 31 of the year after death.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="ra_ann5"><bpmn:text>Beneficiary designations change only on the owner's signed form; spousal consent rules vary by state.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="ra_process" name="Retirement account servicing" isExecutable="false">
<bpmn:laneSet id="ra_laneset">
<bpmn:lane id="ra_lane_ops" name="Custody operations (retirement servicing)">
<bpmn:flowNodeRef>ra_at2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ae0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_bs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_bca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_cs</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_cca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ce1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_dt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_es</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_et2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ra_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>ra_bt1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_dt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_de</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_et1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ra_lane_rules" name="Retirement rules engine (IRS limits, codes, withholding)">
<bpmn:flowNodeRef>ra_at1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ag1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_bt2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ct1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_cg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ds</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_dt1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_eg1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_et5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ee</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="ra_lane_ledger" name="Ledger, tax reporting, and payments">
<bpmn:flowNodeRef>ra_as</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_at3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ae1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_bt3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_be</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ct2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ct3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_ce2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_et3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>ra_et4</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ra_as" name="Contribution received">
<bpmn:outgoing>ra_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="ra_as_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ra_at1" name="Check the tax year, the annual limit, and Roth eligibility flags">
<bpmn:incoming>ra_flow0</bpmn:incoming>
<bpmn:outgoing>ra_flow1</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ra_ag1" name="Excess?">
<bpmn:incoming>ra_flow1</bpmn:incoming>
<bpmn:outgoing>ra_flow2</bpmn:outgoing>
<bpmn:outgoing>ra_flow3</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="ra_at2" name="Tell the RIA; remove the excess plus earnings by the tax deadline">
<bpmn:incoming>ra_flow2</bpmn:incoming>
<bpmn:outgoing>ra_flow4</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="ra_ae0" name="Excess corrected">
<bpmn:incoming>ra_flow4</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="ra_at3" name="Post and code for Form 5498 (traditional or Roth)">
<bpmn:incoming>ra_flow3</bpmn:incoming>
<bpmn:outgoing>ra_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ra_ae1" name="Contribution posted">
<bpmn:incoming>ra_flow5</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ra_bs" name="Distribution request (RIA-submitted, client-signed)">
<bpmn:outgoing>ra_flow6</bpmn:outgoing>
<bpmn:messageEventDefinition id="ra_bs_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="ra_bt1" name="Extract the request and withholding elections (Form W-4R and state) (AI)">
<bpmn:incoming>ra_flow6</bpmn:incoming>
<bpmn:outgoing>ra_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="ra_bt2" name="Validate signatures, federal withholding (10% default), state withholding, 1099-R code">
<bpmn:incoming>ra_flow7</bpmn:incoming>
<bpmn:outgoing>ra_flow8</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:callActivity id="ra_bca" name="Pay out (transfers process)" calledElement="tr_process">
<bpmn:incoming>ra_flow8</bpmn:incoming>
<bpmn:outgoing>ra_flow9</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:serviceTask id="ra_bt3" name="Remit withheld taxes; record for Form 1099-R">
<bpmn:incoming>ra_flow9</bpmn:incoming>
<bpmn:outgoing>ra_flow10</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ra_be" name="Distribution paid">
<bpmn:incoming>ra_flow10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ra_cs" name="Rollover, transfer, or conversion request">
<bpmn:outgoing>ra_flow11</bpmn:outgoing>
<bpmn:messageEventDefinition id="ra_cs_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ra_ct1" name="Check eligibility: matching account types, not an RMD, one indirect rollover a year, 60 days">
<bpmn:incoming>ra_flow11</bpmn:incoming>
<bpmn:outgoing>ra_flow12</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="ra_cg1" name="Type?">
<bpmn:incoming>ra_flow12</bpmn:incoming>
<bpmn:outgoing>ra_flow13</bpmn:outgoing>
<bpmn:outgoing>ra_flow14</bpmn:outgoing>
<bpmn:outgoing>ra_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="ra_cca" name="Trustee-to-trustee transfer, ACATS or not (transfers process)" calledElement="tr_process">
<bpmn:incoming>ra_flow13</bpmn:incoming>
<bpmn:outgoing>ra_flow16</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:endEvent id="ra_ce1" name="Transfer complete">
<bpmn:incoming>ra_flow16</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="ra_ct2" name="Deposit the rollover; code it as a rollover contribution (Form 5498 box 2)">
<bpmn:incoming>ra_flow14</bpmn:incoming>
<bpmn:outgoing>ra_flow17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ra_ct3" name="Convert to Roth: code the distribution and the conversion (Form 5498 box 3)">
<bpmn:incoming>ra_flow15</bpmn:incoming>
<bpmn:outgoing>ra_flow18</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ra_ce2" name="Rollover or conversion recorded">
<bpmn:incoming>ra_flow17</bpmn:incoming>
<bpmn:incoming>ra_flow18</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ra_ds" name="RMD year begins (January)">
<bpmn:outgoing>ra_flow19</bpmn:outgoing>
<bpmn:timerEventDefinition id="ra_ds_def" />
</bpmn:startEvent>
<bpmn:businessRuleTask id="ra_dt1" name="Find traditional IRA owners at RMD age; calculate RMDs; flag Form 5498 box 11">
<bpmn:incoming>ra_flow19</bpmn:incoming>
<bpmn:outgoing>ra_flow20</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:sendTask id="ra_dt2" name="Send the RMD statement or calculation offer by January 31; copy the RIA">
<bpmn:incoming>ra_flow20</bpmn:incoming>
<bpmn:outgoing>ra_flow21</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="ra_dt3" name="Track RMDs not yet taken; alert the RIA in the fourth quarter (AI)">
<bpmn:incoming>ra_flow21</bpmn:incoming>
<bpmn:outgoing>ra_flow22</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="ra_de" name="RMDs tracked">
<bpmn:incoming>ra_flow22</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="ra_es" name="Beneficiary claim on an IRA (death already verified)">
<bpmn:outgoing>ra_flow23</bpmn:outgoing>
<bpmn:messageEventDefinition id="ra_es_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="ra_et1" name="Extract claim documents: death certificate, beneficiary applications, IDs (AI)">
<bpmn:incoming>ra_flow23</bpmn:incoming>
<bpmn:outgoing>ra_flow24</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:userTask id="ra_et2" name="Verify each beneficiary against the designation on file; split the shares">
<bpmn:incoming>ra_flow24</bpmn:incoming>
<bpmn:outgoing>ra_flow25</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="ra_eg1" name="Beneficiary?">
<bpmn:incoming>ra_flow25</bpmn:incoming>
<bpmn:outgoing>ra_flow26</bpmn:outgoing>
<bpmn:outgoing>ra_flow27</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="ra_et3" name="Spouse: treat as own, roll over, or open an inherited IRA">
<bpmn:incoming>ra_flow26</bpmn:incoming>
<bpmn:outgoing>ra_flow28</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="ra_et4" name="Open an inherited IRA (decedent FBO beneficiary); set the payout rule">
<bpmn:incoming>ra_flow27</bpmn:incoming>
<bpmn:outgoing>ra_flow29</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="ra_et5" name="Flag any year-of-death RMD still due to the beneficiary">
<bpmn:incoming>ra_flow28</bpmn:incoming>
<bpmn:incoming>ra_flow29</bpmn:incoming>
<bpmn:outgoing>ra_flow30</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:endEvent id="ra_ee" name="Inherited assets in place">
<bpmn:incoming>ra_flow30</bpmn:incoming>
</bpmn:endEvent>
