<bpmndi:BPMNShape id="sx_tm_di" bpmnElement="sx_tm"><dc:Bounds x="962" y="152" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="836" y="156" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="sx_tf_di" bpmnElement="sx_tf" bioc:stroke="#8A5A00" bioc:fill="#FFF4DE" color:background-color="#FFF4DE" color:border-color="#8A5A00"><dc:Bounds x="1300" y="125" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="sx_g1_di" bpmnElement="sx_g1" isMarkerVisible="true"><dc:Bounds x="1355" y="460" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1243" y="438" width="130" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="sx_t4_di" bpmnElement="sx_t4" bioc:stroke="#0F6E56" bioc:fill="#E1F5EE" color:background-color="#E1F5EE" color:border-color="#0F6E56"><dc:Bounds x="1500" y="590" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="sx_t5_di" bpmnElement="sx_t5" bioc:stroke="#0F6E56" bioc:fill="#E1F5EE" color:background-color="#E1F5EE" color:border-color="#0F6E56"><dc:Bounds x="1500" y="700" width="160" height="90" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="sx_e1_di" bpmnElement="sx_e1"><dc:Bounds x="1762" y="617" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1720" y="659" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
