<bpmndi:BPMNEdge id="sx_flow7_di" bpmnElement="sx_flow7"><di:waypoint x="1380" y="125" /><di:waypoint x="1380" y="12" /><di:waypoint x="980" y="12" /><di:waypoint x="980" y="40" /><bpmndi:BPMNLabel><dc:Bounds x="986" y="18" width="90" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
