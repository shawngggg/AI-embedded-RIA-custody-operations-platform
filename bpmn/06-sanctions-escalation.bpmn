<bpmndi:BPMNShape id="sx_ann0_di" bpmnElement="sx_ann0"><dc:Bounds x="1345" y="283" width="270" height="84" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="sx_flow0_di" bpmnElement="sx_flow0"><di:waypoint x="198" y="65" /><di:waypoint x="280" y="65" /><di:waypoint x="280" y="635" /><di:waypoint x="300" y="635" /></bpmndi:BPMNEdge>
