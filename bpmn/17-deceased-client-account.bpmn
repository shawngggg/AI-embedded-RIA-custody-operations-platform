<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="dc_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="dc_collab">
<bpmn:participant id="dc_main" name="Custody operations platform (synthetic reference implementation)" processRef="dc_process" />
<bpmn:participant id="dc_ext" name="RIA advisor, and the client's family or estate representative" />
<bpmn:messageFlow id="dc_msg0" name="Death notification" sourceRef="dc_ext" targetRef="dc_s" />
<bpmn:messageFlow id="dc_msg1" name="Confirmation request" sourceRef="dc_t2" targetRef="dc_ext" />
<bpmn:messageFlow id="dc_msg2" name="RIA confirmation, death certificate" sourceRef="dc_ext" targetRef="dc_ie1" />
<bpmn:messageFlow id="dc_msg3" name="Estate process notice" sourceRef="dc_t7" targetRef="dc_ext" />
<bpmn:messageFlow id="dc_msg4" name="Court or small-estate documents" sourceRef="dc_ext" targetRef="dc_ie2" />
<bpmn:textAnnotation id="dc_ann0"><bpmn:text>The custodian acts only on the RIA's confirmation, because its agreement is with the RIA.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="dc_ann1"><bpmn:text>Clear ownership: a TOD or IRA beneficiary designation, or a surviving joint owner.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="dc_ann2"><bpmn:text>If no one establishes ownership, the account eventually enters escheatment.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="dc_process" name="Deceased client account" isExecutable="false">
<bpmn:laneSet id="dc_laneset">
<bpmn:lane id="dc_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>dc_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_ie1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="dc_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>dc_t5</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="dc_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>dc_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_gm</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_g3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="dc_lane_comp" name="Compliance and legal">
<bpmn:flowNodeRef>dc_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_ie2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t8</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="dc_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>dc_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_ca</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_gm2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>dc_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="dc_s" name="Death notification received (RIA or family)">
<bpmn:outgoing>dc_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="dc_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="dc_t1" name="Protective hold: nothing moves pending RIA confirmation">
<bpmn:incoming>dc_flow0</bpmn:incoming>
<bpmn:outgoing>dc_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="dc_t2" name="Confirm with the RIA; request the death certificate">
<bpmn:incoming>dc_flow1</bpmn:incoming>
<bpmn:outgoing>dc_flow2</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="dc_ie1" name="RIA confirmation and death certificate received">
<bpmn:incoming>dc_flow2</bpmn:incoming>
<bpmn:outgoing>dc_flow3</bpmn:outgoing>
<bpmn:messageEventDefinition id="dc_ie1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="dc_g1" name="Death confirmed by RIA?">
<bpmn:incoming>dc_flow3</bpmn:incoming>
<bpmn:outgoing>dc_flow4</bpmn:outgoing>
<bpmn:outgoing>dc_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="dc_t3" name="Remove protective hold">
<bpmn:incoming>dc_flow4</bpmn:incoming>
<bpmn:outgoing>dc_flow5</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="dc_e1" name="Notification not confirmed">
<bpmn:incoming>dc_flow5</bpmn:incoming>
</bpmn:endEvent>
<bpmn:serviceTask id="dc_t4" name="Full lockdown: deceased restriction code; RIA authority under the LPOA ends">
<bpmn:incoming>dc_flow6</bpmn:incoming>
<bpmn:outgoing>dc_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="dc_t5" name="Extract death certificate and ownership documents; identify beneficiaries, TOD, joint survivors (AI)">
<bpmn:incoming>dc_flow7</bpmn:incoming>
<bpmn:outgoing>dc_flow8</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="dc_g2" name="Clear ownership?">
<bpmn:incoming>dc_flow8</bpmn:incoming>
<bpmn:outgoing>dc_flow9</bpmn:outgoing>
<bpmn:outgoing>dc_flow10</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="dc_t6" name="Verify claim documents for beneficiary or surviving owner">
<bpmn:incoming>dc_flow9</bpmn:incoming>
<bpmn:outgoing>dc_flow14</bpmn:outgoing>
</bpmn:userTask>
<bpmn:sendTask id="dc_t7" name="Notify RIA and family: estate process required under state law">
<bpmn:incoming>dc_flow10</bpmn:incoming>
<bpmn:outgoing>dc_flow11</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="dc_ie2" name="Letters testamentary or administration, or small-estate documents received">
<bpmn:incoming>dc_flow11</bpmn:incoming>
<bpmn:outgoing>dc_flow12</bpmn:outgoing>
<bpmn:messageEventDefinition id="dc_ie2_def" />
</bpmn:intermediateCatchEvent>
<bpmn:userTask id="dc_t8" name="Verify legal documents; identify the executor or administrator">
<bpmn:incoming>dc_flow12</bpmn:incoming>
<bpmn:outgoing>dc_flow13</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="dc_gm" name="">
<bpmn:incoming>dc_flow13</bpmn:incoming>
<bpmn:incoming>dc_flow14</bpmn:incoming>
<bpmn:outgoing>dc_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="dc_t9" name="Apply date-of-death valuation to cost basis">
<bpmn:incoming>dc_flow15</bpmn:incoming>
<bpmn:outgoing>dc_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="dc_t10" name="Re-register to beneficiary, survivor, or estate; lift lockdown">
<bpmn:incoming>dc_flow16</bpmn:incoming>
<bpmn:outgoing>dc_flow17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="dc_g3" name="Distribution?">
<bpmn:incoming>dc_flow17</bpmn:incoming>
<bpmn:outgoing>dc_flow18</bpmn:outgoing>
<bpmn:outgoing>dc_flow19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="dc_t11" name="Journal assets to the new owner's account under the RIA">
<bpmn:incoming>dc_flow18</bpmn:incoming>
<bpmn:outgoing>dc_flow20</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:callActivity id="dc_ca" name="Transferability review and transfer out (shared subprocesses)" calledElement="xr_process">
<bpmn:incoming>dc_flow19</bpmn:incoming>
<bpmn:outgoing>dc_flow21</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="dc_gm2" name="">
<bpmn:incoming>dc_flow20</bpmn:incoming>
<bpmn:incoming>dc_flow21</bpmn:incoming>
<bpmn:outgoing>dc_flow22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="dc_t12" name="Close the deceased account; retain records; final tax reporting">
<bpmn:incoming>dc_flow22</bpmn:incoming>
<bpmn:outgoing>dc_flow23</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="dc_e" name="Estate settled">
<bpmn:incoming>dc_flow23</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="dc_flow0" name="" sourceRef="dc_s" targetRef="dc_t1" />
<bpmn:sequenceFlow id="dc_flow1" name="" sourceRef="dc_t1" targetRef="dc_t2" />
<bpmn:sequenceFlow id="dc_flow2" name="" sourceRef="dc_t2" targetRef="dc_ie1" />
<bpmn:sequenceFlow id="dc_flow3" name="" sourceRef="dc_ie1" targetRef="dc_g1" />
<bpmn:sequenceFlow id="dc_flow4" name="No" sourceRef="dc_g1" targetRef="dc_t3" />
<bpmn:sequenceFlow id="dc_flow5" name="" sourceRef="dc_t3" targetRef="dc_e1" />
<bpmn:sequenceFlow id="dc_flow6" name="Yes" sourceRef="dc_g1" targetRef="dc_t4" />
<bpmn:sequenceFlow id="dc_flow7" name="" sourceRef="dc_t4" targetRef="dc_t5" />
<bpmn:sequenceFlow id="dc_flow8" name="" sourceRef="dc_t5" targetRef="dc_g2" />
<bpmn:sequenceFlow id="dc_flow9" name="Yes" sourceRef="dc_g2" targetRef="dc_t6" />
<bpmn:sequenceFlow id="dc_flow10" name="No" sourceRef="dc_g2" targetRef="dc_t7" />
<bpmn:sequenceFlow id="dc_flow11" name="" sourceRef="dc_t7" targetRef="dc_ie2" />
<bpmn:sequenceFlow id="dc_flow12" name="" sourceRef="dc_ie2" targetRef="dc_t8" />
<bpmn:sequenceFlow id="dc_flow13" name="" sourceRef="dc_t8" targetRef="dc_gm" />
<bpmn:sequenceFlow id="dc_flow14" name="" sourceRef="dc_t6" targetRef="dc_gm" />
<bpmn:sequenceFlow id="dc_flow15" name="" sourceRef="dc_gm" targetRef="dc_t9" />
<bpmn:sequenceFlow id="dc_flow16" name="" sourceRef="dc_t9" targetRef="dc_t10" />
<bpmn:sequenceFlow id="dc_flow17" name="" sourceRef="dc_t10" targetRef="dc_g3" />
<bpmn:sequenceFlow id="dc_flow18" name="New account" sourceRef="dc_g3" targetRef="dc_t11" />
<bpmn:sequenceFlow id="dc_flow19" name="Transfer out" sourceRef="dc_g3" targetRef="dc_ca" />
<bpmn:sequenceFlow id="dc_flow20" name="" sourceRef="dc_t11" targetRef="dc_gm2" />
<bpmn:sequenceFlow id="dc_flow21" name="" sourceRef="dc_ca" targetRef="dc_gm2" />
<bpmn:sequenceFlow id="dc_flow22" name="" sourceRef="dc_gm2" targetRef="dc_t12" />
<bpmn:sequenceFlow id="dc_flow23" name="" sourceRef="dc_t12" targetRef="dc_e" />
</bpmn:process>
