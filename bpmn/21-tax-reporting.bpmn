<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="tx_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="tx_collab">
<bpmn:participant id="tx_main" name="Custody operations platform (synthetic reference implementation)" processRef="tx_process" />
<bpmn:participant id="tx_ria" name="RIA advisor and client" />
<bpmn:participant id="tx_gov" name="IRS (IRIS e-filing, CP2100 B-notice lists) and state revenue departments" />
<bpmn:messageFlow id="tx_msg0" name="Tax forms" sourceRef="tx_t6" targetRef="tx_ria" />
<bpmn:messageFlow id="tx_msg1" name="Question" sourceRef="tx_ria" targetRef="tx_s2" />
<bpmn:messageFlow id="tx_msg2" name="Answer" sourceRef="tx_t8" targetRef="tx_ria" />
<bpmn:messageFlow id="tx_msg3" name="Corrected form" sourceRef="tx_t12" targetRef="tx_ria" />
<bpmn:messageFlow id="tx_msg4" name="Information returns and state filings" sourceRef="tx_t7" targetRef="tx_gov" />
<bpmn:messageFlow id="tx_msg5" name="Acknowledgment" sourceRef="tx_gov" targetRef="tx_ie1" />
<bpmn:messageFlow id="tx_msg6" name="Corrections" sourceRef="tx_t12" targetRef="tx_gov" />
<bpmn:messageFlow id="tx_msg7" name="CP2100 list" sourceRef="tx_gov" targetRef="tx_s4" />
<bpmn:textAnnotation id="tx_ann0"><bpmn:text>Deadlines: 1099-R and 5498 values to clients by Jan 31; composite 1099 by Feb 15; 1042-S by Mar 15. E-file with the IRS by Mar 31 (1042-S Mar 15; 5498 May 31). IRIS is the only IRS e-file channel from 2027.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="tx_ann1"><bpmn:text>Corrected forms follow fund and REIT reclassifications and late basis data. Cost-basis transfer statements go out within 15 days of an outgoing transfer settling.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="tx_ann2"><bpmn:text>State withholding on retirement distributions follows the client's state of residence; annual reconciliations go directly to the states; the Combined Federal/State Filing program forwards some forms.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="tx_process" name="Tax reporting" isExecutable="false">
<bpmn:laneSet id="tx_laneset">
<bpmn:lane id="tx_lane_cust" name="Custody operations (tax data, corrections, and inquiries)">
<bpmn:flowNodeRef>tx_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_e2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tx_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>tx_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t9</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tx_lane_rules" name="Tax rules engine">
<bpmn:flowNodeRef>tx_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_s3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="tx_lane_ledger" name="Platform services (ledger, tax lots, forms, filing)">
<bpmn:flowNodeRef>tx_s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_ie1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_e1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_e3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_s4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_t14</bpmn:flowNodeRef>
<bpmn:flowNodeRef>tx_e4</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="tx_s1" name="Tax year closes">
<bpmn:outgoing>tx_flow0</bpmn:outgoing>
<bpmn:timerEventDefinition id="tx_s1_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="tx_t1" name="Compile reportable activity: proceeds, basis, income, distributions, withholding">
<bpmn:incoming>tx_flow0</bpmn:incoming>
<bpmn:outgoing>tx_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="tx_t2" name="Flag likely problems: missing basis, TIN gaps, withholding mismatches, pending reclassifications (AI)">
<bpmn:incoming>tx_flow1</bpmn:incoming>
<bpmn:outgoing>tx_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="tx_t3" name="Validate: TIN status, covered vs. noncovered basis, withholding, thresholds">
<bpmn:incoming>tx_flow2</bpmn:incoming>
<bpmn:incoming>tx_flow5</bpmn:incoming>
<bpmn:outgoing>tx_flow3</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="tx_g1" name="Exceptions?">
<bpmn:incoming>tx_flow3</bpmn:incoming>
<bpmn:outgoing>tx_flow4</bpmn:outgoing>
<bpmn:outgoing>tx_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="tx_t4" name="Fix the data: cost basis, TINs, withholding, corporate-action adjustments">
<bpmn:incoming>tx_flow4</bpmn:incoming>
<bpmn:outgoing>tx_flow5</bpmn:outgoing>
</bpmn:userTask>
<bpmn:serviceTask id="tx_t5" name="Produce forms: composite 1099, 1099-R, 5498, 1042-S">
<bpmn:incoming>tx_flow6</bpmn:incoming>
<bpmn:outgoing>tx_flow7</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="tx_t6" name="Deliver forms to clients, with copies to the RIA">
<bpmn:incoming>tx_flow7</bpmn:incoming>
<bpmn:outgoing>tx_flow8</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:sendTask id="tx_t7" name="File with the IRS through IRIS, and with states that need direct filing">
<bpmn:incoming>tx_flow8</bpmn:incoming>
<bpmn:outgoing>tx_flow9</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="tx_ie1" name="IRIS acknowledgment">
<bpmn:incoming>tx_flow9</bpmn:incoming>
<bpmn:outgoing>tx_flow10</bpmn:outgoing>
<bpmn:messageEventDefinition id="tx_ie1_def" />
</bpmn:intermediateCatchEvent>
<bpmn:endEvent id="tx_e1" name="Original filing complete">
<bpmn:incoming>tx_flow10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="tx_s2" name="Question about a form">
<bpmn:outgoing>tx_flow11</bpmn:outgoing>
<bpmn:messageEventDefinition id="tx_s2_def" />
</bpmn:startEvent>
<bpmn:userTask id="tx_t8" name="Research and answer the RIA or client">
<bpmn:incoming>tx_flow11</bpmn:incoming>
<bpmn:outgoing>tx_flow12</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="tx_g3" name="Correction needed?">
<bpmn:incoming>tx_flow12</bpmn:incoming>
<bpmn:outgoing>tx_flow13</bpmn:outgoing>
<bpmn:outgoing>tx_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="tx_e2" name="Answered">
<bpmn:incoming>tx_flow13</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="tx_t10" name="Prepare the corrected form">
<bpmn:incoming>tx_flow14</bpmn:incoming>
<bpmn:incoming>tx_flow16</bpmn:incoming>
<bpmn:outgoing>tx_flow17</bpmn:outgoing>
</bpmn:userTask>
<bpmn:startEvent id="tx_s3" name="Fund or REIT reclassification, or late basis data">
<bpmn:outgoing>tx_flow15</bpmn:outgoing>
<bpmn:conditionalEventDefinition id="tx_s3_def"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" /></bpmn:conditionalEventDefinition>
</bpmn:startEvent>
<bpmn:serviceTask id="tx_t9" name="Find affected accounts and forms; draft corrections (AI)">
<bpmn:incoming>tx_flow15</bpmn:incoming>
<bpmn:outgoing>tx_flow16</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="tx_t11" name="Validate the correction: one step for amounts; two steps for a wrong TIN, name, or form">
<bpmn:incoming>tx_flow17</bpmn:incoming>
<bpmn:outgoing>tx_flow18</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:sendTask id="tx_t12" name="Issue the corrected form to the client and RIA; file the correction">
<bpmn:incoming>tx_flow18</bpmn:incoming>
<bpmn:outgoing>tx_flow19</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:endEvent id="tx_e3" name="Correction filed">
<bpmn:incoming>tx_flow19</bpmn:incoming>
</bpmn:endEvent>
<bpmn:startEvent id="tx_s4" name="CP2100 list of TIN mismatches">
<bpmn:outgoing>tx_flow20</bpmn:outgoing>
<bpmn:messageEventDefinition id="tx_s4_def" />
</bpmn:startEvent>
<bpmn:sendTask id="tx_t13" name="Send B-notices within 15 business days">
<bpmn:incoming>tx_flow20</bpmn:incoming>
<bpmn:outgoing>tx_flow21</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="tx_t14" name="Withhold 24% if no certified TIN within 30 business days; stop once certified">
<bpmn:incoming>tx_flow21</bpmn:incoming>
<bpmn:outgoing>tx_flow22</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="tx_e4" name="Withholding updated">
<bpmn:incoming>tx_flow22</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sequenceFlow id="tx_flow0" name="" sourceRef="tx_s1" targetRef="tx_t1" />
<bpmn:sequenceFlow id="tx_flow1" name="" sourceRef="tx_t1" targetRef="tx_t2" />
<bpmn:sequenceFlow id="tx_flow2" name="" sourceRef="tx_t2" targetRef="tx_t3" />
<bpmn:sequenceFlow id="tx_flow3" name="" sourceRef="tx_t3" targetRef="tx_g1" />
<bpmn:sequenceFlow id="tx_flow4" name="Yes" sourceRef="tx_g1" targetRef="tx_t4" />
<bpmn:sequenceFlow id="tx_flow5" name="" sourceRef="tx_t4" targetRef="tx_t3" />
<bpmn:sequenceFlow id="tx_flow6" name="No" sourceRef="tx_g1" targetRef="tx_t5" />
<bpmn:sequenceFlow id="tx_flow7" name="" sourceRef="tx_t5" targetRef="tx_t6" />
<bpmn:sequenceFlow id="tx_flow8" name="" sourceRef="tx_t6" targetRef="tx_t7" />
<bpmn:sequenceFlow id="tx_flow9" name="" sourceRef="tx_t7" targetRef="tx_ie1" />
<bpmn:sequenceFlow id="tx_flow10" name="" sourceRef="tx_ie1" targetRef="tx_e1" />
<bpmn:sequenceFlow id="tx_flow11" name="" sourceRef="tx_s2" targetRef="tx_t8" />
<bpmn:sequenceFlow id="tx_flow12" name="" sourceRef="tx_t8" targetRef="tx_g3" />
<bpmn:sequenceFlow id="tx_flow13" name="No" sourceRef="tx_g3" targetRef="tx_e2" />
<bpmn:sequenceFlow id="tx_flow14" name="Yes" sourceRef="tx_g3" targetRef="tx_t10" />
<bpmn:sequenceFlow id="tx_flow15" name="" sourceRef="tx_s3" targetRef="tx_t9" />
<bpmn:sequenceFlow id="tx_flow16" name="" sourceRef="tx_t9" targetRef="tx_t10" />
<bpmn:sequenceFlow id="tx_flow17" name="" sourceRef="tx_t10" targetRef="tx_t11" />
<bpmn:sequenceFlow id="tx_flow18" name="" sourceRef="tx_t11" targetRef="tx_t12" />
<bpmn:sequenceFlow id="tx_flow19" name="" sourceRef="tx_t12" targetRef="tx_e3" />
<bpmn:sequenceFlow id="tx_flow20" name="" sourceRef="tx_s4" targetRef="tx_t13" />
<bpmn:sequenceFlow id="tx_flow21" name="" sourceRef="tx_t13" targetRef="tx_t14" />
<bpmn:sequenceFlow id="tx_flow22" name="" sourceRef="tx_t14" targetRef="tx_e4" />
</bpmn:process>
