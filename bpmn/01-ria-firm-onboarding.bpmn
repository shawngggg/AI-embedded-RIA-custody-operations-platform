<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="rf_defs" targetNamespace="https://github.com/shawngggg/ria-custody-platform">
<bpmn:collaboration id="rf_collab">
<bpmn:participant id="rf_main" name="Custody operations platform (synthetic reference implementation)" processRef="rf_process" />
<bpmn:participant id="rf_ria" name="RIA firm (applicant)" />
<bpmn:participant id="rf_data" name="Public registration data (SEC IAPD, FINRA BrokerCheck) and identity verification services" />
<bpmn:messageFlow id="rf_msg0" name="Application package" sourceRef="rf_ria" targetRef="rf_s" />
<bpmn:messageFlow id="rf_msg1" name="Missing-items request" sourceRef="rf_t3" targetRef="rf_ria" />
<bpmn:messageFlow id="rf_msg2" name="Missing items" sourceRef="rf_ria" targetRef="rf_ie" />
<bpmn:messageFlow id="rf_msg3" name="Decline notice" sourceRef="rf_ed1" targetRef="rf_ria" />
<bpmn:messageFlow id="rf_msg4" name="Decline notice" sourceRef="rf_ed2" targetRef="rf_ria" />
<bpmn:messageFlow id="rf_msg5" name="Activation and master account details" sourceRef="rf_e" targetRef="rf_ria" />
<bpmn:messageFlow id="rf_msg6" name="Registration lookup" sourceRef="rf_t4" targetRef="rf_data" />
<bpmn:messageFlow id="rf_msg7" name="Identity verification" sourceRef="rf_t5" targetRef="rf_data" />
<bpmn:textAnnotation id="rf_ann0"><bpmn:text>Firm-level checks always run, whatever path the RIA's client accounts later take.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="rf_ann1"><bpmn:text>The reliance result decides whether discretionary client accounts can use path A.</bpmn:text></bpmn:textAnnotation>
</bpmn:collaboration>
<bpmn:process id="rf_process" name="RIA firm onboarding and due diligence" isExecutable="false">
<bpmn:laneSet id="rf_laneset">
<bpmn:lane id="rf_lane_ops" name="Custody operations (first line)">
<bpmn:flowNodeRef>rf_s</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_ie</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_ca1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_ed1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rf_lane_ai" name="AI assist services">
<bpmn:flowNodeRef>rf_t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t6</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rf_lane_rules" name="Rules and controls engine">
<bpmn:flowNodeRef>rf_g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t10</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rf_lane_comp" name="AML compliance (second line)">
<bpmn:flowNodeRef>rf_t9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_g6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_ed2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="rf_lane_ledger" name="Ledger and account services">
<bpmn:flowNodeRef>rf_t11</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_t12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rf_e</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="rf_s" name="RIA application received">
<bpmn:outgoing>rf_flow0</bpmn:outgoing>
<bpmn:messageEventDefinition id="rf_s_def" />
</bpmn:startEvent>
<bpmn:serviceTask id="rf_t1" name="Extract firm documents: custodial agreement, Form ADV, formation docs, ownership chart (AI)">
<bpmn:incoming>rf_flow0</bpmn:incoming>
<bpmn:incoming>rf_flow5</bpmn:incoming>
<bpmn:outgoing>rf_flow1</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="rf_t2" name="Check completeness; categorize NIGO (AI)">
<bpmn:incoming>rf_flow1</bpmn:incoming>
<bpmn:outgoing>rf_flow2</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="rf_g1" name="Package complete?">
<bpmn:incoming>rf_flow2</bpmn:incoming>
<bpmn:outgoing>rf_flow3</bpmn:outgoing>
<bpmn:outgoing>rf_flow6</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:sendTask id="rf_t3" name="Request missing items from the RIA">
<bpmn:incoming>rf_flow3</bpmn:incoming>
<bpmn:outgoing>rf_flow4</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:intermediateCatchEvent id="rf_ie" name="Items received">
<bpmn:incoming>rf_flow4</bpmn:incoming>
<bpmn:outgoing>rf_flow5</bpmn:outgoing>
<bpmn:messageEventDefinition id="rf_ie_def" />
</bpmn:intermediateCatchEvent>
<bpmn:businessRuleTask id="rf_t4" name="Verify registration and licensing: SEC or state, adviser licenses, disciplinary history">
<bpmn:incoming>rf_flow6</bpmn:incoming>
<bpmn:outgoing>rf_flow7</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:businessRuleTask id="rf_t5" name="KYB and CIP on the firm; verify identity of owners and control persons">
<bpmn:incoming>rf_flow7</bpmn:incoming>
<bpmn:outgoing>rf_flow8</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="rf_t6" name="PEP and adverse media screening of owners and principals; summarize hits (AI)">
<bpmn:incoming>rf_flow8</bpmn:incoming>
<bpmn:outgoing>rf_flow9</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:businessRuleTask id="rf_t7" name="First-line check of firm and principals against the sanctions flagged list">
<bpmn:incoming>rf_flow9</bpmn:incoming>
<bpmn:outgoing>rf_flow10</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="rf_g2" name="Flagged?">
<bpmn:incoming>rf_flow10</bpmn:incoming>
<bpmn:outgoing>rf_flow11</bpmn:outgoing>
<bpmn:outgoing>rf_flow15</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:callActivity id="rf_ca1" name="Sanctions escalation (shared subprocess)" calledElement="sx_process">
<bpmn:incoming>rf_flow11</bpmn:incoming>
<bpmn:outgoing>rf_flow12</bpmn:outgoing>
</bpmn:callActivity>
<bpmn:exclusiveGateway id="rf_g3" name="Cleared by sanctions team?">
<bpmn:incoming>rf_flow12</bpmn:incoming>
<bpmn:outgoing>rf_flow13</bpmn:outgoing>
<bpmn:outgoing>rf_flow14</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="rf_ed1" name="Relationship declined">
<bpmn:incoming>rf_flow13</bpmn:incoming>
<bpmn:messageEventDefinition id="rf_ed1_def" />
</bpmn:endEvent>
<bpmn:exclusiveGateway id="rf_g4" name="">
<bpmn:incoming>rf_flow14</bpmn:incoming>
<bpmn:incoming>rf_flow15</bpmn:incoming>
<bpmn:outgoing>rf_flow16</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="rf_t8" name="Risk-rate the RIA: ownership, jurisdictions, client base, PEP, media, disciplinary history">
<bpmn:incoming>rf_flow16</bpmn:incoming>
<bpmn:outgoing>rf_flow17</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="rf_g5" name="Risk level?">
<bpmn:incoming>rf_flow17</bpmn:incoming>
<bpmn:outgoing>rf_flow18</bpmn:outgoing>
<bpmn:outgoing>rf_flow22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:userTask id="rf_t9" name="EDD: owners' source of wealth, source of firm funds, enhanced review">
<bpmn:incoming>rf_flow18</bpmn:incoming>
<bpmn:outgoing>rf_flow19</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="rf_g6" name="EDD approved?">
<bpmn:incoming>rf_flow19</bpmn:incoming>
<bpmn:outgoing>rf_flow20</bpmn:outgoing>
<bpmn:outgoing>rf_flow21</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="rf_ed2" name="Relationship declined">
<bpmn:incoming>rf_flow20</bpmn:incoming>
<bpmn:messageEventDefinition id="rf_ed2_def" />
</bpmn:endEvent>
<bpmn:exclusiveGateway id="rf_g7" name="">
<bpmn:incoming>rf_flow21</bpmn:incoming>
<bpmn:incoming>rf_flow22</bpmn:incoming>
<bpmn:outgoing>rf_flow23</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="rf_t10" name="Determine reliance eligibility: SEC registration, reliance contract, annual AML certification">
<bpmn:incoming>rf_flow23</bpmn:incoming>
<bpmn:outgoing>rf_flow24</bpmn:outgoing>
</bpmn:businessRuleTask>
<bpmn:serviceTask id="rf_t11" name="Open master and house accounts; set users, entitlements, fee-deduction authority">
<bpmn:incoming>rf_flow24</bpmn:incoming>
<bpmn:outgoing>rf_flow25</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:serviceTask id="rf_t12" name="Schedule rolling review and annual certification timer">
<bpmn:incoming>rf_flow25</bpmn:incoming>
<bpmn:outgoing>rf_flow26</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:endEvent id="rf_e" name="RIA firm active">
<bpmn:incoming>rf_flow26</bpmn:incoming>
<bpmn:messageEventDefinition id="rf_e_def" />
</bpmn:endEvent>
<bpmn:sequenceFlow id="rf_flow0" name="" sourceRef="rf_s" targetRef="rf_t1" />
<bpmn:sequenceFlow id="rf_flow1" name="" sourceRef="rf_t1" targetRef="rf_t2" />
<bpmn:sequenceFlow id="rf_flow2" name="" sourceRef="rf_t2" targetRef="rf_g1" />
<bpmn:sequenceFlow id="rf_flow3" name="No" sourceRef="rf_g1" targetRef="rf_t3" />
<bpmn:sequenceFlow id="rf_flow4" name="" sourceRef="rf_t3" targetRef="rf_ie" />
<bpmn:sequenceFlow id="rf_flow5" name="Re-extract" sourceRef="rf_ie" targetRef="rf_t1" />
<bpmn:sequenceFlow id="rf_flow6" name="Yes" sourceRef="rf_g1" targetRef="rf_t4" />
<bpmn:sequenceFlow id="rf_flow7" name="" sourceRef="rf_t4" targetRef="rf_t5" />
<bpmn:sequenceFlow id="rf_flow8" name="" sourceRef="rf_t5" targetRef="rf_t6" />
<bpmn:sequenceFlow id="rf_flow9" name="" sourceRef="rf_t6" targetRef="rf_t7" />
<bpmn:sequenceFlow id="rf_flow10" name="" sourceRef="rf_t7" targetRef="rf_g2" />
<bpmn:sequenceFlow id="rf_flow11" name="Yes" sourceRef="rf_g2" targetRef="rf_ca1" />
<bpmn:sequenceFlow id="rf_flow12" name="" sourceRef="rf_ca1" targetRef="rf_g3" />
<bpmn:sequenceFlow id="rf_flow13" name="No" sourceRef="rf_g3" targetRef="rf_ed1" />
<bpmn:sequenceFlow id="rf_flow14" name="Yes" sourceRef="rf_g3" targetRef="rf_g4" />
<bpmn:sequenceFlow id="rf_flow15" name="No" sourceRef="rf_g2" targetRef="rf_g4" />
<bpmn:sequenceFlow id="rf_flow16" name="" sourceRef="rf_g4" targetRef="rf_t8" />
<bpmn:sequenceFlow id="rf_flow17" name="" sourceRef="rf_t8" targetRef="rf_g5" />
<bpmn:sequenceFlow id="rf_flow18" name="High" sourceRef="rf_g5" targetRef="rf_t9" />
<bpmn:sequenceFlow id="rf_flow19" name="" sourceRef="rf_t9" targetRef="rf_g6" />
<bpmn:sequenceFlow id="rf_flow20" name="No" sourceRef="rf_g6" targetRef="rf_ed2" />
<bpmn:sequenceFlow id="rf_flow21" name="Yes" sourceRef="rf_g6" targetRef="rf_g7" />
<bpmn:sequenceFlow id="rf_flow22" name="Standard" sourceRef="rf_g5" targetRef="rf_g7" />
<bpmn:sequenceFlow id="rf_flow23" name="" sourceRef="rf_g7" targetRef="rf_t10" />
<bpmn:sequenceFlow id="rf_flow24" name="" sourceRef="rf_t10" targetRef="rf_t11" />
<bpmn:sequenceFlow id="rf_flow25" name="" sourceRef="rf_t11" targetRef="rf_t12" />
<bpmn:sequenceFlow id="rf_flow26" name="" sourceRef="rf_t12" targetRef="rf_e" />
</bpmn:process>
